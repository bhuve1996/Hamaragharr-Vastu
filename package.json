{
  "name": "hamaragharr-vastu-theme",
  "version": "1.0.0",
  "description": "Hamaragharr Vastu Shopify Theme",
  "scripts": {
    "build:css": "sass scss/main.scss:assets/main.css --style=expanded",
    "watch:css": "sass --watch scss/main.scss:assets/main.css --style=expanded",
    "build:css:min": "sass scss/main.scss:assets/main.min.css --style=compressed",
    "watch:css:min": "sass --watch scss/main.scss:assets/main.min.css --style=compressed"
  },
  "devDependencies": {
    "sass": "^1.77.0"
  }
}

