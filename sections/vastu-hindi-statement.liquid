
<section {% render 'section-attr' %}>
  {% render 'section-bg-image' %}
  <xo-container {% render 'section-layout' %}>
    <div class='vastu-hindi-statement'>
      <xo-animate xo-cascade>
        <div class='vastu-hindi-statement__content'>
          {% render 'homepage-heading', title: section.settings.hindi_text, section: section, class: 'vastu-hindi-statement__text vastu-hindi-statement__text--quoted' %}
        </div>
      </xo-animate>
    </div>
  </xo-container>
</section>

{% schema %}
{
  "name": "Vastu Hindi Statement",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.all.width.label",
      "default": "wide",
      "options": [
        {
          "value": "box",
          "label": "t:sections.all.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.width.options__2.label"
        },
        {
          "value": "fullwidth",
          "label": "t:sections.all.width.options__3.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content Width (when section is fullwidth)",
      "default": "wide",
      "options": [
        {
          "value": "box",
          "label": "t:sections.all.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.width.options__2.label"
        }
      ],
      "info": "Controls the width of inner content when section width is set to fullwidth"
    },
    {
      "type": "text",
      "id": "hindi_text",
      "label": "Hindi Text",
      "default": "When your home is in balance, your life begins to breathe again."
    },
    {
      "type": "header",
      "content": "Heading Style (Overrides Global Settings)"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 0,
      "max": 6,
      "step": 0.1,
      "unit": "rem",
      "label": "Font Size",
      "default": 2.8,
      "info": "Set to 0 to use global setting (3.5rem). Default for Hindi section is 2.8rem"
    },
    {
      "type": "range",
      "id": "title_font_weight",
      "min": 0,
      "max": 900,
      "step": 100,
      "label": "Font Weight",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Text Color",
      "default": "#FFFFFF",
      "info": "Leave empty to use global setting"
    },
    {
      "type": "select",
      "id": "title_text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "",
          "label": "Use Global Setting"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "title_line_height",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "label": "Line Height",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "checkbox",
      "id": "title_enable_animation",
      "label": "Enable Heading Animation",
      "info": "Leave unchecked to use global setting"
    },
    {
      "type": "range",
      "id": "title_margin_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Desktop)",
      "default": 4,
      "info": "Set to 0 to use global setting (16px)"
    },
    {
      "type": "range",
      "id": "title_margin_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Mobile)",
      "default": 4,
      "info": "Set to 0 to use global setting (12px)"
    },
    {
      "type": "checkbox",
      "id": "title_enable_underline",
      "label": "Enable Underline",
      "default": false,
      "info": "Leave unchecked to use global setting"
    },
    {
      "type": "color",
      "id": "title_underline_color",
      "label": "Underline Color",
      "info": "Leave empty to use global setting"
    },
    {
      "type": "range",
      "id": "title_underline_width",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Underline Width",
      "default": 0,
      "info": "Set to 0 to use global setting (80px)"
    },
    {
      "type": "range",
      "id": "title_underline_height",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Underline Height",
      "default": 0,
      "info": "Set to 0 to use global setting (4px)"
    },
    {
      "type": "range",
      "id": "title_underline_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Underline Bottom Position (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting (8px)"
    },
    {
      "type": "range",
      "id": "title_underline_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Underline Bottom Position (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting (6px)"
    },
    {
      "type": "text",
      "id": "english_subtext",
      "label": "English Subtext (Optional)",
      "default": "Transform your home's energy, change the direction of prosperity"
    },
    {
      "type": "header",
      "content": "t:sections.all.heading.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "t:sections.all.background_type.label",
      "options": [
        {
          "value": "color",
          "label": "t:sections.all.background_type.option__1.label"
        },
        {
          "value": "gradient",
          "label": "t:sections.all.background_type.option__2.label"
        }
      ],
      "default": "color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.all.background_color.label",
      "alpha": true,
      "visible_if": "{{ section.settings.background_type == 'color' }}"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "default": 80
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "default": 16
    },
    {
      "type": "header",
      "content": "Section Spacing (Overrides Global Settings)"
    },
    {
      "type": "paragraph",
      "content": "Leave empty to use global settings. Desktop: 16px default, Mobile: 12px default"
    },
    {
      "type": "range",
      "id": "section_padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting (16px)"
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Top (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Top (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    }
  ]
}
{% endschema %}

