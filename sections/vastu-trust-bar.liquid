
<section {% render 'section-attr' %}>
  {% render 'section-bg-image' %}
  <xo-container {% render 'section-layout' %}>
    {% if section.settings.title != blank %}
      <div class='vastu-trust-bar__header'>
        {% if section.settings.title != blank %}
          <xo-animate xo-cascade>
            {% render 'homepage-heading', title: section.settings.title, section: section, class: 'vastu-trust-bar__title' %}
          </xo-animate>
        {% endif %}
      </div>
    {% endif %}
    <div class='vastu-trust-bar__grid' role='list' aria-label='Trust Bar'>
      {% for block in section.blocks %}
        <div class='vastu-trust-bar__item' role='listitem' aria-label='{{ forloop.index }} of {{ forloop.length }}' {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div class='vastu-trust-bar__icon'>
              {% render 'image', image: block.settings.icon %}
            </div>
          {% elsif block.settings.icon_svg != blank %}
            <div class='vastu-trust-bar__icon-svg'>{{ block.settings.icon_svg }}</div>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class='vastu-trust-bar__text'>{{ block.settings.text }}</p>
          {% endif %}
          {% if block.settings.subtitle != blank %}
            <span class='vastu-trust-bar__item-subtitle'>{{ block.settings.subtitle }}</span>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </xo-container>
    {% render 'section-separator',
    enable_separator: section.settings.enable_separator,
    separator_color: section.settings.separator_color,
    separator_height: section.settings.separator_height,
    separator_width: section.settings.separator_width,
    padding_top: section.settings.separator_padding_top,
    padding_bottom: section.settings.separator_padding_bottom
  %}
</section>

{% schema %}
{
  "name": "Vastu Trust Bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.all.width.label",
      "default": "wide",
      "options": [
        {
          "value": "box",
          "label": "t:sections.all.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.width.options__2.label"
        },
        {
          "value": "fullwidth",
          "label": "t:sections.all.width.options__3.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content Width (when section is fullwidth)",
      "default": "wide",
      "options": [
        {
          "value": "box",
          "label": "t:sections.all.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.width.options__2.label"
        }
      ],
      "info": "Controls the width of inner content when section width is set to fullwidth"
    },
    {
      "type": "header",
      "content": "Section Heading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Why Choose Us"
    },
    {
      "type": "header",
      "content": "Heading Style (Overrides Global Settings)"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 0,
      "max": 6,
      "step": 0.1,
      "unit": "rem",
      "label": "Font Size",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "title_font_weight",
      "min": 0,
      "max": 900,
      "step": 100,
      "label": "Font Weight",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Text Color",
      "info": "Leave empty to use global setting"
    },
    {
      "type": "select",
      "id": "title_text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "",
          "label": "Use Global Setting"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "title_line_height",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "label": "Line Height",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "checkbox",
      "id": "title_enable_animation",
      "label": "Enable Heading Animation",
      "info": "Leave unchecked to use global setting"
    },
    {
      "type": "range",
      "id": "title_margin_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting (16px)"
    },
    {
      "type": "range",
      "id": "title_margin_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting (12px)"
    },
    {
      "type": "checkbox",
      "id": "title_enable_underline",
      "label": "Enable Underline",
      "info": "Leave unchecked to use global setting"
    },
    {
      "type": "color",
      "id": "title_underline_color",
      "label": "Underline Color",
      "info": "Leave empty to use global setting"
    },
    {
      "type": "range",
      "id": "title_underline_width",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Underline Width",
      "default": 0,
      "info": "Set to 0 to use global setting (80px)"
    },
    {
      "type": "range",
      "id": "title_underline_height",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Underline Height",
      "default": 0,
      "info": "Set to 0 to use global setting (4px)"
    },
    {
      "type": "range",
      "id": "title_underline_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Underline Bottom Position (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting (8px)"
    },
    {
      "type": "range",
      "id": "title_underline_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Underline Bottom Position (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting (6px)"
    },
    {
      "type": "header",
      "content": "t:sections.all.heading.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "t:sections.all.background_type.label",
      "options": [
        {
          "value": "color",
          "label": "t:sections.all.background_type.option__1.label"
        }
      ],
      "default": "color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.all.background_color.label",
      "alpha": true,
      "visible_if": "{{ section.settings.background_type == 'color' }}"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "default": 50
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "default": 50
    },
    {
      "type": "header",
      "content": "Section Separator"
    },
    {
      "type": "checkbox",
      "id": "enable_separator",
      "label": "Enable Separator",
      "default": false
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator Color",
      "default": "#473855"
    },
    {
      "type": "range",
      "id": "separator_height",
      "min": 1,
      "max": 11,
      "step": 2,
      "unit": "px",
      "label": "Separator Height",
      "default": 1
    },
    {
      "type": "range",
      "id": "separator_width",
      "min": 5,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Separator Width",
      "default": 10
    },
    {
      "type": "number",
      "id": "separator_padding_top",
      "label": "Separator Top Padding",
      "default": 0
    },
    {
      "type": "number",
      "id": "separator_padding_bottom",
      "label": "Separator Bottom Padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG (Alternative)"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "On orders above र 500"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vastu Trust Bar",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "text": "Free Shipping on orders above र 500"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "text": "Easy Returns"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "text": "Secure Payment"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "text": "24/7 Support"
          }
        }
      ]
    }
  ]
}
{% endschema %}

