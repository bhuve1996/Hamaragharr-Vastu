        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Constant stress or negativity"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Our Vastu solutions help you overcome constant stress and negativity by creating positive energy flow in your space."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Help Address V1",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Positive Energy",
