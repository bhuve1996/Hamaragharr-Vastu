
<section {% render 'section-attr' %}>
  {% render 'section-bg-image' %}
  <xo-container {% render 'section-layout' %}>
    {% if section.settings.title != blank %}
      <xo-animate xo-cascade>
        {% render 'homepage-heading', title: section.settings.title, section: section, class: 'vastu-help-address-v1__section-title' %}
      </xo-animate>
    {% endif %}
    
    {% comment %} Desktop Grid View {% endcomment %}
    <xo-grid class='vastu-help-address-v1__grid vastu-help-address-v1__grid--desktop' style='--xs: 1; --sm: 2; --md: 2; --lg: 4; --xl: 4; --xxl: 4; --xo-grid-col-gap: {{ section.settings.gap }}px; --xo-grid-row-gap: {{ section.settings.gap }}px;'>
      {% for block in section.blocks %}
        <xo-animate xo-cascade class='vastu-help-address-v1__item' {{ block.shopify_attributes }}>
          <div class='vastu-help-address-v1__icon'>
            {% if block.settings.icon_svg != blank %}
              {{ block.settings.icon_svg }}
            {% elsif block.settings.icon_image != blank %}
              {% render 'image', image: block.settings.icon_image %}
            {% endif %}
          </div>
          {% if block.settings.text != blank %}
            <h3 class='vastu-help-address-v1__text'>{{ block.settings.text }}</h3>
          {% endif %}
          {% if block.settings.description != blank %}
            <div class='vastu-help-address-v1__description'>{{ block.settings.description }}</div>
          {% endif %}
        </xo-animate>
      {% endfor %}
    </xo-grid>

    {% comment %} Carousel pagination settings - section level overrides global {% endcomment %}
    {% liquid
      if section.settings.show_pagination_mobile != blank
        assign show_pagination_mobile = section.settings.show_pagination_mobile
      elsif settings.carousel_show_pagination_mobile != blank
        assign show_pagination_mobile = settings.carousel_show_pagination_mobile
      else
        assign show_pagination_mobile = true
      endif
    %}

    {% comment %} Mobile Carousel View {% endcomment %}
    <xo-carousel
      class='vastu-help-address-v1__carousel vastu-help-address-v1__carousel--mobile'
      xo-per-view='1'
      xo-render-bullet='<span></span>'
    >
      <xo-carousel-inner>
        <xo-carousel-list role='list' aria-label='Help Address Items'>
          {% for block in section.blocks %}
            <xo-carousel-slide
              aria-roledescription='slide'
              aria-label='{{ forloop.index }} of {{ forloop.length }}'
            >
              <div class='vastu-help-address-v1__item' {{ block.shopify_attributes }}>
                <div class='vastu-help-address-v1__icon'>
                  {% if block.settings.icon_svg != blank %}
                    {{ block.settings.icon_svg }}
                  {% elsif block.settings.icon_image != blank %}
                    {% render 'image', image: block.settings.icon_image %}
                  {% endif %}
                </div>
                {% if block.settings.text != blank %}
                  <h3 class='vastu-help-address-v1__text'>{{ block.settings.text }}</h3>
                {% endif %}
                {% if block.settings.description != blank %}
                  <div class='vastu-help-address-v1__description'>{{ block.settings.description }}</div>
                {% endif %}
              </div>
            </xo-carousel-slide>
          {% endfor %}
        </xo-carousel-list>
      </xo-carousel-inner>
      {% if show_pagination_mobile %}
        {% render 'carousel-pagination-style3', class: 'vastu-help-address-v1__pagination' %}
      {% endif %}
    </xo-carousel>
  </xo-container>
  {% render 'section-separator',
    enable_separator: section.settings.enable_separator,
    separator_color: section.settings.separator_color,
    separator_height: section.settings.separator_height,
    separator_width: section.settings.separator_width,
    padding_top: section.settings.separator_padding_top,
    padding_bottom: section.settings.separator_padding_bottom
  %}
</section>

{% schema %}
{
  "name": "Help Address V1",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.all.width.label",
      "default": "wide",
      "options": [
        {
          "value": "box",
          "label": "t:sections.all.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.width.options__2.label"
        },
        {
          "value": "fullwidth",
          "label": "t:sections.all.width.options__3.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content Width (when section is fullwidth)",
      "default": "wide",
      "options": [
        {
          "value": "box",
          "label": "t:sections.all.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.width.options__2.label"
        }
      ],
      "info": "Controls the width of inner content when section width is set to fullwidth"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "What Does It Help Address?"
    },
    {
      "type": "header",
      "content": "Heading Style (Overrides Global Settings)"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 0,
      "max": 6,
      "step": 0.1,
      "unit": "rem",
      "label": "Font Size",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "title_font_weight",
      "min": 0,
      "max": 900,
      "step": 100,
      "label": "Font Weight",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Text Color",
      "info": "Leave empty to use global setting"
    },
    {
      "type": "select",
      "id": "title_text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "",
          "label": "Use Global Setting"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "title_line_height",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "label": "Line Height",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "checkbox",
      "id": "title_enable_animation",
      "label": "Enable Heading Animation",
      "info": "Leave unchecked to use global setting"
    },
    {
      "type": "range",
      "id": "title_margin_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting (16px)"
    },
    {
      "type": "range",
      "id": "title_margin_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting (12px)"
    },
    {
      "type": "checkbox",
      "id": "title_enable_underline",
      "label": "Enable Underline",
      "info": "Leave unchecked to use global setting"
    },
    {
      "type": "color",
      "id": "title_underline_color",
      "label": "Underline Color",
      "info": "Leave empty to use global setting"
    },
    {
      "type": "range",
      "id": "title_underline_width",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Underline Width",
      "default": 0,
      "info": "Set to 0 to use global setting (80px)"
    },
    {
      "type": "range",
      "id": "title_underline_height",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Underline Height",
      "default": 0,
      "info": "Set to 0 to use global setting (4px)"
    },
    {
      "type": "range",
      "id": "title_underline_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Underline Bottom Position (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting (8px)"
    },
    {
      "type": "range",
      "id": "title_underline_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Underline Bottom Position (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting (6px)"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Gap Between Items",
      "default": 30
    },
    {
      "type": "header",
      "content": "t:sections.all.heading.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "t:sections.all.background_type.label",
      "options": [
        {
          "value": "color",
          "label": "t:sections.all.background_type.option__1.label"
        }
      ],
      "default": "color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.all.background_color.label",
      "alpha": true,
      "visible_if": "{{ section.settings.background_type == 'color' }}"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "default": 80
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "default": 80
    },
    {
      "type": "header",
      "content": "Section Spacing (Overrides Global Settings)"
    },
    {
      "type": "paragraph",
      "content": "Leave empty to use global settings. Desktop: 8px default, Mobile: 4px default"
    },
    {
      "type": "range",
      "id": "section_padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Top (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Top (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "header",
      "content": "Section Separator"
    },
    {
      "type": "checkbox",
      "id": "enable_separator",
      "label": "Enable Separator",
      "default": false
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator Color",
      "default": "#473855"
    },
    {
      "type": "range",
      "id": "separator_height",
      "min": 1,
      "max": 11,
      "step": 2,
      "unit": "px",
      "label": "Separator Height",
      "default": 1
    },
    {
      "type": "range",
      "id": "separator_width",
      "min": 5,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Separator Width",
      "default": 10
    },
    {
      "type": "number",
      "id": "separator_padding_top",
      "label": "Separator Padding Top",
      "default": 0
    },
    {
      "type": "number",
      "id": "separator_padding_bottom",
      "label": "Separator Padding Bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Carousel Pagination (Overrides Global Settings)"
    },
    {
      "type": "paragraph",
      "content": "Leave unchecked to use global carousel pagination settings"
    },
    {
      "type": "checkbox",
      "id": "show_pagination_mobile",
      "label": "Show Pagination Dots (Mobile)",
      "info": "Leave unchecked to use global setting"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Address Item",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
