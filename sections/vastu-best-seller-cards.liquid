<section {% render 'section-attr' %}>
  {% render 'section-bg-image' %}
  <xo-container {% render 'section-layout' %}>
    {% assign has_visible_items = false %}
    {% for block in section.blocks %}
      {% if block.settings.product != blank %}
        {% assign has_visible_items = true %}
        {% break %}
      {% endif %}
    {% endfor %}
    
    {% if section.settings.title != blank and has_visible_items %}
      <xo-animate xo-cascade>
        {% render 'homepage-heading', title: section.settings.title, section: section, class: 'vastu-section-title' %}
      </xo-animate>
    {% endif %}
    
    {% assign visible_blocks_count = 0 %}
    {% for block in section.blocks %}
      {% if block.settings.product != blank %}
        {% assign visible_blocks_count = visible_blocks_count | plus: 1 %}
      {% endif %}
    {% endfor %}
    
    {% comment %} Carousel pagination settings - section level overrides global {% endcomment %}
    {% liquid
      if section.settings.show_pagination_desktop != blank
        assign show_pagination_desktop = section.settings.show_pagination_desktop
      elsif settings.carousel_show_pagination_desktop != blank
        assign show_pagination_desktop = settings.carousel_show_pagination_desktop
      else
        assign show_pagination_desktop = true
      endif
      
      if section.settings.show_pagination_mobile != blank
        assign show_pagination_mobile = section.settings.show_pagination_mobile
      elsif settings.carousel_show_pagination_mobile != blank
        assign show_pagination_mobile = settings.carousel_show_pagination_mobile
      else
        assign show_pagination_mobile = true
      endif
    %}
    
    {% if visible_blocks_count > 3 %}
      {% comment %} Use carousel when more than 3 items {% endcomment %}
      <xo-carousel
        xo-per-view='3'
        xo-gap='30'
        xo-speed='400'
        xo-breakpoints='{"768": {"perView": 1}, "992": {"perView": 3}}'
        xo-render-bullet='<span></span>'
      >
        <xo-carousel-inner>
          <xo-carousel-list role='list' aria-label='{{ 'general.slider.name' | t }}'>
            {% for block in section.blocks %}
              {% if block.settings.product != blank %}
                {% assign current_product = all_products[block.settings.product] %}
                {% if current_product != blank %}
                  <xo-carousel-slide aria-roledescription='{{ 'sections.slideshow.slide' | t }}' aria-label='{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}' {{ block.shopify_attributes }}>
                    {% render 'vastu-product-card', product: current_product, section: section, settings: section.settings, block: block %}
                  </xo-carousel-slide>
                {% endif %}
              {% endif %}
            {% endfor %}
          </xo-carousel-list>
        </xo-carousel-inner>
        {% if show_pagination_desktop or show_pagination_mobile %}
          <div class='vastu-best-seller__pagination' style='--display-desktop: {% if show_pagination_desktop %}block{% else %}none{% endif %}; --display-mobile: {% if show_pagination_mobile %}block{% else %}none{% endif %};'>
            {% render 'carousel-pagination-style3' %}
          </div>
        {% endif %}
      </xo-carousel>
    {% else %}
      {% comment %} Use grid when 3 or fewer items {% endcomment %}
      <xo-grid style='--xs: 1; --sm: 1; --md: 2; --lg: 3; --xl: 3; --xxl: 3; --xo-grid-col-gap: 30px; --xo-grid-row-gap: 30px;'>
        {% for block in section.blocks %}
          {% if block.settings.product != blank %}
            {% assign current_product = all_products[block.settings.product] %}
            {% if current_product != blank %}
              <div {{ block.shopify_attributes }}>
                {% render 'vastu-product-card', product: current_product, section: section, settings: section.settings, block: block %}
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </xo-grid>
    {% endif %}
  </xo-container>
  
  {% render 'section-separator',
    enable_separator: section.settings.enable_separator,
    separator_color: section.settings.separator_color,
    separator_height: section.settings.separator_height,
    separator_width: section.settings.separator_width,
    padding_top: section.settings.separator_padding_top,
    padding_bottom: section.settings.separator_padding_bottom
  %}
</section>

{% schema %}
{
  "name": "Vastu Best Seller Cards",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.all.width.label",
      "default": "wide",
      "options": [
        {
          "value": "box",
          "label": "t:sections.all.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.width.options__2.label"
        },
        {
          "value": "fullwidth",
          "label": "t:sections.all.width.options__3.label"
        }
      ]
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Best Sellers"
    },
    {
      "type": "header",
      "content": "Heading Style (Overrides Global Settings)"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 0,
      "max": 6,
      "step": 0.1,
      "unit": "rem",
      "label": "Font Size",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "title_font_weight",
      "min": 0,
      "max": 900,
      "step": 100,
      "label": "Font Weight",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Text Color",
      "info": "Leave empty to use global setting"
    },
    {
      "type": "select",
      "id": "title_text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "",
          "label": "Use Global Setting"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "title_line_height",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "label": "Line Height",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "checkbox",
      "id": "title_enable_animation",
      "label": "Enable Heading Animation",
      "info": "Leave unchecked to use global setting"
    },
    {
      "type": "range",
      "id": "title_margin_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting (16px)"
    },
    {
      "type": "range",
      "id": "title_margin_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting (12px)"
    },
    {
      "type": "checkbox",
      "id": "title_enable_underline",
      "label": "Enable Underline",
      "info": "Leave unchecked to use global setting"
    },
    {
      "type": "color",
      "id": "title_underline_color",
      "label": "Underline Color",
      "info": "Leave empty to use global setting"
    },
    {
      "type": "range",
      "id": "title_underline_width",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Underline Width",
      "default": 0,
      "info": "Set to 0 to use global setting (80px)"
    },
    {
      "type": "range",
      "id": "title_underline_height",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Underline Height",
      "default": 0,
      "info": "Set to 0 to use global setting (4px)"
    },
    {
      "type": "range",
      "id": "title_underline_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Underline Bottom Position (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting (8px)"
    },
    {
      "type": "range",
      "id": "title_underline_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Underline Bottom Position (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting (6px)"
    },
    {
      "type": "header",
      "content": "t:sections.all.heading.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "t:sections.all.background_type.label",
      "options": [
        {
          "value": "color",
          "label": "t:sections.all.background_type.option__1.label"
        },
        {
          "value": "gradient",
          "label": "t:sections.all.background_type.option__2.label"
        }
      ],
      "default": "color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.all.background_color.label",
      "alpha": true,
      "visible_if": "{{ section.settings.background_type == 'color' }}"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "default": 80
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "default": 80
    },
    {
      "type": "header",
      "content": "Section Separator"
    },
    {
      "type": "checkbox",
      "id": "enable_separator",
      "label": "Enable Separator",
      "default": false
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator Color",
      "default": "#473855"
    },
    {
      "type": "range",
      "id": "separator_height",
      "min": 1,
      "max": 11,
      "step": 2,
      "unit": "px",
      "label": "Separator Height",
      "default": 1
    },
    {
      "type": "range",
      "id": "separator_width",
      "min": 5,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Separator Width",
      "default": 10
    },
    {
      "type": "number",
      "id": "separator_padding_top",
      "label": "Separator Top Padding",
      "default": 15
    },
    {
      "type": "number",
      "id": "separator_padding_bottom",
      "label": "Separator Bottom Padding",
      "default": 15
    },
    {
      "type": "header",
      "content": "Product Card Settings"
    },
    {
      "type": "text",
      "id": "button_text_add_to_cart",
      "label": "Add to Cart Button Text",
      "default": "Add to Cart"
    },
    {
      "type": "range",
      "id": "card_title_font_size",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "unit": "rem",
      "label": "Card Title Font Size",
      "default": 1.5
    },
    {
      "type": "range",
      "id": "card_price_font_size",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "unit": "rem",
      "label": "Card Price Font Size",
      "default": 1.2
    },
    {
      "type": "header",
      "content": "Carousel Pagination (Overrides Global Settings)"
    },
    {
      "type": "paragraph",
      "content": "Leave unchecked to use global carousel pagination settings"
    },
    {
      "type": "checkbox",
      "id": "show_pagination_desktop",
      "label": "Show Pagination Dots (Desktop)",
      "info": "Leave unchecked to use global setting"
    },
    {
      "type": "checkbox",
      "id": "show_pagination_mobile",
      "label": "Show Pagination Dots (Mobile)",
      "info": "Leave unchecked to use global setting"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Best Seller Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Select a product to display"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vastu Best Seller Cards",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
