{% comment %}
  Grid/Carousel Section
  - Mobile: Grid layout (2 columns)
  - Desktop: Full bleed carousel
  - Configurable carousel controls (navigation arrows and pagination dots) for desktop
  - Configurable positioning for pagination dots
{% endcomment %}

{{ 'vastu-grid-carousel.min.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign product_source = section.settings.product_source | default: 'collection'
  assign collection = section.settings.collection
  assign products_limit = section.settings.products_limit | default: 6
  assign view_more_limit = section.settings.view_more_limit | default: 6
  assign columns_desktop = section.settings.columns_desktop | default: 4
  
  if product_source == 'blocks'
    assign has_products = false
    assign total_products = 0
    
    for block in section.blocks
      if block.type == 'product' and block.settings.product != blank
        assign current_product_check = all_products[block.settings.product]
        if current_product_check != blank
          assign has_products = true
          assign total_products = total_products | plus: 1
        endif
      endif
    endfor
  else
    if collection == blank or collection.products.size == 0
      assign has_products = false
      assign total_products = 0
    else
      comment
        Count unique products by tracking seen product handles
      endcomment
      assign seen_handles_count = ''
      assign unique_count = 0
      
      for product in collection.products
        assign product_handle_check = product.handle | append: '|'
        unless seen_handles_count contains product_handle_check
          assign seen_handles_count = seen_handles_count | append: product_handle_check
          assign unique_count = unique_count | plus: 1
        endunless
      endfor
      
      if unique_count > 0
        assign has_products = true
        assign total_products = unique_count
      else
        assign has_products = false
        assign total_products = 0
      endif
    endif
  endif
  
  assign has_more_products = false
  if total_products > products_limit
    assign has_more_products = true
  endif
-%}

<div {% render 'section-attr' %} data-section-id='{{ section.id }}'>
  {% render 'section-bg-image' %}
  
  {% unless has_products %}
    <xo-container>
      <p>{% if product_source == 'blocks' %}No products added. Please add products using the blocks below.{% else %}No products available in this collection.{% endif %}</p>
    </xo-container>
  {% else %}
  
  {% if section.settings.width == 'fullwidth' %}
    {% comment %} Full bleed carousel on desktop {% endcomment %}
    <div class='vastu-grid-carousel__wrapper' style='--padding: {{ section.settings.fullwidth_margin }}px'>
      <xo-container class='vastu-grid-carousel__container xo-container--{{ section.settings.content_width | default: "wide" }}'>
        <xo-animate xo-cascade>
          {% render 'homepage-heading', title: section.settings.heading_title, section: section %}
        </xo-animate>
      </xo-container>
      
      {% comment %} Mobile Grid (hidden on desktop) {% endcomment %}
      <div class='vastu-grid-carousel__mobile-grid'>
        <xo-container>
          <xo-grid class='vastu-grid-carousel__grid' style='--xs: 2; --sm: 2; --md: 2; --lg: 2; --xl: 2; --xxl: 2; --xo-grid-col-gap: 20px; --xo-grid-row-gap: 20px;'>
            {%- assign has_hidden_items_mobile1 = false -%}
            {%- if product_source == 'blocks' -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'product' and block.settings.product != blank -%}
                  {%- assign current_product = all_products[block.settings.product] -%}
                  {%- if current_product != blank -%}
                    {%- if forloop.index <= products_limit -%}
                    <div class='vastu-grid-carousel__grid-item' {{ block.shopify_attributes }}>
                      {% render 'vastu-grid-card',
                        product: current_product,
                        section: section,
                        settings: section.settings
                      %}
                    </div>
                    {%- else -%}
                      {%- assign has_hidden_items_mobile1 = true -%}
                      <div class='vastu-grid-carousel__grid-item vastu-grid-carousel__grid-item--hidden' {{ block.shopify_attributes }}>
                        {% render 'vastu-grid-card',
                          product: current_product,
                          section: section,
                          settings: section.settings
                        %}
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- assign seen_handles = '' -%}
              {%- assign rendered_count = 0 -%}
              {%- for product in collection.products -%}
                {%- assign product_handle_check = product.handle | append: '|' -%}
                {%- unless seen_handles contains product_handle_check -%}
                  {%- assign seen_handles = seen_handles | append: product_handle_check -%}
                  {%- assign rendered_count = rendered_count | plus: 1 -%}
                  {%- if rendered_count <= products_limit -%}
                  <div class='vastu-grid-carousel__grid-item'>
                    {% render 'vastu-grid-card',
                      product: product,
                      section: section,
                      settings: section.settings
                    %}
                  </div>
                  {%- else -%}
                    {%- assign has_hidden_items_mobile1 = true -%}
                    <div class='vastu-grid-carousel__grid-item vastu-grid-carousel__grid-item--hidden'>
                      {% render 'vastu-grid-card',
                        product: product,
                        section: section,
                        settings: section.settings
                      %}
                    </div>
                  {%- endif -%}
                {%- endunless -%}
              {%- endfor -%}
            {%- endif -%}
          </xo-grid>
        </xo-container>
        {%- if has_hidden_items_mobile1 -%}
          <div class='vastu-grid-carousel__view-more-wrapper'>
            <button 
              type='button'
              class='vastu-grid-carousel__view-more-btn'
              data-section-id='{{ section.id }}'
              data-current-limit='{{ products_limit }}'
              data-increment='{{ view_more_limit }}'
              data-total-products='{{ total_products }}'
              data-layout='mobile'
            >
              {{ section.settings.view_more_text | default: 'View More' }}
            </button>
          </div>
        {%- endif -%}
      </div>
      
      {% comment %} Desktop Carousel (hidden on mobile) - Full Bleed {% endcomment %}
      <div class='vastu-grid-carousel__desktop-carousel vastu-grid-carousel__desktop-carousel--fullwidth'>
        <xo-carousel
          xo-per-view='{{ columns_desktop }}'
          xo-gap='20'
          xo-speed='400'
          xo-autoplay='5000'
          xo-loop
          xo-hover-pause
          xo-breakpoints='{"768": {"perView": 2}, "992": {"perView": {{ columns_desktop }}}}'
          xo-render-bullet='<span></span>'
          class='vastu-grid-carousel__carousel'
        >
          <xo-carousel-inner>
            <xo-carousel-list role='list' aria-label='{{ 'general.slider.name' | t }}'>
              {%- if product_source == 'blocks' -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'product' and block.settings.product != blank -%}
                    {%- assign current_product = all_products[block.settings.product] -%}
                    {%- if current_product != blank -%}
                      <xo-carousel-slide 
                        aria-roledescription='{{ 'sections.slideshow.slide' | t }}' 
                        aria-label='{{ forloop.index }} {{ 'general.slider.of' | t }} {{ total_products }}'
                        data-product-index='{{ forloop.index }}'
                        {{ block.shopify_attributes }}
                      >
                        {% render 'vastu-grid-card',
                          product: current_product,
                          section: section,
                          settings: section.settings
                        %}
                      </xo-carousel-slide>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- assign seen_handles_desktop = '' -%}
                {%- assign rendered_count_desktop = 0 -%}
                {%- for product in collection.products -%}
                  {%- assign product_handle_check = product.handle | append: '|' -%}
                  {%- unless seen_handles_desktop contains product_handle_check -%}
                    {%- assign seen_handles_desktop = seen_handles_desktop | append: product_handle_check -%}
                    {%- assign rendered_count_desktop = rendered_count_desktop | plus: 1 -%}
                    <xo-carousel-slide 
                      aria-roledescription='{{ 'sections.slideshow.slide' | t }}' 
                      aria-label='{{ rendered_count_desktop }} {{ 'general.slider.of' | t }} {{ total_products }}'
                      data-product-index='{{ rendered_count_desktop }}'
                    >
                      {% render 'vastu-grid-card',
                        product: product,
                        section: section,
                        settings: section.settings
                      %}
                    </xo-carousel-slide>
                  {%- endunless -%}
                {%- endfor -%}
              {%- endif -%}
            </xo-carousel-list>
          </xo-carousel-inner>
          {%- liquid
            if section.settings.show_navigation
              assign nav_desktop = 'flex'
            else
              assign nav_desktop = 'none'
            endif
            if section.settings.show_pagination
              assign pag_desktop = 'block'
            else
              assign pag_desktop = 'none'
            endif
          -%}
          {% render 'vastu-carousel-controls',
            show_navigation: section.settings.show_navigation,
            show_pagination: section.settings.show_pagination,
            navigation_desktop: nav_desktop,
            navigation_mobile: 'none',
            pagination_desktop: pag_desktop,
            pagination_mobile: 'none',
            pagination_position: section.settings.pagination_position_desktop,
            pagination_offset: section.settings.pagination_offset_desktop,
            pagination_class: 'vastu-grid-carousel__pagination'
          %}
        </xo-carousel>
      </div>
    </div>
  {% else %}
    {% comment %} Box/Wide container layout {% endcomment %}
    <xo-container {% render 'section-layout' %}>
      <xo-animate xo-cascade>
        {% render 'homepage-heading', title: section.settings.heading_title, section: section %}
      </xo-animate>
      
      {% comment %} Mobile Grid {% endcomment %}
      <div class='vastu-grid-carousel__mobile-grid'>
        <xo-grid class='vastu-grid-carousel__grid' style='--xs: 2; --sm: 2; --md: 2; --lg: 2; --xl: 2; --xxl: 2; --xo-grid-col-gap: 20px; --xo-grid-row-gap: 20px;'>
          {%- assign has_hidden_items_mobile2 = false -%}
          {%- if product_source == 'blocks' -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'product' and block.settings.product != blank -%}
                {%- assign current_product = all_products[block.settings.product] -%}
                {%- if current_product != blank -%}
                  {%- if forloop.index <= products_limit -%}
                  <div class='vastu-grid-carousel__grid-item' {{ block.shopify_attributes }}>
                    {% render 'vastu-grid-card',
                      product: current_product,
                      section: section,
                      settings: section.settings
                    %}
                  </div>
                  {%- else -%}
                    {%- assign has_hidden_items_mobile2 = true -%}
                    <div class='vastu-grid-carousel__grid-item vastu-grid-carousel__grid-item--hidden' {{ block.shopify_attributes }}>
                      {% render 'vastu-grid-card',
                        product: current_product,
                        section: section,
                        settings: section.settings
                      %}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- assign seen_handles_mobile2 = '' -%}
            {%- assign rendered_count_mobile2 = 0 -%}
            {%- for product in collection.products -%}
              {%- assign product_handle_check = product.handle | append: '|' -%}
              {%- unless seen_handles_mobile2 contains product_handle_check -%}
                {%- assign seen_handles_mobile2 = seen_handles_mobile2 | append: product_handle_check -%}
                {%- assign rendered_count_mobile2 = rendered_count_mobile2 | plus: 1 -%}
                {%- if rendered_count_mobile2 <= products_limit -%}
                <div class='vastu-grid-carousel__grid-item'>
                  {% render 'vastu-grid-card',
                    product: product,
                    section: section,
                    settings: section.settings
                  %}
                </div>
                {%- else -%}
                  {%- assign has_hidden_items_mobile2 = true -%}
                  <div class='vastu-grid-carousel__grid-item vastu-grid-carousel__grid-item--hidden'>
                    {% render 'vastu-grid-card',
                      product: product,
                      section: section,
                      settings: section.settings
                    %}
                  </div>
                {%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        </xo-grid>
        {%- if has_hidden_items_mobile2 -%}
          <div class='vastu-grid-carousel__view-more-wrapper'>
            <button 
              type='button'
              class='vastu-grid-carousel__view-more-btn'
              data-section-id='{{ section.id }}'
              data-current-limit='{{ products_limit }}'
              data-increment='{{ view_more_limit }}'
              data-total-products='{{ total_products }}'
              data-layout='mobile'
            >
              {{ section.settings.view_more_text | default: 'View More' }}
            </button>
          </div>
        {%- endif -%}
      </div>
      
      {% comment %} Desktop Carousel {% endcomment %}
      <div class='vastu-grid-carousel__desktop-carousel'>
        <xo-carousel
          xo-per-view='{{ columns_desktop }}'
          xo-gap='20'
          xo-speed='400'
          xo-autoplay='5000'
          xo-loop
          xo-hover-pause
          xo-breakpoints='{"768": {"perView": 2}, "992": {"perView": {{ columns_desktop }}}}'
          xo-render-bullet='<span></span>'
          class='vastu-grid-carousel__carousel'
        >
          <xo-carousel-inner>
            <xo-carousel-list role='list' aria-label='{{ 'general.slider.name' | t }}'>
              {%- if product_source == 'blocks' -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'product' and block.settings.product != blank -%}
                    {%- assign current_product = all_products[block.settings.product] -%}
                    {%- if current_product != blank -%}
                      <xo-carousel-slide 
                        aria-roledescription='{{ 'sections.slideshow.slide' | t }}' 
                        aria-label='{{ forloop.index }} {{ 'general.slider.of' | t }} {{ total_products }}'
                        data-product-index='{{ forloop.index }}'
                        {{ block.shopify_attributes }}
                      >
                        {% render 'vastu-grid-card',
                          product: current_product,
                          section: section,
                          settings: section.settings
                        %}
                      </xo-carousel-slide>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- assign seen_handles_desktop = '' -%}
                {%- assign rendered_count_desktop = 0 -%}
                {%- for product in collection.products -%}
                  {%- assign product_handle_check = product.handle | append: '|' -%}
                  {%- unless seen_handles_desktop contains product_handle_check -%}
                    {%- assign seen_handles_desktop = seen_handles_desktop | append: product_handle_check -%}
                    {%- assign rendered_count_desktop = rendered_count_desktop | plus: 1 -%}
                    <xo-carousel-slide 
                      aria-roledescription='{{ 'sections.slideshow.slide' | t }}' 
                      aria-label='{{ rendered_count_desktop }} {{ 'general.slider.of' | t }} {{ total_products }}'
                      data-product-index='{{ rendered_count_desktop }}'
                    >
                      {% render 'vastu-grid-card',
                        product: product,
                        section: section,
                        settings: section.settings
                      %}
                    </xo-carousel-slide>
                  {%- endunless -%}
                {%- endfor -%}
              {%- endif -%}
            </xo-carousel-list>
          </xo-carousel-inner>
          {%- liquid
            if section.settings.show_navigation
              assign nav_desktop = 'flex'
            else
              assign nav_desktop = 'none'
            endif
            if section.settings.show_pagination
              assign pag_desktop = 'block'
            else
              assign pag_desktop = 'none'
            endif
          -%}
          {% render 'vastu-carousel-controls',
            show_navigation: section.settings.show_navigation,
            show_pagination: section.settings.show_pagination,
            navigation_desktop: nav_desktop,
            navigation_mobile: 'none',
            pagination_desktop: pag_desktop,
            pagination_mobile: 'none',
            pagination_position: section.settings.pagination_position_desktop,
            pagination_offset: section.settings.pagination_offset_desktop,
            pagination_class: 'vastu-grid-carousel__pagination'
          %}
        </xo-carousel>
      </div>
    </xo-container>
  {% endif %}
  
  {% endunless %}
</div>

<script>
  (function() {
    var VISIBLE_CLASS = 'vastu-grid-carousel__view-more-visible';
    var HIDDEN_ITEM_CLASS = 'vastu-grid-carousel__grid-item--hidden';
    var MOBILE_MAX = 991;

    function isMobile() {
      return window.innerWidth <= MOBILE_MAX;
    }

    function syncViewMore() {
      document.querySelectorAll('.vastu-grid-carousel__view-more-wrapper').forEach(function(wrapper) {
        var mobileGrid = wrapper.closest('.vastu-grid-carousel__mobile-grid');
        if (!mobileGrid) return;
        var hiddenCount = mobileGrid.querySelectorAll('.' + HIDDEN_ITEM_CLASS).length;
        if (isMobile() && hiddenCount > 0) {
          wrapper.classList.add(VISIBLE_CLASS);
        } else {
          wrapper.classList.remove(VISIBLE_CLASS);
        }
      });
    }

    function initViewMore() {
      document.querySelectorAll('.vastu-grid-carousel__view-more-btn').forEach(function(btn) {
        if (btn.dataset.vastuViewMoreInit) return;
        btn.dataset.vastuViewMoreInit = '1';

        btn.addEventListener('click', function() {
          var wrapper = this.closest('.vastu-grid-carousel__view-more-wrapper');
          var mobileGrid = wrapper && wrapper.closest('.vastu-grid-carousel__mobile-grid');
          if (!mobileGrid) return;

          var increment = parseInt(this.dataset.increment, 10) || 6;
          var hidden = mobileGrid.querySelectorAll('.' + HIDDEN_ITEM_CLASS);
          var toShow = Math.min(hidden.length, increment);

          for (var i = 0; i < toShow; i++) {
            if (hidden[i]) hidden[i].classList.remove(HIDDEN_ITEM_CLASS);
          }

          syncViewMore();
        });
      });
    }

    function run() {
      initViewMore();
      syncViewMore();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
      document.addEventListener('DOMContentLoaded', function() { setTimeout(run, 100); });
    } else {
      run();
      setTimeout(run, 100);
    }
    window.addEventListener('resize', syncViewMore);
  })();
</script>

{% schema %}
{
  "name": "Vastu Grid Carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading_title",
      "label": "Heading Title",
      "default": "Featured Products"
    },
    {
      "type": "textarea",
      "id": "heading_description",
      "label": "Heading Description"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.all.width.label",
      "default": "fullwidth",
      "options": [
        {
          "value": "box",
          "label": "t:sections.all.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.width.options__2.label"
        },
        {
          "value": "fullwidth",
          "label": "t:sections.all.width.options__3.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content Width (when section is fullwidth)",
      "default": "wide",
      "options": [
        {
          "value": "box",
          "label": "t:sections.all.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.width.options__2.label"
        }
      ],
      "info": "Controls the width of inner content when section width is set to fullwidth",
      "visible_if": "{{ section.settings.width == 'fullwidth' }}"
    },
    {
      "type": "number",
      "id": "fullwidth_margin",
      "label": "t:sections.all.fullwidth_margin.label",
      "default": 0,
      "visible_if": "{{ section.settings.width == 'fullwidth' }}"
    },
    {
      "type": "select",
      "id": "product_source",
      "label": "Product Source",
      "default": "collection",
      "options": [
        {
          "value": "collection",
          "label": "From Collection"
        },
        {
          "value": "blocks",
          "label": "Individual Products (Blocks)"
        }
      ],
      "info": "Choose to display products from a collection or select individual products using blocks"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Select a collection to display products from (only used when Product Source is 'From Collection')"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 6,
      "label": "Initial Products to Show (Mobile Grid)"
    },
    {
      "type": "range",
      "id": "view_more_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Products to Load on View More (Mobile Grid)"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Desktop Columns (Products Per Row)",
      "info": "Number of products visible in one row on desktop. The carousel will scroll to show more products."
    },
    {
      "type": "text",
      "id": "view_more_text",
      "label": "View More Button Text",
      "default": "View More"
    },
    {
      "type": "header",
      "content": "Carousel Controls - Desktop"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show Navigation Arrows (Desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show Pagination Dots (Desktop)",
      "default": true
    },
    {
      "type": "select",
      "id": "pagination_position_desktop",
      "label": "Pagination Position (Desktop)",
      "default": "bottom",
      "options": [
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "text",
      "id": "pagination_offset_desktop",
      "label": "Pagination Offset (Desktop)",
      "default": "1rem",
      "info": "Distance from bottom (e.g. '1rem' = inside content; negative = into section padding)"
    },
    {
      "type": "header",
      "content": "Carousel Controls - Mobile"
    },
    {
      "type": "checkbox",
      "id": "show_navigation_mobile",
      "label": "Show Navigation Arrows (Mobile)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_pagination_mobile",
      "label": "Show Pagination Dots (Mobile)",
      "default": true
    },
    {
      "type": "select",
      "id": "pagination_position_mobile",
      "label": "Pagination Position (Mobile)",
      "default": "bottom",
      "options": [
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "text",
      "id": "pagination_offset_mobile",
      "label": "Pagination Offset (Mobile)",
      "default": "1rem",
      "info": "Distance from bottom (e.g. '1rem' = inside content; negative = into section padding)"
    },
    {
      "type": "header",
      "content": "Card Styling"
    },
    {
      "type": "range",
      "id": "card_title_font_size",
      "min": 1,
      "max": 3,
