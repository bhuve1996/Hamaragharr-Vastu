{% comment %}
  Grid/Carousel Section
  - Mobile: Carousel with partial next item visible (shows 85% of current item)
  - Desktop: Full bleed carousel
  - Configurable carousel controls (navigation arrows and pagination dots)
  - Configurable positioning for pagination dots
{% endcomment %}

{{ 'vastu-grid-carousel.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = section.settings.collection
  assign products_limit = section.settings.products_limit | default: 4
  assign view_more_limit = section.settings.view_more_limit | default: 4
  assign columns_desktop = section.settings.columns_desktop | default: 4
  
  if collection == blank or collection.products.size == 0
    assign has_products = false
    assign total_products = 0
  else
    assign has_products = true
    assign total_products = collection.products.size
  endif
  
  assign has_more_products = false
  if total_products > products_limit
    assign has_more_products = true
  endif
-%}

<div {% render 'section-attr' %}>
  {% render 'section-bg-image' %}
  
  {% unless has_products %}
    <xo-container>
      <p>No products available in this collection.</p>
    </xo-container>
  {% else %}
  
  {% if section.settings.width == 'fullwidth' %}
    {% comment %} Full bleed carousel on desktop {% endcomment %}
    <div class='vastu-grid-carousel__wrapper'>
      <xo-container class='vastu-grid-carousel__container'>
        <xo-animate xo-cascade>
          {% render 'homepage-heading', title: section.settings.heading_title, section: section %}
        </xo-animate>
        {% render 'space', value: '2rem' %}
      </xo-container>
      
      {% comment %} Mobile Carousel (hidden on desktop) - Shows partial next item {% endcomment %}
      <div class='vastu-grid-carousel__mobile-carousel'>
        <xo-container>
          <xo-carousel
            xo-per-view='1'
            xo-gap='10'
            xo-speed='400'
            xo-render-bullet='<span></span>'
            class='vastu-grid-carousel__carousel'
          >
            <xo-carousel-inner>
              <xo-carousel-list role='list' aria-label='{{ 'general.slider.name' | t }}'>
                {%- for product in collection.products -%}
                  {%- if forloop.index <= products_limit -%}
                  <xo-carousel-slide 
                    aria-roledescription='{{ 'sections.slideshow.slide' | t }}' 
                    aria-label='{{ forloop.index }} {{ 'general.slider.of' | t }} {{ collection.products.size }}'
                    data-product-index='{{ forloop.index }}'
                  >
                    {% render 'vastu-grid-card',
                      product: product,
                      section: section,
                      settings: section.settings
                    %}
                  </xo-carousel-slide>
                  {%- else -%}
                    <xo-carousel-slide 
                      aria-roledescription='{{ 'sections.slideshow.slide' | t }}' 
                      aria-label='{{ forloop.index }} {{ 'general.slider.of' | t }} {{ collection.products.size }}'
                      data-product-index='{{ forloop.index }}'
                      class='vastu-grid-carousel__slide--hidden'
                    >
                      {% render 'vastu-grid-card',
                        product: product,
                        section: section,
                        settings: section.settings
                      %}
                    </xo-carousel-slide>
                  {%- endif -%}
                {%- endfor -%}
              </xo-carousel-list>
            </xo-carousel-inner>
            {%- liquid
              if section.settings.show_navigation_mobile
                assign nav_mobile = 'flex'
              else
                assign nav_mobile = 'none'
              endif
              if section.settings.show_pagination_mobile
                assign pag_mobile = 'block'
              else
                assign pag_mobile = 'none'
              endif
            -%}
            {% render 'vastu-carousel-controls',
              show_navigation: section.settings.show_navigation_mobile,
              show_pagination: section.settings.show_pagination_mobile,
              navigation_desktop: 'none',
              navigation_mobile: nav_mobile,
              pagination_desktop: 'none',
              pagination_mobile: pag_mobile,
              pagination_position: section.settings.pagination_position_mobile,
              pagination_offset: section.settings.pagination_offset_mobile
            %}
          </xo-carousel>
        </xo-container>
        {%- if has_more_products -%}
          <div class='vastu-grid-carousel__view-more-wrapper'>
            <button 
              type='button'
              class='vastu-grid-carousel__view-more-btn'
              data-section-id='{{ section.id }}'
              data-current-limit='{{ products_limit }}'
              data-increment='{{ view_more_limit }}'
              data-total-products='{{ total_products }}'
              data-layout='mobile'
            >
              {{ section.settings.view_more_text | default: 'View More' }}
            </button>
          </div>
        {%- endif -%}
      </div>
      
      {% comment %} Desktop Carousel (hidden on mobile) - Full Bleed {% endcomment %}
      <div class='vastu-grid-carousel__desktop-carousel vastu-grid-carousel__desktop-carousel--fullwidth'>
        <xo-carousel
          xo-per-view='{{ columns_desktop }}'
          xo-gap='20'
          xo-speed='400'
          xo-breakpoints='{"768": {"perView": 2}, "992": {"perView": {{ columns_desktop }}}}'
          xo-render-bullet='<span></span>'
          class='vastu-grid-carousel__carousel'
        >
          <xo-carousel-inner>
            <xo-carousel-list role='list' aria-label='{{ 'general.slider.name' | t }}'>
              {%- for product in collection.products -%}
                <xo-carousel-slide 
                  aria-roledescription='{{ 'sections.slideshow.slide' | t }}' 
                  aria-label='{{ forloop.index }} {{ 'general.slider.of' | t }} {{ collection.products.size }}'
                  data-product-index='{{ forloop.index }}'
                >
                  {% render 'vastu-grid-card',
                    product: product,
                    section: section,
                    settings: section.settings
                  %}
                </xo-carousel-slide>
              {%- endfor -%}
            </xo-carousel-list>
          </xo-carousel-inner>
          {%- liquid
            if section.settings.show_navigation
              assign nav_desktop = 'flex'
            else
              assign nav_desktop = 'none'
            endif
            if section.settings.show_pagination
              assign pag_desktop = 'block'
            else
              assign pag_desktop = 'none'
            endif
          -%}
          {% render 'vastu-carousel-controls',
            show_navigation: section.settings.show_navigation,
            show_pagination: section.settings.show_pagination,
            navigation_desktop: nav_desktop,
            navigation_mobile: 'none',
            pagination_desktop: pag_desktop,
            pagination_mobile: 'none',
            pagination_position: section.settings.pagination_position_desktop,
            pagination_offset: section.settings.pagination_offset_desktop,
            pagination_class: 'vastu-grid-carousel__pagination'
          %}
        </xo-carousel>
      </div>
    </div>
  {% else %}
    {% comment %} Box/Wide container layout {% endcomment %}
    <xo-container {% render 'section-layout' %}>
      <xo-animate xo-cascade>
        {% render 'homepage-heading', title: section.settings.heading_title, section: section %}
      </xo-animate>
      {% render 'space', value: '2rem' %}
      
      {% comment %} Mobile Carousel - Shows partial next item {% endcomment %}
      <div class='vastu-grid-carousel__mobile-carousel'>
        <xo-carousel
          xo-per-view='1'
          xo-gap='10'
          xo-speed='400'
          xo-render-bullet='<span></span>'
          class='vastu-grid-carousel__carousel'
        >
          <xo-carousel-inner>
            <xo-carousel-list role='list' aria-label='{{ 'general.slider.name' | t }}'>
              {%- for product in collection.products -%}
                {%- if forloop.index <= products_limit -%}
                <xo-carousel-slide 
                  aria-roledescription='{{ 'sections.slideshow.slide' | t }}' 
                  aria-label='{{ forloop.index }} {{ 'general.slider.of' | t }} {{ collection.products.size }}'
                  data-product-index='{{ forloop.index }}'
                >
                  {% render 'vastu-grid-card',
                    product: product,
                    section: section,
                    settings: section.settings
                  %}
                </xo-carousel-slide>
                {%- else -%}
                  <xo-carousel-slide 
                    aria-roledescription='{{ 'sections.slideshow.slide' | t }}' 
                    aria-label='{{ forloop.index }} {{ 'general.slider.of' | t }} {{ collection.products.size }}'
                    data-product-index='{{ forloop.index }}'
                    class='vastu-grid-carousel__slide--hidden'
                  >
                    {% render 'vastu-grid-card',
                      product: product,
                      section: section,
                      settings: section.settings
                    %}
                  </xo-carousel-slide>
                {%- endif -%}
              {%- endfor -%}
            </xo-carousel-list>
          </xo-carousel-inner>
          {% render 'vastu-carousel-controls',
            show_navigation: section.settings.show_navigation_mobile,
            show_pagination: section.settings.show_pagination_mobile,
            navigation_desktop: 'none',
            navigation_mobile: section.settings.show_navigation_mobile | default: true | ternary: 'flex', 'none',
            pagination_desktop: 'none',
            pagination_mobile: section.settings.show_pagination_mobile | default: true | ternary: 'block', 'none',
            pagination_position: section.settings.pagination_position_mobile | default: 'bottom',
            pagination_offset: section.settings.pagination_offset_mobile | default: '-2.5rem'
          %}
        </xo-carousel>
        {%- if has_more_products -%}
          <div class='vastu-grid-carousel__view-more-wrapper'>
            <button 
              type='button'
              class='vastu-grid-carousel__view-more-btn'
              data-section-id='{{ section.id }}'
              data-current-limit='{{ products_limit }}'
              data-increment='{{ view_more_limit }}'
              data-total-products='{{ total_products }}'
              data-layout='mobile'
            >
              {{ section.settings.view_more_text | default: 'View More' }}
            </button>
          </div>
        {%- endif -%}
      </div>
      
      {% comment %} Desktop Carousel {% endcomment %}
      <div class='vastu-grid-carousel__desktop-carousel'>
        <xo-carousel
          xo-per-view='{{ columns_desktop }}'
          xo-gap='20'
          xo-speed='400'
          xo-breakpoints='{"768": {"perView": 2}, "992": {"perView": {{ columns_desktop }}}}'
          xo-render-bullet='<span></span>'
          class='vastu-grid-carousel__carousel'
        >
          <xo-carousel-inner>
            <xo-carousel-list role='list' aria-label='{{ 'general.slider.name' | t }}'>
              {%- for product in collection.products -%}
                <xo-carousel-slide 
                  aria-roledescription='{{ 'sections.slideshow.slide' | t }}' 
                  aria-label='{{ forloop.index }} {{ 'general.slider.of' | t }} {{ collection.products.size }}'
                  data-product-index='{{ forloop.index }}'
                >
                  {% render 'vastu-grid-card',
                    product: product,
                    section: section,
                    settings: section.settings
                  %}
                </xo-carousel-slide>
              {%- endfor -%}
            </xo-carousel-list>
          </xo-carousel-inner>
          {%- liquid
            if section.settings.show_navigation
              assign nav_desktop = 'flex'
            else
              assign nav_desktop = 'none'
            endif
            if section.settings.show_pagination
              assign pag_desktop = 'block'
            else
              assign pag_desktop = 'none'
            endif
          -%}
          {% render 'vastu-carousel-controls',
            show_navigation: section.settings.show_navigation,
            show_pagination: section.settings.show_pagination,
            navigation_desktop: nav_desktop,
            navigation_mobile: 'none',
            pagination_desktop: pag_desktop,
            pagination_mobile: 'none',
            pagination_position: section.settings.pagination_position_desktop,
            pagination_offset: section.settings.pagination_offset_desktop,
            pagination_class: 'vastu-grid-carousel__pagination'
          %}
        </xo-carousel>
      </div>
    </xo-container>
  {% endif %}
  
  {% endunless %}
</div>

<script>
  (function() {
    function initViewMore() {
      document.querySelectorAll('.vastu-grid-carousel__view-more-btn').forEach(function(btn) {
        if (btn.dataset.initialized) return;
        btn.dataset.initialized = 'true';
        
        btn.addEventListener('click', function() {
          const sectionId = this.dataset.sectionId;
          const currentLimit = parseInt(this.dataset.currentLimit) || 4;
          const increment = parseInt(this.dataset.increment) || 4;
          const totalProducts = parseInt(this.dataset.totalProducts) || 0;
          const newLimit = Math.min(currentLimit + increment, totalProducts);
          
          // Find the mobile carousel container
          const section = document.querySelector(`[data-section-id="${sectionId}"]`);
          if (!section) return;
          
          const carouselContainer = section.querySelector('.vastu-grid-carousel__mobile-carousel');
          if (!carouselContainer) return;
          
          // Find all hidden slides
          const hiddenSlides = carouselContainer.querySelectorAll('.vastu-grid-carousel__slide--hidden');
          const itemsToShow = Math.min(hiddenSlides.length, increment);
          
          // Show the hidden slides
          for (let i = 0; i < itemsToShow; i++) {
            hiddenSlides[i]?.classList.remove('vastu-grid-carousel__slide--hidden');
          }
          
          // Update button state
          this.dataset.currentLimit = newLimit.toString();
          
          // Check if there are more products to show
          const remainingHidden = carouselContainer.querySelectorAll('.vastu-grid-carousel__slide--hidden').length;
          const hasMoreProducts = remainingHidden > 0 && newLimit < totalProducts;
          
          if (!hasMoreProducts) {
            // Hide the button and wrapper when no more products
            this.style.display = 'none';
            const wrapper = this.closest('.vastu-grid-carousel__view-more-wrapper');
            if (wrapper) {
              wrapper.style.display = 'none';
              wrapper.classList.add('vastu-grid-carousel__view-more-wrapper--hidden');
            }
          }
          
          // Update carousel if it exists
          const carousel = carouselContainer.querySelector('.vastu-grid-carousel__carousel');
          if (carousel) {
            setTimeout(function() {
              if (carousel.xoCarousel && typeof carousel.xoCarousel.update === 'function') {
                carousel.xoCarousel.update();
              } else if (typeof carousel.update === 'function') {
                carousel.update();
              }
            }, 100);
          }
        });
      });
    }
    
    // Check if button should be hidden on page load (if all products are already shown)
    function checkInitialButtonState() {
      document.querySelectorAll('.vastu-grid-carousel__view-more-btn').forEach(function(btn) {
        const sectionId = btn.dataset.sectionId;
        const currentLimit = parseInt(btn.dataset.currentLimit) || 4;
        const totalProducts = parseInt(btn.dataset.totalProducts) || 0;
        
        if (currentLimit >= totalProducts) {
          btn.style.display = 'none';
          const wrapper = btn.closest('.vastu-grid-carousel__view-more-wrapper');
          if (wrapper) {
            wrapper.style.display = 'none';
            wrapper.classList.add('vastu-grid-carousel__view-more-wrapper--hidden');
          }
        } else {
          // Check if there are actually hidden slides in mobile carousel
          const section = document.querySelector(`[data-section-id="${sectionId}"]`);
          if (section) {
            const carouselContainer = section.querySelector('.vastu-grid-carousel__mobile-carousel');
            
            if (carouselContainer) {
              const hiddenSlides = carouselContainer.querySelectorAll('.vastu-grid-carousel__slide--hidden');
              if (hiddenSlides.length === 0) {
                btn.style.display = 'none';
                const wrapper = btn.closest('.vastu-grid-carousel__view-more-wrapper');
                if (wrapper) {
                  wrapper.style.display = 'none';
                  wrapper.classList.add('vastu-grid-carousel__view-more-wrapper--hidden');
                }
              }
            }
          }
        }
      });
    }
    
    // Wait for carousel to be initialized
    function waitForCarousel() {
      if (typeof customElements !== 'undefined' && customElements.get('xo-carousel')) {
        initViewMore();
        checkInitialButtonState();
      } else {
        setTimeout(waitForCarousel, 100);
      }
    }
    
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
          initViewMore();
          checkInitialButtonState();
        waitForCarousel();
        }, 500);
      });
    } else {
      setTimeout(function() {
        initViewMore();
        checkInitialButtonState();
      waitForCarousel();
      }, 500);
    }
  })();
</script>

{% schema %}
{
  "name": "Vastu Grid Carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading_title",
      "label": "Heading Title",
      "default": "Featured Products"
    },
    {
      "type": "textarea",
      "id": "heading_description",
      "label": "Heading Description"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 4,
      "label": "Initial Products to Show"
    },
    {
      "type": "range",
      "id": "view_more_limit",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "Products to Load on View More"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Desktop Columns"
    },
    {
      "type": "text",
      "id": "view_more_text",
      "label": "View More Button Text",
      "default": "View More"
    },
    {
      "type": "header",
      "content": "Carousel Controls - Desktop"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show Navigation Arrows (Desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show Pagination Dots (Desktop)",
      "default": true
    },
    {
      "type": "select",
      "id": "pagination_position_desktop",
      "label": "Pagination Position (Desktop)",
      "default": "bottom",
      "options": [
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "text",
      "id": "pagination_offset_desktop",
      "label": "Pagination Offset (Desktop)",
      "default": "-2.5rem",
      "info": "Distance from position (e.g., '-2.5rem', '20px')"
    },
    {
      "type": "header",
      "content": "Carousel Controls - Mobile"
    },
    {
      "type": "checkbox",
      "id": "show_navigation_mobile",
      "label": "Show Navigation Arrows (Mobile)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_pagination_mobile",
      "label": "Show Pagination Dots (Mobile)",
      "default": true
    },
    {
      "type": "select",
      "id": "pagination_position_mobile",
      "label": "Pagination Position (Mobile)",
      "default": "bottom",
      "options": [
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "text",
      "id": "pagination_offset_mobile",
      "label": "Pagination Offset (Mobile)",
      "default": "-2.5rem",
      "info": "Distance from position (e.g., '-2.5rem', '20px')"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Container Width",
      "default": "fullwidth",
      "options": [
        {
          "value": "box",
