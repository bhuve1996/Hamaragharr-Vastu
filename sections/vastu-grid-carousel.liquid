        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "fullwidth",
          "label": "Full Width"
        }
      ]
    },
    {
      "type": "number",
      "id": "fullwidth_margin",
      "label": "Full Width Margin (Desktop)",
