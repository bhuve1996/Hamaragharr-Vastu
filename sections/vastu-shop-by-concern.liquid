{{ 'vastu-grid-carousel.css' | asset_url | stylesheet_tag }}


<section {% render 'section-attr' %}>
  {% render 'section-bg-image' %}
  <xo-container {% render 'section-layout' %}>
    {% if section.settings.title != blank %}
      <xo-animate xo-cascade>
        {% render 'homepage-heading', title: section.settings.title, section: section, class: 'vastu-shop-by-concern__section-title' %}
      </xo-animate>
    {% endif %}
    
    <xo-collapse-provider xo-duration='300' class='vastu-shop-by-concern__accordion' xo-default-open='0'>
      {% for block in section.blocks %}
        {% if block.type == 'concern' %}
        <xo-animate xo-cascade class='vastu-shop-by-concern__item' {{ block.shopify_attributes }}>
          {% if block.settings.concern_title != blank or block.settings.concern_question != blank %}
            <xo-collapse-trigger class='vastu-shop-by-concern__trigger'>
              <div class='vastu-shop-by-concern__trigger-content'>
                {% if block.settings.concern_title != blank %}
                  <h3 class='vastu-shop-by-concern__trigger-title'>{{ block.settings.concern_title }}</h3>
                {% endif %}
                {% if block.settings.concern_question != blank %}
                  <p class='vastu-shop-by-concern__trigger-question'>{{ block.settings.concern_question }}</p>
                {% endif %}
              </div>
              <div class='vastu-shop-by-concern__trigger-icon'>
                {%- render 'icon', name: 'plus2', icon_size: '20', color: '#473855' -%}
              </div>
            </xo-collapse-trigger>
          {% endif %}
          
          <xo-collapse class='vastu-shop-by-concern__collapse'>
            <div class='vastu-shop-by-concern__content'>
              {% if block.settings.concern_description != blank %}
                <div class='vastu-shop-by-concern__card-description'>{{ block.settings.concern_description }}</div>
              {% endif %}
              
              {% if block.settings.benefits_title != blank %}
                <h4 class='vastu-shop-by-concern__benefits-title'>{{ block.settings.benefits_title }}</h4>
              {% endif %}
              
              {% if block.settings.benefits_list != blank %}
                <ul class='vastu-shop-by-concern__benefits-list'>
                  {% assign benefits = block.settings.benefits_list | split: '|' %}
                  {% for benefit in benefits %}
                    <li>{{ benefit | strip }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
              
              {% comment %} Products: from selected collection {% endcomment %}
              {% assign has_products = false %}
              {% if block.settings.carousel_collection != blank and block.settings.carousel_collection.products.size > 0 %}
                {% assign has_products = true %}
              {% endif %}
              
              {% if has_products %}
                {% liquid
                  if section.settings.show_pagination_desktop != blank
                    assign show_pagination_desktop = section.settings.show_pagination_desktop
                  elsif settings.carousel_show_pagination_desktop != blank
                    assign show_pagination_desktop = settings.carousel_show_pagination_desktop
                  else
                    assign show_pagination_desktop = true
                  endif
                  if section.settings.show_pagination_mobile != blank
                    assign show_pagination_mobile = section.settings.show_pagination_mobile
                  elsif settings.carousel_show_pagination_mobile != blank
                    assign show_pagination_mobile = settings.carousel_show_pagination_mobile
                  else
                    assign show_pagination_mobile = true
                  endif
                  if show_pagination_desktop
                    assign pagination_desktop_display = 'block'
                  else
                    assign pagination_desktop_display = 'none'
                  endif
                  if show_pagination_mobile
                    assign pagination_mobile_display = 'block'
                  else
                    assign pagination_mobile_display = 'none'
                  endif
                %}
                <div class='vastu-shop-by-concern__products-carousel'>
                  {% comment %} Mobile: grid (2 columns) {% endcomment %}
                  <div class='vastu-grid-carousel__mobile-grid'>
                    <xo-grid class='vastu-grid-carousel__grid' style='--xs: 2; --sm: 2; --md: 2; --lg: 2; --xo-grid-col-gap: 20px; --xo-grid-row-gap: 20px;'>
                      {% assign carousel_limit = block.settings.carousel_collection_limit | default: 12 %}
                      {% for current_product in block.settings.carousel_collection.products limit: carousel_limit %}
                        <div class='vastu-grid-carousel__grid-item'>
                          {% render 'vastu-grid-card', product: current_product, section: section, settings: section.settings %}
                        </div>
                      {% endfor %}
                    </xo-grid>
                  </div>
                  {% comment %} Desktop: carousel (3 per view) {% endcomment %}
                  <div class='vastu-grid-carousel__desktop-carousel'>
                    <xo-carousel
                      xo-per-view='3'
                      xo-gap='20'
                      xo-speed='400'
                      xo-autoplay='5000'
                      xo-hover-pause
                      xo-breakpoints='{"768": {"perView": 2}, "992": {"perView": 3}}'
                      xo-render-bullet='<span></span>'
                      class='vastu-grid-carousel__carousel'
                    >
                      <xo-carousel-inner>
                        <xo-carousel-list role='list' aria-label='Products for {{ block.settings.concern_title }}'>
                          {% for current_product in block.settings.carousel_collection.products limit: carousel_limit %}
                            <xo-carousel-slide aria-roledescription='{{ 'sections.slideshow.slide' | t }}' aria-label='{{ forloop.index }} {{ 'general.slider.of' | t }} {{ block.settings.carousel_collection.products.size }}'>
                              {% render 'vastu-grid-card', product: current_product, section: section, settings: section.settings %}
                            </xo-carousel-slide>
                          {% endfor %}
                        </xo-carousel-list>
                      </xo-carousel-inner>
                      {% if show_pagination_desktop or show_pagination_mobile %}
                        {% render 'vastu-carousel-controls',
                          show_navigation: false,
                          show_pagination: true,
                          navigation_desktop: 'none',
                          navigation_mobile: 'none',
                          pagination_desktop: pagination_desktop_display,
                          pagination_mobile: pagination_mobile_display,
                          pagination_position: 'bottom',
                          pagination_offset: '1rem'
                        %}
                      {% endif %}
                    </xo-carousel>
                  </div>
                </div>
              {% endif %}
            </div>
          </xo-collapse>
        </xo-animate>
        {% endif %}
      {% endfor %}
    </xo-collapse-provider>
  </xo-container>
  
  {% render 'section-separator',
    enable_separator: section.settings.enable_separator,
    separator_color: section.settings.separator_color,
    separator_height: section.settings.separator_height,
    separator_width: section.settings.separator_width,
    padding_top: section.settings.separator_padding_top,
    padding_bottom: section.settings.separator_padding_bottom
  %}
</section>

{% schema %}
{
  "name": "Vastu Shop by Concern",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.all.width.label",
      "default": "wide",
      "options": [
        {
          "value": "box",
          "label": "t:sections.all.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.width.options__2.label"
        },
        {
          "value": "fullwidth",
          "label": "t:sections.all.width.options__3.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content Width (when section is fullwidth)",
      "default": "wide",
      "options": [
        {
          "value": "box",
          "label": "t:sections.all.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.width.options__2.label"
        }
      ],
      "info": "Controls the width of inner content when section width is set to fullwidth"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop by Concern"
    },
    {
      "type": "header",
      "content": "Heading Styling"
    },
    {
      "type": "header",
      "content": "Heading Style (Overrides Global Settings)"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 0,
      "max": 6,
      "step": 0.1,
      "unit": "rem",
      "label": "Font Size",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "title_font_weight",
      "min": 0,
      "max": 900,
      "step": 100,
      "label": "Font Weight",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Text Color",
      "info": "Leave empty to use global setting"
    },
    {
      "type": "select",
      "id": "title_text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "",
          "label": "Use Global Setting"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "title_line_height",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "label": "Line Height",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "checkbox",
      "id": "title_enable_animation",
      "label": "Enable Heading Animation",
      "info": "Leave unchecked to use global setting"
    },
    {
      "type": "range",
      "id": "title_margin_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting (16px)"
    },
    {
      "type": "range",
      "id": "title_margin_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting (12px)"
    },
    {
      "type": "checkbox",
      "id": "title_enable_underline",
      "label": "Enable Underline",
      "info": "Leave unchecked to use global setting"
    },
    {
      "type": "color",
      "id": "title_underline_color",
      "label": "Underline Color",
      "info": "Leave empty to use global setting"
    },
    {
      "type": "range",
      "id": "title_underline_width",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Underline Width",
      "default": 0,
      "info": "Set to 0 to use global setting (80px)"
    },
    {
      "type": "range",
      "id": "title_underline_height",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Underline Height",
      "default": 0,
      "info": "Set to 0 to use global setting (4px)"
    },
    {
      "type": "range",
      "id": "title_underline_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Underline Bottom Position (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting (8px)"
    },
    {
      "type": "range",
      "id": "title_underline_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Underline Bottom Position (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting (6px)"
    },
    {
      "type": "header",
      "content": "t:sections.all.heading.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "t:sections.all.background_type.label",
      "options": [
        {
          "value": "color",
          "label": "t:sections.all.background_type.option__1.label"
        }
      ],
      "default": "color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.all.background_color.label",
      "alpha": true,
      "visible_if": "{{ section.settings.background_type == 'color' }}"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "default": 80
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "default": 80
    },
    {
      "type": "header",
      "content": "Section Separator"
    },
    {
      "type": "checkbox",
      "id": "enable_separator",
      "label": "Enable Separator",
      "default": false
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "separator_height",
      "min": 1,
      "max": 11,
      "step": 2,
      "unit": "px",
      "label": "Separator Height",
      "default": 1
    },
    {
      "type": "range",
      "id": "separator_width",
      "min": 5,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Separator Width",
      "default": 10
    },
    {
      "type": "number",
      "id": "separator_padding_top",
      "label": "Separator Padding Top",
      "default": 0
    },
    {
      "type": "number",
      "id": "separator_padding_bottom",
      "label": "Separator Padding Bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Product Carousel Settings"
    },
    {
      "type": "text",
      "id": "button_text_add_to_cart",
      "label": "Add to Cart Button Text",
      "default": "Add to Cart"
    },
    {
      "type": "range",
      "id": "card_title_font_size",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "unit": "rem",
      "label": "Product Card Title Font Size",
      "default": 1.5
    },
    {
      "type": "range",
      "id": "card_price_font_size",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "unit": "rem",
      "label": "Product Card Price Font Size",
      "default": 1.2
    },
    {
      "type": "header",
      "content": "Carousel Pagination (Overrides Global Settings)"
    },
    {
      "type": "paragraph",
      "content": "Leave unchecked to use global carousel pagination settings"
    },
    {
      "type": "checkbox",
      "id": "show_pagination_desktop",
      "label": "Show Pagination Dots (Desktop)",
      "info": "Leave unchecked to use global setting"
    },
    {
      "type": "checkbox",
      "id": "show_pagination_mobile",
      "label": "Show Pagination Dots (Mobile)",
      "info": "Leave unchecked to use global setting"
    }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Concern Card",
      "settings": [
        {
          "type": "text",
          "id": "concern_title",
          "label": "Concern Title",
          "default": "Money & Financial Blockages"
        },
        {
          "type": "text",
          "id": "concern_question",
          "label": "Question/Heading",
          "default": "Facing Money Problems or Financial Instability at Home?"
        },
        {
          "type": "richtext",
          "id": "concern_description",
          "label": "Description",
          "default": "<p>Despite hard work, if money doesn't stay, expenses rise unexpectedly, or income feels blocked — your home's energy may be out of balance.</p><p>According to Vastu, improper energy flow can block wealth and opportunities. Our carefully selected remedies help activate prosperity zones and support financial stability.</p>"
        },
        {
          "type": "text",
          "id": "benefits_title",
          "label": "Benefits Section Title",
          "default": "How These Remedies Help"
        },
        {
          "type": "textarea",
          "id": "benefits_list",
          "label": "Benefits List (separate with |)",
          "default": "✔ Improve cash flow & savings|✔ Reduce financial stress|✔ Activate wealth-attracting energy|✔ Support business & career growth",
          "info": "Separate each benefit with a pipe character (|)"
        },
        {
          "type": "header",
          "content": "Products"
        },
        {
          "type": "collection",
          "id": "carousel_collection",
          "label": "Collection",
          "info": "Products from this collection appear in the carousel."
        },
        {
          "type": "range",
          "id": "carousel_collection_limit",
          "min": 2,
          "max": 24,
          "step": 1,
          "default": 12,
          "label": "Max products from collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vastu Shop by Concern"
    }
  ]
}
{% endschema %}

