{% comment %}
  Renders a section showing the importance of Vastu Kit
  Displays 5 key benefits with icons
{% endcomment %}

<section {% render 'section-attr' %} class='vastu-why-kit'>
  {% render 'section-bg-image' %}
  <xo-container {% render 'section-layout' %}>
    {% if section.settings.title != blank %}
      {% render 'homepage-heading', title: section.settings.title, section: section, class: 'vastu-why-kit__title' %}
    {% endif %}
    
    <xo-grid class='vastu-why-kit__grid' style='--xs: 5; --sm: 5; --md: 3; --lg: 5; --xl: 5; --xxl: 5; --xo-grid-col-gap: {{ section.settings.gap }}px; --xo-grid-row-gap: {{ section.settings.gap }}px;'>
      {% for block in section.blocks %}
        <xo-animate xo-cascade class='vastu-why-kit__item' {{ block.shopify_attributes }}>
          <div class='vastu-why-kit__icon'>
            {% if block.settings.icon_svg != blank %}
              {{ block.settings.icon_svg }}
            {% elsif block.settings.icon_image != blank %}
              {% render 'image', image: block.settings.icon_image %}
            {% endif %}
          </div>
          {% if block.settings.text != blank %}
            <span class='vastu-why-kit__text'>{{ block.settings.text }}</span>
          {% endif %}
        </xo-animate>
      {% endfor %}
    </xo-grid>
  </xo-container>
  {% render 'section-separator',
    enable_separator: section.settings.enable_separator,
    separator_color: section.settings.separator_color,
    separator_height: section.settings.separator_height,
    separator_width: section.settings.separator_width,
    padding_top: section.settings.separator_padding_top,
    padding_bottom: section.settings.separator_padding_bottom
  %}
</section>

{% schema %}
