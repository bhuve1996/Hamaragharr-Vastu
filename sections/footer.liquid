
{% comment %} Add padding bottom for toolbar mobile {% endcomment %}
{% liquid
  assign placeholder = 'newsletter.email' | t
  assign template = template | split: '.' | first
  if template != 'product'
    assign pb_mobile = '--pb-mobile: 53px'
  else
    assign pb_mobile = ''
  endif
%}

{% comment %} Sticky add cart is hidden when reach here {% endcomment %}
<xo-sticky-hidden xo-name='sticky-addcart'></xo-sticky-hidden>
<footer {% render 'section-attr', style: pb_mobile %} class='footer-modern'>
  {% render 'section-bg-image' %}
  
  {% comment %} Main Footer Content - 3 Column Layout {% endcomment %}
  <xo-container {% render 'section-layout' %}>
    <xo-grid style='--xs: 1; --sm: 2; --lg: 3' class='footer-modern__columns'>
      
      {% comment %} Column 1 - Information {% endcomment %}
      <div class='footer-modern__column'>
        <xo-animate xo-cascade>
          <h4 class='footer-modern__heading'>{{ section.settings.info_heading | default: 'Information' }}</h4>
          {%- if section.settings.info_menu != blank -%}
            <ul role='list' class='footer-modern__list list-unstyled'>
              {%- for link in section.settings.info_menu.links -%}
                <li class='footer-modern__list-item'>
                  <a href='{{ link.url }}' class='footer-modern__link'>
                    {{ link.title | escape }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <ul role='list' class='footer-modern__list list-unstyled'>
              {%- if section.settings.info_privacy_enable != false -%}
                <li class='footer-modern__list-item'>
                  <a href='{{ section.settings.info_privacy_link | default: "/pages/privacy-policy" }}' class='footer-modern__link'>{{ section.settings.info_privacy_text | default: 'Privacy Policy' }}</a>
                </li>
              {%- endif -%}
              {%- if section.settings.info_terms_enable != false -%}
                <li class='footer-modern__list-item'>
                  <a href='{{ section.settings.info_terms_link | default: "/pages/terms-conditions" }}' class='footer-modern__link'>{{ section.settings.info_terms_text | default: 'Terms & Conditions' }}</a>
                </li>
              {%- endif -%}
              {%- if section.settings.info_return_enable != false -%}
                <li class='footer-modern__list-item'>
                  <a href='{{ section.settings.info_return_link | default: "/pages/return-refund-policy" }}' class='footer-modern__link'>{{ section.settings.info_return_text | default: 'Return & Refund Policy' }}</a>
                </li>
              {%- endif -%}
              {%- if section.settings.info_blog_enable != false -%}
                <li class='footer-modern__list-item'>
                  <a href='{{ section.settings.info_blog_link | default: "/pages/blogs" }}' class='footer-modern__link'>{{ section.settings.info_blog_text | default: 'Blog' }}</a>
                </li>
              {%- endif -%}
              {%- if section.settings.amazon_link != blank -%}
                <li class='footer-modern__list-item'>
                  <a href='{{ section.settings.amazon_link }}' class='footer-modern__link' {% if section.settings.amazon_link != blank %}target='_blank'{% endif %}>{{ section.settings.amazon_link_text | default: 'Shop on Amazon' }}</a>
                </li>
              {%- endif -%}
            </ul>
          {%- endif -%}
        </xo-animate>
      </div>

      {% comment %} Column 2 - Customer Support {% endcomment %}
      <div class='footer-modern__column'>
        <xo-animate xo-cascade>
          <h4 class='footer-modern__heading'>{{ section.settings.support_heading | default: 'Customer Support' }}</h4>
          {%- if section.settings.support_menu != blank -%}
            <ul role='list' class='footer-modern__list list-unstyled'>
              {%- for link in section.settings.support_menu.links -%}
                <li class='footer-modern__list-item'>
                  <a href='{{ link.url }}' class='footer-modern__link'>
                    {{ link.title | escape }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <ul role='list' class='footer-modern__list list-unstyled'>
              {%- if section.settings.support_faq_enable != false -%}
                <li class='footer-modern__list-item'>
                  <a href='{{ section.settings.support_faq_link | default: "/pages/faq" }}' class='footer-modern__link'>{{ section.settings.support_faq_text | default: 'FAQ' }}</a>
                </li>
              {%- endif -%}
              {%- if section.settings.support_contact_enable != false -%}
                <li class='footer-modern__list-item'>
                  <a href='{{ section.settings.support_contact_link | default: "/pages/contact-us-1" }}' class='footer-modern__link'>{{ section.settings.support_contact_text | default: 'Contact Us' }}</a>
                </li>
              {%- endif -%}
              {%- if section.settings.payment_link != blank -%}
                <li class='footer-modern__list-item'>
                  <a href='{{ section.settings.payment_link }}' class='footer-modern__link' {% if section.settings.payment_link != blank %}target='_blank'{% endif %}>{{ section.settings.payment_link_text | default: 'Payment Link' }}</a>
                </li>
              {%- endif -%}
            </ul>
          {%- endif -%}
        </xo-animate>
      </div>

      {% comment %} Column 3 - Newsletter Subscription {% endcomment %}
      <div class='footer-modern__column footer-modern__column--newsletter'>
        <xo-animate xo-cascade>
        {%- if section.settings.newsletter_enable -%}
            <h4 class='footer-modern__heading'>{{ section.settings.newsletter_heading | default: 'Subscribe to our emails' }}</h4>
            {%- if section.settings.newsletter_description != blank -%}
              <p class='footer-modern__newsletter-description'>{{ section.settings.newsletter_description }}</p>
            {%- endif -%}
            {%- form 'customer', id: 'ContactFooter' -%}
              <input type='hidden' name='contact[tags]' value='newsletter'>
              <div class='footer-modern__newsletter-form'>
                {% assign value = form.email %}
                {% capture attr %}
                      aria-required='true'
                      autocorrect='off'
                      {% if form.errors %}
                        autofocus
                        aria-invalid='true'
                        aria-describedby='ContactFooter-error'
                      {% elsif form.posted_successfully? %}
                        aria-describedby='ContactFooter-success'
                      {% endif %}
                      required
                    {% endcapture %}
                <input
                  type='email'
                  name='contact[email]'
                  value='{{ value }}'
                  placeholder='{{ placeholder | default: "Email" }}'
                  class='footer-modern__newsletter-input'
                  {{ attr }}
                >
                <button
                  type='submit'
                  class='footer-modern__newsletter-button'
                  name='commit'
                  id='Subscribe'
                  aria-label='{{ "newsletter.button_label" | t }}'
                  {% if section.settings.newsletter_button_font_size != blank %}style='font-size: {{ section.settings.newsletter_button_font_size }}rem;'{% endif %}
                >
                  {{ section.settings.newsletter_button_text | default: 'Sign Up' }}
                </button>
              </div>
              {% render 'newsletter-form-message', form: form %}
            {%- endform -%}
          {%- endif -%}
        </xo-animate>
      </div>

    </xo-grid>
  </xo-container>

  {% comment %} Bottom Section - Social Media & Payment Icons {% endcomment %}
  <div class='footer-modern__bottom'>
    <xo-container>
      {% comment %} First Row: Social Media & Payment Icons {% endcomment %}
      <div class='footer-modern__bottom-content'>
        
        {% comment %} Social Media Icons {% endcomment %}
        {%- liquid
          assign has_social_links = false
          if section.settings.show_social
            if section.settings.social_facebook_link != blank or section.settings.social_instagram_link != blank or section.settings.social_youtube_link != blank
              assign has_social_links = true
            endif
          endif
        -%}
        {%- if has_social_links -%}
          <div class='footer-modern__social'>
            {%- if section.settings.social_facebook_link != blank -%}
              <a href='{{ section.settings.social_facebook_link }}' target='_blank' class='footer-modern__social-link' aria-label='Facebook'>
                {% render 'icon', name: 'facebook2', icon_size: '20' %}
              </a>
            {%- endif -%}
            {%- if section.settings.social_instagram_link != blank -%}
              <a href='{{ section.settings.social_instagram_link }}' target='_blank' class='footer-modern__social-link' aria-label='Instagram'>
                {% render 'icon', name: 'instagram', icon_size: '20' %}
              </a>
            {%- endif -%}
            {%- if section.settings.social_youtube_link != blank -%}
              <a href='{{ section.settings.social_youtube_link }}' target='_blank' class='footer-modern__social-link' aria-label='YouTube'>
                {% render 'icon', name: 'youtube', icon_size: '20' %}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {% comment %} Payment Method Icons {% endcomment %}
        {%- if section.settings.show_payment_icons -%}
          <div class='footer-modern__payment'>
            {%- if section.settings.payment_visa -%}
              <span class='footer-modern__payment-icon' aria-label='Visa'>Visa</span>
            {%- endif -%}
            {%- if section.settings.payment_mastercard -%}
              <span class='footer-modern__payment-icon' aria-label='Mastercard'>Mastercard</span>
            {%- endif -%}
            {%- if section.settings.payment_gpay -%}
              <span class='footer-modern__payment-icon' aria-label='Google Pay'>GPay</span>
            {%- endif -%}
            {%- if section.settings.payment_paytm -%}
              <span class='footer-modern__payment-icon' aria-label='Paytm'>Paytm</span>
            {%- endif -%}
            {%- if section.settings.payment_upi -%}
              <span class='footer-modern__payment-icon' aria-label='UPI'>UPI</span>
            {%- endif -%}
            {%- if section.settings.payment_image != blank -%}
              <img
                src='{{ section.settings.payment_image | image_url: width: 400 }}'
                alt='Payment methods'
                class='footer-modern__payment-image'
                loading='lazy'
                width='400'
                height='auto'
              >
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>

      {% comment %} Second Row: Copyright {% endcomment %}
      {%- if section.settings.copyright != blank -%}
        <div class='footer-modern__copyright-wrapper'>
          <div class='footer-modern__copyright'>
            {{ section.settings.copyright }}
          </div>
        </div>
      {%- else -%}
        <div class='footer-modern__copyright-wrapper'>
          <div class='footer-modern__copyright'>
            <small>Copyright 2026 HamaraGharr Vastu All right reserved</small>
          </div>
        </div>
      {%- endif -%}

    </xo-container>
  </div>
</footer>

