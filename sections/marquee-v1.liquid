          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        {
          "type": "marquee_item",
          "settings": {
            "text": "Free Shipping on Orders Above ₹500"
          }
        },
        {
          "type": "marquee_item",
