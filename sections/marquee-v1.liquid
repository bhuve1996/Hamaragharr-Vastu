<div {% render 'section-attr' %}>
  {% render 'section-bg-image' %}
  {% if section.settings.width == 'fullwidth' %}
    <div class="marquee-v1__wrapper" style="--marquee-bg-color: {{ section.settings.background_color }}; --marquee-text-color: {{ section.settings.text_color }}; --marquee-gap: {{ section.settings.gap }}px; --marquee-font-size: {{ section.settings.font_size }}rem; --marquee-font-weight: {{ section.settings.font_weight }}; background-color: {{ section.settings.background_color }} !important; padding-left: {{ section.settings.fullwidth_margin }}px; padding-right: {{ section.settings.fullwidth_margin }}px;">
  {% else %}
    <xo-container {% render 'section-layout' %}>
      <div class="marquee-v1__wrapper" style="--marquee-bg-color: {{ section.settings.background_color }}; --marquee-text-color: {{ section.settings.text_color }}; --marquee-gap: {{ section.settings.gap }}px; --marquee-font-size: {{ section.settings.font_size }}rem; --marquee-font-weight: {{ section.settings.font_weight }}; background-color: {{ section.settings.background_color }} !important;">
  {% endif %}
      <div class="marquee-v1__container">
        <div class="marquee-v1__track" data-direction="{{ section.settings.direction }}" data-pause-hover="{{ section.settings.pause_on_hover }}" style="--marquee-speed: {{ section.settings.speed }}s;">
        {%- for block in section.blocks -%}
          <div class="marquee-v1__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="marquee-v1__link">
            {%- endif -%}
            {%- if block.settings.icon_svg != blank -%}
              <span class="marquee-v1__icon">{{ block.settings.icon_svg }}</span>
            {%- endif -%}
            <span class="marquee-v1__text">{{ block.settings.text }}</span>
            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
        {%- comment -%} Duplicate items for seamless loop {%- endcomment -%}
        {%- for block in section.blocks -%}
          <div class="marquee-v1__item" aria-hidden="true">
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="marquee-v1__link">
            {%- endif -%}
            {%- if block.settings.icon_svg != blank -%}
              <span class="marquee-v1__icon">{{ block.settings.icon_svg }}</span>
            {%- endif -%}
            <span class="marquee-v1__text">{{ block.settings.text }}</span>
            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
        </div>
      </div>
  {% if section.settings.width != 'fullwidth' %}
    </xo-container>
  {% endif %}
</div>

{{ 'marquee-v1.min.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "s",
      "label": "Animation Speed",
      "default": 30,
      "info": "Lower values = faster animation"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll Direction",
      "options": [
        {
          "value": "left",
          "label": "Left to Right"
        },
        {
          "value": "right",
          "label": "Right to Left"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Gap between items",
      "default": 40
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "unit": "rem",
      "label": "Font Size",
      "default": 1.6
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_weight",
      "min": 400,
      "max": 700,
      "step": 100,
      "label": "Font Weight",
      "default": 500
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Section Width",
      "default": "fullwidth",
      "options": [
        {
          "value": "box",
          "label": "Box"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "fullwidth",
          "label": "Full Width"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content Width",
      "default": "wide",
      "options": [
        {
          "value": "box",
          "label": "Box"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "fullwidth",
          "label": "Full Width"
        }
      ],
      "visible_if": "{{ section.settings.width == 'fullwidth' }}"
    },
    {
      "type": "number",
      "id": "fullwidth_margin",
      "label": "Full Width Margin",
      "default": 0,
      "visible_if": "{{ section.settings.width == 'fullwidth' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause Animation on Hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Spacing (Overrides Global Settings)"
    },
    {
      "type": "paragraph",
      "content": "Set to 0 to use global settings. Leave at 0 to inherit from theme settings."
    },
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Top (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Top (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    }
  ],
  "blocks": [
    {
      "type": "marquee_item",
      "name": "Marquee Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Marquee Text"
        },
        {
          "type": "textarea",
          "id": "icon_svg",
          "label": "Icon SVG (Optional)",
          "info": "Paste SVG code here"
        },
        {
          "type": "url",
