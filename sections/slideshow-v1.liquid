{% liquid
  comment
    Section-level spacing overrides (desktop)
    Output if value is set (including 0 to explicitly override global settings)
  endcomment
  assign section_spacing_style = ''
  
  if section.settings.section_padding_top_desktop != null
    assign section_spacing_style = section_spacing_style | append: '--section-padding-top-desktop: ' | append: section.settings.section_padding_top_desktop | append: 'px; '
  endif
  if section.settings.section_padding_bottom_desktop != null
    assign section_spacing_style = section_spacing_style | append: '--section-padding-bottom-desktop: ' | append: section.settings.section_padding_bottom_desktop | append: 'px; '
  endif
  if section.settings.section_margin_top_desktop != null
    assign section_spacing_style = section_spacing_style | append: '--section-margin-top-desktop: ' | append: section.settings.section_margin_top_desktop | append: 'px; '
  endif
  if section.settings.section_margin_bottom_desktop != null
    assign section_spacing_style = section_spacing_style | append: '--section-margin-bottom-desktop: ' | append: section.settings.section_margin_bottom_desktop | append: 'px; '
  endif
  
  comment
    Section-level spacing overrides (mobile)
    Output if value is set (including 0 to explicitly override global settings)
  endcomment
  if section.settings.section_padding_top_mobile != null
    assign section_spacing_style = section_spacing_style | append: '--section-padding-top-mobile: ' | append: section.settings.section_padding_top_mobile | append: 'px; '
  endif
  if section.settings.section_padding_bottom_mobile != null
    assign section_spacing_style = section_spacing_style | append: '--section-padding-bottom-mobile: ' | append: section.settings.section_padding_bottom_mobile | append: 'px; '
  endif
  if section.settings.section_margin_top_mobile != null
    assign section_spacing_style = section_spacing_style | append: '--section-margin-top-mobile: ' | append: section.settings.section_margin_top_mobile | append: 'px; '
  endif
  if section.settings.section_margin_bottom_mobile != null
    assign section_spacing_style = section_spacing_style | append: '--section-margin-bottom-mobile: ' | append: section.settings.section_margin_bottom_mobile | append: 'px; '
  endif
%}

{% liquid
  assign section_id_class = 'vastu-section--' | append: section.id
%}

<style>
  /* Prioritize banner section loading and display */
  section[class*="homepage-carousel"],
  section[class*="homepage-carousel"] .vastu-banner-carousel {
    position: relative;
    width: 100%;
    /* Ensure banner displays immediately */
    min-height: {{ section.settings.section_height_desktop }}px;
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    /* Ensure banner loads first */
    content-visibility: auto;
    contain-intrinsic-size: auto {{ section.settings.section_height_desktop }}px;
  }
  
  .vastu-banner-carousel {
    position: relative;
    width: 100%;
    /* Ensure banner displays immediately */
    min-height: {{ section.settings.section_height_desktop }}px;
    display: block;
    visibility: visible;
    opacity: 1;
  }
  
  .vastu-banner-carousel__slide {
    position: relative;
    width: 100%;
    height: {{ section.settings.section_height_desktop }}px;
    overflow: hidden;
    /* Ensure slide displays immediately */
    display: block;
    visibility: visible;
    opacity: 1;
  }
  
  @media (max-width: 768px) {
    section[class*="homepage-carousel"],
    section[class*="homepage-carousel"] .vastu-banner-carousel,
    .vastu-banner-carousel {
      min-height: unset;
    }
    
    .vastu-banner-carousel__slide {
      height: {{ section.settings.section_height_mobile }}px;
    }
  }
  
  .vastu-banner-carousel__link {
    display: block;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    text-decoration: none;
    cursor: pointer;
  }
  
  .vastu-banner-carousel__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  
  .vastu-banner-carousel__image--desktop {
    display: block;
  }
  
  .vastu-banner-carousel__image--mobile {
    display: none;
  }
  
  @media (max-width: 768px) {
    .vastu-banner-carousel__image--desktop {
      display: none;
    }
    
    .vastu-banner-carousel__image--mobile {
      display: block;
    }
  }
  
  .vastu-banner-carousel__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
  }
  
  .vastu-banner-carousel__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background: var(--bg-overlay, transparent);
  }
  
  .vastu-banner-carousel__pagination {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    gap: 10px;
  }
</style>

<section class='{{ 'xo-section--' | append: section.id }} vastu-section-spacing {{ section_id_class }} vastu-banner-carousel'{% if section_spacing_style != blank %} style="{{ section_spacing_style }}"{% endif %} data-section-type='homepage-banner' data-load-priority='high'>
  <xo-carousel
    xo-render-bullet='<span></span>'
    xo-type='{{ section.settings.carousel_type }}'
    {% if section.settings.autoplay %}
      xo-autoplay='{{ section.settings.autoplay_speed | times: 1000 }}'
    {% endif %}
    xo-speed='{{ section.settings.changing_speed }}'
    xo-loop
    xo-hover-pause
  >
    <xo-carousel-inner>
      <xo-carousel-list role='list' aria-label='{{ 'general.slider.name' | t }}'>
        {% for block in section.blocks %}
          <xo-carousel-slide aria-roledescription='{{ 'sections.slideshow.slide' | t }}' aria-label='{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}'>
            <div class='vastu-banner-carousel__slide'>
              {%- comment -%} Background Image or Video {%- endcomment -%}
              {%- assign is_first_slide = forloop.first -%}
              {% if block.settings.background_type == 'video' and block.settings.background_video_url != blank %}
                {%- comment -%} preload='none' so browser does not request video until play; stops blue loading bar on mobile. Video still autoplays (browser loads on play). {%- endcomment -%}
                <video class='vastu-banner-carousel__video' autoplay muted loop playsinline preload='none' poster='{{ block.settings.background_image_desktop | image_url: width: 1200 }}'>
                  <source src='{{ block.settings.background_video_url }}' type='video/mp4'>
                </video>
                {% if block.settings.background_image_desktop != blank %}
                  <img 
                    src='{{ block.settings.background_image_desktop | image_url: width: 1920 }}'
                    alt='{{ block.settings.background_image_desktop.alt | escape }}'
                    class='vastu-banner-carousel__image vastu-banner-carousel__image--desktop'
                    loading='eager'
                    {% if is_first_slide %}fetchpriority='high'{% endif %}
                    width='{{ block.settings.background_image_desktop.width }}'
                    height='{{ block.settings.background_image_desktop.height }}'
                  >
                    {% endif %}
              {% elsif block.settings.background_type == 'image' %}
                {% if block.settings.background_image_desktop != blank %}
                  <img 
                    src='{{ block.settings.background_image_desktop | image_url: width: 1920 }}'
                    alt='{{ block.settings.background_image_desktop.alt | escape }}'
                    class='vastu-banner-carousel__image vastu-banner-carousel__image--desktop'
                    loading='eager'
                    {% if is_first_slide %}fetchpriority='high'{% endif %}
                    width='{{ block.settings.background_image_desktop.width }}'
                    height='{{ block.settings.background_image_desktop.height }}'
                  >
                {% endif %}
                {% if block.settings.background_image_mobile != blank %}
                  <img 
                    src='{{ block.settings.background_image_mobile | image_url: width: 768 }}'
                    alt='{{ block.settings.background_image_mobile.alt | escape }}'
                    class='vastu-banner-carousel__image vastu-banner-carousel__image--mobile'
                    loading='eager'
                    {% if is_first_slide %}fetchpriority='high'{% endif %}
                    width='{{ block.settings.background_image_mobile.width }}'
                    height='{{ block.settings.background_image_mobile.height }}'
                  >
                {% elsif block.settings.background_image_desktop != blank %}
                  <img 
                    src='{{ block.settings.background_image_desktop | image_url: width: 768 }}'
                    alt='{{ block.settings.background_image_desktop.alt | escape }}'
                    class='vastu-banner-carousel__image vastu-banner-carousel__image--mobile'
                    loading='eager'
                    {% if is_first_slide %}fetchpriority='high'{% endif %}
                    width='{{ block.settings.background_image_desktop.width }}'
                    height='{{ block.settings.background_image_desktop.height }}'
                  >
                {% endif %}
              {% endif %}
              
              {%- comment -%} Overlay {%- endcomment -%}
              {% if block.settings.background_overlay != blank %}
                <div class='vastu-banner-carousel__overlay' style='background: {{ block.settings.background_overlay }};'></div>
              {% endif %}
              
              {%- comment -%} Clickable Link {%- endcomment -%}
              {% if block.settings.button_link != blank %}
                <a href='{{ block.settings.button_link }}' class='vastu-banner-carousel__link' aria-label='{{ block.settings.title | default: "View product" | escape }}'></a>
              {% endif %}
              
              {%- comment -%} Pagination {%- endcomment -%}
              {% if section.settings.show_pagination %}
                <div class='vastu-banner-carousel__pagination'>
                      {% render 'carousel-pagination-style3', class: 'slideshow-v28__pagination' %}
                </div>
              {% endif %}
            </div>
          </xo-carousel-slide>
        {% endfor %}
      </xo-carousel-list>
    </xo-carousel-inner>
  </xo-carousel>
</section>

{% schema %}
{
  "name": "t:sections.slideshow_v1.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.all.width.label",
      "default": "wide",
      "options": [
        {
          "value": "box",
          "label": "t:sections.all.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.width.options__2.label"
        },
        {
          "value": "fullwidth",
          "label": "t:sections.all.width.options__3.label"
        }
      ]
    },
    {
      "type": "number",
      "id": "fullwidth_margin",
      "label": "t:sections.all.fullwidth_margin.label",
      "default": 0,
      "visible_if": "{{ section.settings.width == 'fullwidth' }}"
    },
    {
      "type": "number",
      "id": "section_height_desktop",
      "label": "t:sections.slideshow_v1.settings.section_height_desktop.label",
      "default": 600
    },
    {
      "type": "number",
      "id": "section_height_mobile",
      "label": "t:sections.slideshow_v1.settings.section_height_mobile.label",
      "default": 300
    },
    {
      "type": "header",
      "content": "Content Width Settings"
    },
    {
      "type": "range",
      "id": "content_width_columns",
      "label": "Content Width (Desktop Grid Columns)",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 6,
      "info": "Number of grid columns the content container should span on desktop (out of 12 columns)"
    },
    {
      "type": "header",
      "content": "t:sections.slideshow_v1.settings.carousel_heading.content"
    },
    {
      "type": "select",
      "id": "carousel_type",
      "label": "t:sections.all.carousel_type.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.carousel_type.option__0.label"
        },
        {
          "value": "slide",
          "label": "t:sections.all.carousel_type.option__1.label"
        },
        {
          "value": "fade",
          "label": "t:sections.all.carousel_type.option__2.label"
        },
        {
          "value": "nature",
          "label": "t:sections.all.carousel_type.option__3.label"
        },
        {
          "value": "water",
          "label": "t:sections.all.carousel_type.option__4.label"
        },
        {
          "value": "urban",
          "label": "t:sections.all.carousel_type.option__5.label"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "changing_speed",
      "min": 200,
      "max": 1000,
      "step": 100,
      "unit": "ms",
      "label": "t:sections.slideshow_v1.settings.changing_speed.label",
      "default": 400
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.slideshow_v1.settings.autoplay.label",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 5,
      "max": 20,
      "step": 5,
      "unit": "s",
      "label": "t:sections.slideshow_v1.settings.autoplay_speed.label",
      "default": 5,
      "visible_if": "{{ section.settings.autoplay == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "t:sections.slideshow_v1.settings.show_pagination.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.slideshow_v1.settings.slideshow_heading.content"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "t:sections.slideshow_v1.settings.padding_top.label",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "t:sections.slideshow_v1.settings.padding_bottom.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section Spacing (Overrides Global Settings)"
    },
    {
      "type": "paragraph",
      "content": "Set to 0 to use global settings. Leave at 0 to inherit from theme settings."
    },
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Top (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Desktop)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Top (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Mobile)",
      "default": 0,
      "info": "Set to 0 to use global setting"
    }
  ],
  "blocks": [
    {
      "type": "slideshow",
      "name": "t:sections.slideshow_v1.blocks.name",
      "settings": [
        {
          "type": "header",
          "content": "Background Settings"
        },
        {
          "type": "select",
          "id": "background_type",
          "label": "t:sections.all.background_type.label",
          "options": [
            {
              "value": "color",
              "label": "t:sections.all.background_type.option__1.label"
            },
            {
              "value": "gradient",
              "label": "t:sections.all.background_type.option__2.label"
            },
            {
              "value": "image",
              "label": "t:sections.all.background_type.option__3.label"
            },
            {
              "value": "video",
              "label": "t:sections.all.background_type.option__4.label"
            }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "background_image_desktop",
          "label": "t:sections.all.background_image_desktop.label",
          "visible_if": "{{ block.settings.background_type == 'image' or block.settings.background_type == 'video' }}"
        },
        {
          "type": "image_picker",
          "id": "background_image_mobile",
          "label": "t:sections.all.background_image_mobile.label",
          "visible_if": "{{ block.settings.background_type == 'image' or block.settings.background_type == 'video' }}"
        },
        {
          "type": "textarea",
          "id": "background_video_url",
          "label": "t:sections.all.background_video_url.label",
          "visible_if": "{{ block.settings.background_type == 'video' }}"
        },
        {
          "type": "color",
          "id": "background_overlay",
          "label": "t:sections.all.background_overlay.label",
          "alpha": true,
          "visible_if": "{{ block.settings.background_type == 'image' or block.settings.background_type == 'video' }}"
        },
        {
          "type": "header",
          "content": "Link Settings"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.all.button_link.label",
          "default": "/collections/all",
          "info": "Link for the entire slide"
        },
        {
          "type": "header",
          "content": "t:sections.all.heading.content"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.color_scheme.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.slideshow_v1.presets.name",
      "blocks": [
        {
          "type": "slideshow",
          "settings": {
            "background_type": "image",
            "button_link": "/collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
