{% comment %}
  Featured collection: grid on mobile, carousel on desktop (same pattern as vastu-grid-carousel).
{% endcomment %}
{{ 'vastu-grid-carousel.min.css' | asset_url | stylesheet_tag }}

{% liquid
  assign product_source = section.settings.product_source | default: 'collection'
  if product_source == 'blocks'
    assign has_products = false
    assign products_from_blocks_count = 0
    for block in section.blocks
      if block.type == 'product' and block.settings.product != blank
        assign has_products = true
        assign products_from_blocks_count = products_from_blocks_count | plus: 1
      endif
    endfor
    if products_from_blocks_count > section.settings.limit
      assign total_products_shown = section.settings.limit
    else
      assign total_products_shown = products_from_blocks_count
    endif
  else
    if section.settings.collection != blank and section.settings.collection.products.size > 0
      assign has_products = true
    else
      assign has_products = false
    endif
  endif
  if section.settings.show_navigation
    assign display_navigation_desktop = 'flex'
  else
    assign display_navigation_desktop = 'none'
  endif
  if section.settings.show_navigation_mobile
    assign display_navigation_mobile = 'flex'
  else
    assign display_navigation_mobile = 'none'
  endif
  if section.settings.show_pagination != blank
    assign show_pagination_desktop = section.settings.show_pagination
  else
    assign show_pagination_desktop = true
  endif
  if section.settings.show_pagination_mobile != blank
    assign show_pagination_mobile = section.settings.show_pagination_mobile
  else
    assign show_pagination_mobile = true
  endif
  if show_pagination_desktop
    assign display_pagination_desktop = 'block'
  else
    assign display_pagination_desktop = 'none'
  endif
  if show_pagination_mobile
    assign display_pagination_mobile = 'block'
  else
    assign display_pagination_mobile = 'none'
  endif
%}

<div {% render 'section-attr' %}>
  {% render 'section-bg-image' %}
  <xo-container>
    <xo-animate xo-cascade>
      {% render 'section-heading', title: section.settings.heading_title, description: section.settings.heading_description, align: section.settings.heading_align %}
    </xo-animate>
    {%- if has_products -%}
      {% comment %} Same pattern as vastu-grid-carousel: mobile grid + desktop carousel. Supports collection or hand-picked product blocks. {% endcomment %}
      <div class='vastu-grid-carousel__mobile-grid'>
        <xo-grid
          class='vastu-grid-carousel__grid'
          style='--xs: {{ section.settings.columns_mobile }}; --sm: {{ section.settings.columns_mobile }}; --md: {{ section.settings.columns_desktop | minus: 1 }}; --lg: {{ section.settings.columns_desktop }}; --xo-grid-col-gap: 20px; --xo-grid-row-gap: 20px;'
        >
          {%- if product_source == 'blocks' -%}
            {%- assign rendered_count = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'product' and block.settings.product != blank and rendered_count < section.settings.limit -%}
                {%- assign rendered_count = rendered_count | plus: 1 -%}
                <div class='vastu-grid-carousel__grid-item' {{ block.shopify_attributes }}>
                  {% render 'vastu-product-card',
                    product: block.settings.product,
                    section: section,
                    settings: section.settings
                  %}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for product in section.settings.collection.products limit: section.settings.limit -%}
              <div class='vastu-grid-carousel__grid-item'>
                {% render 'vastu-product-card',
                  product: product,
                  section: section,
                  settings: section.settings
                %}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </xo-grid>
      </div>

      <div class='vastu-grid-carousel__desktop-carousel'>
        <xo-carousel
          xo-per-view='{{ section.settings.columns_desktop }}'
          xo-gap='20'
          xo-speed='400'
          xo-autoplay='5000'
          xo-loop
          xo-hover-pause
          xo-breakpoints='{"992": {"perView": {{ section.settings.columns_desktop | minus: 1 }}}}'
          xo-render-bullet='<span></span>'
        >
          <xo-carousel-inner>
            <xo-carousel-list role='list' aria-label='{{ 'general.slider.name' | t }}'>
              {%- if product_source == 'blocks' -%}
                {%- assign slide_count = 0 -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'product' and block.settings.product != blank and slide_count < section.settings.limit -%}
                    {%- assign slide_count = slide_count | plus: 1 -%}
                    <xo-carousel-slide aria-roledescription='{{ 'sections.slideshow.slide' | t }}' aria-label='{{ slide_count }} {{ 'general.slider.of' | t }} {{ total_products_shown }}' {{ block.shopify_attributes }}>
                      {% render 'vastu-product-card',
                        product: block.settings.product,
                        section: section,
                        settings: section.settings
                      %}
                    </xo-carousel-slide>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- for product in section.settings.collection.products limit: section.settings.limit -%}
                  <xo-carousel-slide aria-roledescription='{{ 'sections.slideshow.slide' | t }}' aria-label='{{ forloop.index }} {{ 'general.slider.of' | t }} {{ section.settings.collection.products.size }}'>
                    {% render 'vastu-product-card',
                      product: product,
                      section: section,
                      settings: section.settings
                    %}
                  </xo-carousel-slide>
                {%- endfor -%}
              {%- endif -%}
            </xo-carousel-list>
          </xo-carousel-inner>
          {% render 'carousel-navigation-style1', display_navigation_desktop: display_navigation_desktop, display_navigation_mobile: display_navigation_mobile %}
          <div class='featured-collection__pagination' style='--display-desktop: {{ display_pagination_desktop }}; --display-mobile: {{ display_pagination_mobile }}'>
            {% render 'carousel-pagination-style3' %}
          </div>
        </xo-carousel>
      </div>
    {%- endif -%}
  </xo-container>
</div>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading_title",
      "label": "t:sections.all.title.label",
      "default": "Section title"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:sections.all.heading_align.label",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.heading_align.option__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.heading_align.option__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.heading_align.option__3.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "product_source",
      "label": "Product source",
      "default": "collection",
      "options": [
        {
          "value": "collection",
          "label": "From collection"
        },
        {
          "value": "blocks",
          "label": "Hand-picked products"
        }
      ],
      "info": "Show products from a collection, or add individual products using the blocks below"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.settings.collection.label",
      "info": "Only used when Product source is \"From collection\""
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 12,
      "label": "t:sections.featured_collection.settings.limit.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "t:sections.featured_collection.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.featured_collection.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.featured_collection.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.featured_collection.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.settings.navigation_heading.content"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "default": true,
      "label": "t:sections.featured_collection.settings.show_navigation.label"
    },
    {
      "type": "checkbox",
      "id": "show_navigation_mobile",
      "default": false,
      "label": "t:sections.featured_collection.settings.show_navigation_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.settings.pagination_heading.content"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "default": true,
      "label": "t:sections.featured_collection.settings.show_pagination.label"
    },
    {
      "type": "checkbox",
      "id": "show_pagination_mobile",
      "default": false,
      "label": "t:sections.featured_collection.settings.show_pagination_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.settings.color_scheme_heading.content"
    },
    {
      "type": "checkbox",
      "id": "distinct_color_scheme",
      "label": "t:sections.featured_collection.settings.distinct_color_scheme.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "product_card_color_scheme",
      "default": "scheme_1",
      "label": "t:sections.featured_collection.settings.color_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.heading.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "t:sections.all.background_type.label",
      "options": [
        {
          "value": "color",
          "label": "t:sections.all.background_type.option__1.label"
        },
        {
          "value": "gradient",
          "label": "t:sections.all.background_type.option__2.label"
        },
        {
          "value": "image",
          "label": "t:sections.all.background_type.option__3.label"
        },
        {
          "value": "video",
          "label": "t:sections.all.background_type.option__4.label"
        }
      ],
      "default": "color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.all.background_color.label",
      "alpha": true,
      "visible_if": "{{ section.settings.background_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "t:sections.all.background_gradient.label",
      "visible_if": "{{ section.settings.background_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image_desktop",
      "label": "t:sections.all.background_image_desktop.label",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "t:sections.all.background_image_mobile.label",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "checkbox",
      "id": "use_parallax",
      "label": "t:sections.all.use_parallax.label",
      "default": true,
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "background_image_animation",
      "label": "t:sections.all.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.animation.option__0.label"
        },
        {
          "value": "fade",
          "label": "t:sections.all.animation.option__1.label"
        },
        {
          "value": "fade-up",
          "label": "t:sections.all.animation.option__2.label"
        },
        {
          "value": "fade-down",
          "label": "t:sections.all.animation.option__3.label"
        },
        {
          "value": "fade-left",
          "label": "t:sections.all.animation.option__4.label"
        },
        {
          "value": "fade-right",
          "label": "t:sections.all.animation.option__5.label"
        },
        {
          "value": "zoom-in",
          "label": "t:sections.all.animation.option__6.label"
        },
        {
          "value": "zoom-out",
          "label": "t:sections.all.animation.option__7.label"
        },
        {
          "value": "rotate-left-up",
          "label": "t:sections.all.animation.option__8.label"
        },
        {
          "value": "rotate-right-up",
          "label": "t:sections.all.animation.option__9.label"
        },
        {
          "value": "snake-up",
          "label": "t:sections.all.animation.option__10.label"
        },
        {
          "value": "snake-down",
          "label": "t:sections.all.animation.option__11.label"
        },
        {
          "value": "snake-left",
          "label": "t:sections.all.animation.option__12.label"
        },
        {
          "value": "snake-right",
          "label": "t:sections.all.animation.option__13.label"
        },
        {
          "value": "3d-up",
          "label": "t:sections.all.animation.option__14.label"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "textarea",
      "id": "background_video_url",
      "label": "t:sections.all.background_video_url.label",
      "visible_if": "{{ section.settings.background_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "background_video_animation",
      "label": "t:sections.all.animation.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.animation.option__0.label"
        },
        {
          "value": "fade",
          "label": "t:sections.all.animation.option__1.label"
        },
        {
          "value": "fade-up",
          "label": "t:sections.all.animation.option__2.label"
        },
        {
          "value": "fade-down",
          "label": "t:sections.all.animation.option__3.label"
        },
        {
          "value": "fade-left",
          "label": "t:sections.all.animation.option__4.label"
        },
        {
          "value": "fade-right",
          "label": "t:sections.all.animation.option__5.label"
        },
        {
          "value": "zoom-in",
          "label": "t:sections.all.animation.option__6.label"
        },
        {
          "value": "zoom-out",
          "label": "t:sections.all.animation.option__7.label"
        },
        {
          "value": "rotate-left-up",
          "label": "t:sections.all.animation.option__8.label"
        },
        {
          "value": "rotate-right-up",
          "label": "t:sections.all.animation.option__9.label"
        },
        {
          "value": "snake-up",
          "label": "t:sections.all.animation.option__10.label"
        },
        {
          "value": "snake-down",
          "label": "t:sections.all.animation.option__11.label"
        },
        {
          "value": "snake-left",
          "label": "t:sections.all.animation.option__12.label"
        },
        {
          "value": "snake-right",
          "label": "t:sections.all.animation.option__13.label"
        },
        {
          "value": "3d-up",
          "label": "t:sections.all.animation.option__14.label"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.background_type == 'video' }}"
    },
    {
      "type": "color",
      "id": "background_overlay",
      "label": "t:sections.all.background_overlay.label",
      "alpha": true,
      "visible_if": "{{ section.settings.background_type == 'image' or section.settings.background_type == 'video' }}"
    },
    {
      "type": "number",
      "id": "background_margin",
      "label": "t:sections.all.background_margin.label",
      "default": 0
    },
    {
