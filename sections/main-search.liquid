{% liquid
  assign money_format = 100 | money
  if settings.currency_code_enabled
    assign money_format = 100 | money_with_currency
  endif
%}

{%- liquid
  # Calculate product count only (excluding pages, articles, etc.)
  # Also count actual products in current page to verify results exist
  assign product_count = search.results_count
  assign actual_products_on_page = 0
  
  if search.performed
    # Count actual products in current page (excluding unwanted items)
    for item in search.results
      if item.object_type == 'product'
        assign item_url_lower = item.url | downcase
        assign item_handle_lower = item.handle | downcase
        assign item_title_lower = item.title | downcase
        assign should_exclude = false
        
        if item_url_lower contains 'sitemap' or item_handle_lower contains 'sitemap' or item_title_lower contains 'sitemap'
          assign should_exclude = true
        elsif item_url_lower contains 'avada-sitemap'
          assign should_exclude = true
        elsif item_url_lower contains '/pages/new-year-gifts-collection' and item_url_lower contains '_pos=' and item_url_lower contains '_sid='
          assign should_exclude = true
        elsif item_url_lower contains '_pos=' or item_url_lower contains '_sid=' or item_url_lower contains '_ss='
          assign should_exclude = true
        endif
        
        unless should_exclude
          assign actual_products_on_page = actual_products_on_page | plus: 1
        endunless
      endif
    endfor
    
    # Check if URL has type=product parameter
    if request.url contains 'type=product' or request.url contains '&type=product'
      assign product_count = search.results_count
    else
      # Estimate total product count based on ratio
      assign total_on_page = search.results.size
      if total_on_page > 0 and actual_products_on_page > 0
        assign product_ratio = actual_products_on_page | times: 1.0 | divided_by: total_on_page
        assign product_count = search.results_count | times: product_ratio | round
      else
        assign product_count = actual_products_on_page
      endif
    endif
  endif
-%}

<div {% render 'section-attr' %} class='main-search-page'>
  <xo-filters-top></xo-filters-top>
  <xo-filters xo-section-id='{{ section.id }}' xo-money-format='{{ money_format }}' xo-results-count='{{ product_count }}'>
    <xo-container {% render 'section-layout' %}>
      <div class='main-search__header'>
        <div class='main-search__search'>
          <h2 class='main-search__title'>
            {%- if search.performed -%}
              {{ 'templates.search.title' | t }}
            {%- else -%}
              {{ 'templates.search.title_page' | t }}
            {%- endif -%}
          </h2>
          <form action='{{ routes.search_url }}' method='get' role='search' class='search'>
            <input type='hidden' name='type' value='product'>
            {% liquid
              assign value = search.terms | escape
              assign label = 'general.search.search' | t
              render 'predictive-search-style2', value: value, label: label
            %}
          </form>
        </div>
        {%- if search.performed -%}
          {%- if actual_products_on_page > 0 or product_count > 0 -%}
            <div class='main-search__results-count'>
              <p role='status' class='main-search__status'>
                {{ 'templates.search.results_with_count_and_term' | t: terms: search.terms, count: product_count }}
              </p>
            </div>
          {%- else -%}
            <p role='status' class='main-search__status'>{{ 'templates.search.no_results' | t: terms: search.terms }}</p>
          {%- endif -%}
        {%- endif -%}
      </div>
      {%- if search.performed -%}
        {% render 'filters-refine' %}
        {% render 'filters-search-content-simple',
          items_per_page: section.settings.items_per_page,
          columns_mobile: section.settings.columns_mobile,
          columns_desktop: section.settings.columns_desktop
        %}
      {%- endif -%}
    </xo-container>
  </xo-filters>
</div>

<script>
  // Clear search button handler
  (function() {
    function setupClearButton() {
      const clearButton = document.querySelector('.xo-predictive-search__input--style2 .xo-predictive-search__clear');
      const searchInput = document.querySelector('#predictive-search');
      
      function toggleClearButton() {
        if (clearButton && searchInput) {
          if (searchInput.value && searchInput.value.trim() !== '') {
            clearButton.style.display = 'flex';
          } else {
            clearButton.style.display = 'none';
          }
        }
      }
      
      if (clearButton && searchInput) {
        // Initial state
        toggleClearButton();
        
        // Show/hide on input
        searchInput.addEventListener('input', toggleClearButton);
        searchInput.addEventListener('keyup', toggleClearButton);
        
        // Clear button click handler
        clearButton.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          searchInput.value = '';
          searchInput.focus();
          toggleClearButton();
          
          // Redirect to search page without query
          const searchUrl = new URL(window.location.origin + '{{ routes.search_url }}');
          searchUrl.searchParams.set('type', 'product');
          window.location.href = searchUrl.toString();
        });
      }
    }
    
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupClearButton);
    } else {
      setupClearButton();
    }
  })();
  
  // Update search results count to show only products
  (function() {
    function updateProductCount() {
      const filtersElement = document.querySelector('xo-filters');
      let totalProductCount = 0;
      
      // Count actual visible product cards first
      const productCards = document.querySelectorAll('.filters-content__grid .vastu-grid-card');
      totalProductCount = productCards.length;
      
      // If we have visible cards, use that count
      if (totalProductCount > 0) {
        const urlParams = new URLSearchParams(window.location.search);
        const searchTerms = urlParams.get('q') || urlParams.get('search') || '';
        
        const countDisplay = document.querySelector('.main-search__status');
        if (countDisplay) {
          const countText = totalProductCount === 1 
            ? totalProductCount + ' result found for "' + searchTerms + '"'
            : totalProductCount + ' results found for "' + searchTerms + '"';
          countDisplay.textContent = countText;
          
          // Update parent container visibility
          const resultsCountContainer = countDisplay.closest('.main-search__results-count');
          if (resultsCountContainer) {
            resultsCountContainer.style.display = 'block';
          }
          
          // Hide any "no results" messages
          const noResultsMsg = document.querySelector('.main-search__status');
          if (noResultsMsg && noResultsMsg.textContent.includes('No results')) {
            noResultsMsg.style.display = 'none';
          }
        }
        
        if (filtersElement) {
          filtersElement.setAttribute('xo-results-count', totalProductCount);
        }
      } else {
        // Check if there are actually no results or if they're just not loaded yet
        const urlParams = new URLSearchParams(window.location.search);
        const searchTerms = urlParams.get('q') || urlParams.get('search') || '';
        
        if (filtersElement && filtersElement.hasAttribute('xo-results-count')) {
          const attrCount = parseInt(filtersElement.getAttribute('xo-results-count')) || 0;
          if (attrCount === 0 && searchTerms) {
            // Only show "no results" if we're sure there are none
            const countDisplay = document.querySelector('.main-search__status');
            if (countDisplay && !countDisplay.textContent.includes('result')) {
              countDisplay.textContent = 'No results found for "' + searchTerms + '". Check the spelling or use a different word or phrase.';
              countDisplay.style.display = 'block';
            }
          }
        }
      }
    }
    
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateProductCount);
    } else {
      updateProductCount();
    }
    
    setTimeout(updateProductCount, 500);
    setTimeout(updateProductCount, 1500);
    
    const filtersContent = document.querySelector('xo-filters-content');
    if (filtersContent) {
      const observer = new MutationObserver(function() {
        setTimeout(updateProductCount, 100);
      });
      observer.observe(filtersContent, { childList: true, subtree: true });
    }
  })();
</script>

