{% comment %}
  Renders filter content using single product card (vastu-grid-card) everywhere.
  Same card and CSS as rest of site: vastu-grid-carousel.css
{% endcomment %}

<xo-filters-content>
  {% if product_loadtype == 'paginate' %}
    {%- paginate collection.products by products_per_page -%}
      <div>
        {%- if collection.products.size == 0 -%}
          {% assign empty_title = 'sections.collection_template.empty' | t %}
          {% assign empty_content = 'sections.collection_template.use_fewer_filters_html' | t: link: collection.url, class: 'underlined-link link' %}
          {% render 'empty', title: empty_title, content: empty_content %}
        {%- else -%}
          {%- if product_layout == 'grid' -%}
            <xo-grid
              class='filters-content__grid vastu-grid-carousel__grid'
              style='--xs: {{ columns_mobile }}; --sm: {{ columns_mobile }}; --md: {{ columns_desktop | minus: 1 }}; --lg: {{ columns_desktop }}; --xo-grid-col-gap: 20px; --xo-grid-row-gap: 20px;'
            >
              {%- for product in collection.products -%}
                <div class='vastu-grid-carousel__grid-item'>
                  {% render 'vastu-product-card',
                    product: product,
                    section: section,
                    settings: section.settings
                  %}
                </div>
              {%- endfor -%}
            </xo-grid>
          {%- else -%}
            <div class='filters-content__list'>
              {%- for product in collection.products -%}
                {% render 'vastu-product-card',
                  product: product,
                  section: section,
                  settings: section.settings
                %}
              {%- endfor -%}
            </div>
          {%- endif -%}
          <xo-filters-paginate>
            {% render 'pagination', paginate: paginate, anchor: '' %}
          </xo-filters-paginate>
        {%- endif -%}
      </div>
    {%- endpaginate -%}
  {% else %}
    <div>
      {%- if collection.products.size == 0 -%}
        {% assign empty_title = 'sections.collection_template.empty' | t %}
        {% assign empty_content = 'sections.collection_template.use_fewer_filters_html' | t: link: collection.url, class: 'underlined-link link' %}
        {% render 'empty', title: empty_title, content: empty_content %}
      {%- else -%}
        {%- if product_layout == 'grid' -%}
          <xo-grid
            class='filters-content__grid vastu-grid-carousel__grid'
            style='--xs: {{ columns_mobile }}; --sm: {{ columns_mobile }}; --md: {{ columns_desktop | minus: 1 }}; --lg: {{ columns_desktop }}; --xo-grid-col-gap: 20px; --xo-grid-row-gap: 20px;'
          >
            {%- for product in collection.products -%}
              <div class='vastu-grid-carousel__grid-item'>
                {% render 'vastu-product-card',
                  product: product,
                  section: section,
                  settings: section.settings
                %}
              </div>
            {%- endfor -%}
          </xo-grid>
        {%- else -%}
          <div class='filters-content__list'>
            {%- for product in collection.products -%}
              {% render 'vastu-product-card',
                product: product,
                section: section,
                settings: section.settings
              %}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  {% endif %}
</xo-filters-content>
