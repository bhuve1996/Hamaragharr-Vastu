{% comment %}
  Renders a list of cart discounts.

  Usage:
  {% render 'cart-discount-list' %}
{% endcomment %}

<xo-cart-will-change xo-unique-id='xo-discount-list-{{ section.id }}' class='xo-discount-list'>
  {% if cart != empty and cart.cart_level_discount_applications.size > 0 %}
    <ul role='list' class='discounts' aria-label='{{ 'customer.order.discount' | t }}'>
      {%- for discount in cart.cart_level_discount_applications -%}
        <li class='discounts__discount discounts__discount--position'>
          {%- render 'icon', name: 'discount' -%}
          {{ discount.title | escape }}
          {% liquid
            if settings.currency_code_enabled
              assign discount_amount = discount.total_allocated_amount | money_with_currency
            else
              assign discount_amount = discount.total_allocated_amount | money
            endif
            assign discount_amount = discount_amount | replace: 'Rs.', '₹' | replace: 'Rs ', '₹ ' | replace: 'INR', '₹' | replace: '$', '₹' | replace: 'USD', 'INR'
          %}
          (-{{ discount_amount }})
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</xo-cart-will-change>
