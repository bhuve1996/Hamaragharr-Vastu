{%- if item.original_price != item.final_price or item.unit_price_measurement -%}
  <dl>
    {%- if item.original_price != item.final_price -%}
      <dt>
        <span class='xo-visually-hidden'>{{ 'products.product.price.regular_price' | t }}</span>
      </dt>
      <dd class='regular-price'>
        <s>{%- assign orig_price = item.original_price | money -%}{{ orig_price | replace: 'Rs.', '₹' | replace: 'Rs ', '₹ ' | replace: 'INR', '₹' | replace: '$', '₹' | replace: 'USD', 'INR' }}</s>
      </dd>
      <dt>
        <span class='xo-visually-hidden'>{{ 'products.product.price.sale_price' | t }}</span>
      </dt>
      <dd>
        <span>{%- assign final_price = item.final_price | money -%}{{ final_price | replace: 'Rs.', '₹' | replace: 'Rs ', '₹ ' | replace: 'INR', '₹' | replace: '$', '₹' | replace: 'USD', 'INR' }}</span>
      </dd>
    {%- else -%}
      <dt>
        <span class='xo-visually-hidden'>{{ 'products.product.price.regular_price' | t }}</span>
      </dt>
      <dd>
        {%- assign orig_price = item.original_price | money -%}{{ orig_price | replace: 'Rs.', '₹' | replace: 'Rs ', '₹ ' | replace: 'INR', '₹' | replace: '$', '₹' | replace: 'USD', 'INR' }}
      </dd>
    {%- endif -%}
    {%- if item.unit_price_measurement -%}
      <dt>
        <span class='xo-visually-hidden'>{{ 'products.product.price.unit_price' | t }}</span>
      </dt>
      <dd class='unit-price'>
        <span>
          {%- capture unit_price_separator -%}
            <span aria-hidden="true">/</span
            ><span class="xo-visually-hidden">{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
          {%- endcapture -%}
          {%- capture unit_price_base_unit -%}
            {%- if item.unit_price_measurement.reference_value != 1 -%}
              {{- item.unit_price_measurement.reference_value -}}
            {%- endif -%}
            {{ item.unit_price_measurement.reference_unit }}
          {%- endcapture -%}
          <span data-unit-price>{%- assign unit_price = item.unit_price | money -%}{{ unit_price | replace: 'Rs.', '₹' | replace: 'Rs ', '₹ ' | replace: 'INR', '₹' | replace: '$', '₹' | replace: 'USD', 'INR' }}</span>
          {{- unit_price_separator -}}
          {{- unit_price_base_unit -}}
        </span>
      </dd>
    {%- endif -%}
  </dl>
{%- else -%}
  <span>{%- assign final_price = item.final_price | money -%}{{ final_price | replace: 'Rs.', '₹' | replace: 'Rs ', '₹ ' | replace: 'INR', '₹' | replace: '$', '₹' | replace: 'USD', 'INR' }}</span>
{%- endif -%}
