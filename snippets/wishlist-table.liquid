{% comment %}
  Wishlist as grid of product cards. Same card and CSS as rest of site: vastu-grid-card + vastu-grid-carousel.css
  Usage: {% render 'wishlist-table', section: section %}
{% endcomment %}

<xo-products-fetcher xo-type='wishlist' xo-section-id='{{ section.id }}' class='main-wishlist__grid-wrapper'>
  <xo-grid class='main-wishlist__grid vastu-grid-carousel__grid' style='--xs: 2; --sm: 2; --md: 3; --lg: 4; --xo-grid-col-gap: 20px; --xo-grid-row-gap: 20px;'>
    {% if search.results %}
      {% for product in search.results %}
        <div class='main-wishlist__grid-item vastu-grid-carousel__grid-item'>
          {% render 'vastu-product-card',
            product: product,
            section: section,
            settings: section.settings
          %}
        </div>
      {% endfor %}
    {% endif %}
  </xo-grid>
</xo-products-fetcher>
