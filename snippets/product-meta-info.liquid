<div class='meta'>
  <p
    class='
      meta__info meta__info--sku {% if disable1 == false %}
        meta__info--disable
      {% endif %}
    '
  >
    SKU :
    <span>
      {%- if product.selected_or_first_available_variant.sku != blank -%}
        {{ product.selected_or_first_available_variant.sku }}
      {%- elsif product.variants.first.sku != blank -%}
        {{ product.variants.first.sku }}
      {%- endif -%}
    </span>
  </p>
  <p
    class='
      meta__info {% if disable2 == false %}
        meta__info--disable
      {% endif %}
    '
  >
    Categories :
    <span>
      <span>
        {%- assign collection_titles = product.collections | map: 'title' | join: ', ' -%}
        {{ collection_titles | replace: ', ', ', ' }}
      </span>
    </span>
  </p>
</div>
