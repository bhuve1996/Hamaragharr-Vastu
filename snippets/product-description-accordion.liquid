{% comment %}
  Renders product description as Q&A accordion format
  Parses bold headings as questions and groups content into accordion sections
  
  Usage:
    {% render 'product-description-accordion', description: product.description %}
{% endcomment %}

{% if description != blank %}
  {% assign description_html = description %}
  
  <div class='product-description-accordion'>
    <xo-collapse-provider xo-duration='300'>
      
      {% comment %} Check if description has HTML headings (H2, H3, H4, etc.) {% endcomment %}
      {% assign has_h2 = false %}
      {% assign has_h3 = false %}
      {% assign has_h4 = false %}
      {% if description_html contains '<h2' or description_html contains '<H2' %}
        {% assign has_h2 = true %}
      {% endif %}
      {% if description_html contains '<h3' or description_html contains '<H3' %}
        {% assign has_h3 = true %}
      {% endif %}
      {% if description_html contains '<h4' or description_html contains '<H4' %}
        {% assign has_h4 = true %}
      {% endif %}
      
      {% if has_h2 or has_h3 or has_h4 %}
        {% comment %} Has HTML headings - split by headings and use as questions {% endcomment %}
        {% assign heading_tag = '<h2' %}
        {% if has_h3 and not has_h2 %}
          {% assign heading_tag = '<h3' %}
        {% elsif has_h4 and not has_h2 and not has_h3 %}
          {% assign heading_tag = '<h4' %}
        {% endif %}
        
        {% comment %} Split by the primary heading tag and also check for other heading levels {% endcomment %}
        {% assign sections = description_html | split: heading_tag %}
        {% for section in sections %}
          {% if section != blank and forloop.index > 1 %}
            {% assign section_parts = section | split: '>' %}
            {% if section_parts.size > 1 %}
              {% assign heading_text = section_parts[1] | split: '</' | first | strip_html | strip %}
              
              {% comment %} Extract content until next heading (any level) {% endcomment %}
              {% assign content_text = section | split: '>' | last %}
              {% comment %} Remove any nested headings from content {% endcomment %}
              {% assign content_text = content_text | split: '<h2' | first %}
              {% assign content_text = content_text | split: '<h3' | first %}
              {% assign content_text = content_text | split: '<h4' | first %}
              {% assign content_text = content_text | split: '<H2' | first %}
              {% assign content_text = content_text | split: '<H3' | first %}
              {% assign content_text = content_text | split: '<H4' | first %}
              
              {% if heading_text != blank %}
                <xo-animate xo-cascade class='faq-v3__row'>
                  <xo-collapse-trigger class='faq-v3__trigger'>
                    <div class='faq-v3__question'>{{ heading_text }}</div>
                    <div class='faq-v3__icon'>
                      {%- render 'icon', name: 'plus2', icon_size: '15', color: 'rgba(var(--color-foreground))' -%}
                    </div>
                  </xo-collapse-trigger>
                  <xo-collapse>
                    <div class='faq-v3__answer'>{{ content_text }}</div>
                  </xo-collapse>
                </xo-animate>
              {% endif %}
            {% endif %}
          {% endif %}
        {% endfor %}
      {% else %}
        {% comment %} Parse content by identifying bold headings and grouping content {% endcomment %}
        {% assign paragraphs = description_html | split: '<p' %}
        {% assign current_question = '' %}
        {% assign current_answer = '' %}
        {% assign is_first_section = true %}
        
        {% for para in paragraphs %}
          {% if para != blank %}
            {% assign para_full = '<p' | append: para %}
            {% assign para_text = para_full | strip_html | strip %}
            {% assign para_clean = para_text | strip %}
            
            {% comment %} Check if paragraph is a bold heading {% endcomment %}
            {% assign is_heading = false %}
            {% assign heading_text = '' %}
            
            {% comment %} Check for bold text (both <b> and <strong> tags) {% endcomment %}
            {% if para_full contains '<b>' and para_full contains '</b>' %}
              {% comment %} Extract bold text {% endcomment %}
              {% assign bold_content = para_full | split: '<b>' | last | split: '</b>' | first | strip_html | strip %}
              {% assign text_after_bold = para_full | split: '</b>' | last | strip_html | strip %}
              
              {% comment %} Check if paragraph is entirely bold or mostly bold (heading) {% endcomment %}
              {% if text_after_bold == blank or text_after_bold.size < 5 %}
                {% assign is_heading = true %}
                {% assign heading_text = bold_content %}
              {% elsif bold_content.size > 10 and bold_content.size < 150 %}
                {% comment %} Large bold text at start is likely a heading {% endcomment %}
                {% assign is_heading = true %}
                {% assign heading_text = bold_content %}
              {% endif %}
              
              {% comment %} Also check for uppercase headings (like "BENEFITS", "INTRODUCING THE SOLUTION") {% endcomment %}
              {% if is_heading == false and bold_content != blank %}
                {% assign bold_upper = bold_content | upcase %}
                {% if bold_content == bold_upper and bold_content.size > 3 and bold_content.size < 100 %}
                  {% assign is_heading = true %}
                  {% assign heading_text = bold_content %}
                {% endif %}
              {% endif %}
            {% elsif para_full contains '<strong>' and para_full contains '</strong>' %}
              {% comment %} Also check for <strong> tags {% endcomment %}
              {% assign bold_content = para_full | split: '<strong>' | last | split: '</strong>' | first | strip_html | strip %}
              {% assign text_after_bold = para_full | split: '</strong>' | last | strip_html | strip %}
              
              {% if text_after_bold == blank or text_after_bold.size < 5 %}
                {% assign is_heading = true %}
                {% assign heading_text = bold_content %}
              {% elsif bold_content.size > 10 and bold_content.size < 150 %}
                {% assign is_heading = true %}
                {% assign heading_text = bold_content %}
              {% endif %}
            {% endif %}
            
            {% if is_heading and heading_text != blank %}
              {% comment %} Found a new heading - save previous section {% endcomment %}
              {% if current_question != blank and current_answer != blank %}
                <xo-animate xo-cascade class='faq-v3__row'>
                  <xo-collapse-trigger class='faq-v3__trigger'>
                    <div class='faq-v3__question'>{{ current_question }}</div>
                    <div class='faq-v3__icon'>
                      {%- render 'icon', name: 'plus2', icon_size: '15', color: 'rgba(var(--color-foreground))' -%}
                    </div>
                  </xo-collapse-trigger>
                  <xo-collapse>
                    <div class='faq-v3__answer'>{{ current_answer }}</div>
                  </xo-collapse>
                </xo-animate>
              {% endif %}
              
              {% comment %} Start new section {% endcomment %}
              {% assign current_question = heading_text %}
              {% assign current_answer = '' %}
              {% assign is_first_section = false %}
            {% else %}
              {% comment %} Regular content - add to current answer {% endcomment %}
              {% if current_question != blank %}
                {% if current_answer != blank %}
                  {% assign current_answer = current_answer | append: para_full %}
                {% else %}
                  {% assign current_answer = para_full %}
                {% endif %}
              {% else %}
                {% comment %} No heading yet - check if first paragraph could be a heading {% endcomment %}
                {% if is_first_section and para_full contains '<b>' %}
                  {% assign first_bold = para_full | split: '<b>' | last | split: '</b>' | first | strip_html | strip %}
                  {% if first_bold.size > 10 %}
                    {% assign current_question = first_bold %}
                    {% assign current_answer = para_full | split: '</b>' | last %}
                  {% else %}
                    {% assign current_question = para_clean | truncatewords: 10 %}
                    {% assign current_answer = para_full %}
                  {% endif %}
                {% else %}
                  {% assign current_question = para_clean | truncatewords: 10 %}
                  {% assign current_answer = para_full %}
                {% endif %}
                {% assign is_first_section = false %}
              {% endif %}
            {% endif %}
          {% endif %}
        {% endfor %}
        
        {% comment %} Show last accumulated Q&A {% endcomment %}
        {% if current_question != blank %}
          <xo-animate xo-cascade class='faq-v3__row'>
            <xo-collapse-trigger class='faq-v3__trigger'>
              <div class='faq-v3__question'>{{ current_question }}</div>
              <div class='faq-v3__icon'>
                {%- render 'icon', name: 'plus2', icon_size: '15', color: 'rgba(var(--color-foreground))' -%}
              </div>
            </xo-collapse-trigger>
            <xo-collapse>
              <div class='faq-v3__answer'>{{ current_answer }}</div>
            </xo-collapse>
          </xo-animate>
        {% elsif description_html != blank %}
          {% comment %} Fallback: Show full description {% endcomment %}
          <xo-animate xo-cascade class='faq-v3__row'>
            <xo-collapse-trigger class='faq-v3__trigger'>
              <div class='faq-v3__question'>Product Description</div>
              <div class='faq-v3__icon'>
                {%- render 'icon', name: 'plus2', icon_size: '15', color: 'rgba(var(--color-foreground))' -%}
              </div>
            </xo-collapse-trigger>
            <xo-collapse>
              <div class='faq-v3__answer'>{{ description_html }}</div>
            </xo-collapse>
          </xo-animate>
        {% endif %}
      {% endif %}
      
    </xo-collapse-provider>
  </div>
{% endif %}
