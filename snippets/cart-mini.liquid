{% comment %}
  Renders cart drawer

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

{% liquid
  if settings.cart_type == 'drawer'
    if settings.cart_drawer_placement == 'left'
      assign animate = 'slide-right'
      assign placement = 'top-left'
    else
      assign animate = 'slide-left'
      assign placement = 'top-right'
    endif
  elsif settings.cart_type == 'notification'
    assign animate = 'fade-up'
    assign placement = 'center'
  endif
%}
<xo-modal
  xo-section-select
  xo-portal
  xo-name='cart'
  xo-animate='{{ animate }}'
  xo-placement='{{ placement }}'
  xo-duration='1000'
  xo-for-cart-mini
  class='color-{{ settings.cart_color_scheme }}'
  style='z-index: 9999;'
  {% if settings.cart_type == 'notification' %}
    xo-breakpoints="
      {
        992: {
          disabled: false,
          placement: 'center',
          animate: 'fade-up'
        }
      }
    "
  {% endif %}
>
  <xo-cart-mini
    id='xo-cart-mini'
    {% if settings.cart_type == 'notification' %}
      xo-notification
    {% endif %}
    role='dialog'
    aria-label='{{ 'sections.cart.title' | t }}'
  >
    {% case settings.cart_type %}
      {% when 'drawer' %}
        {% render 'cart-drawer' %}
      {% when 'notification' %}
        {% render 'cart-notification' %}
      {% else %}
        {% render 'cart-drawer' %}
    {% endcase %}
  </xo-cart-mini>
</xo-modal>

<script>
  (function () {
    function initVastuCartScrollHint() {
      var modal = document.querySelector('xo-modal[xo-name="cart"]');
      if (!modal) return;
      var host = modal.querySelector('.vastu-cart-scroll-hint-host');
      var scrollEl = modal.querySelector(
        'xo-cart-scroll.xo-modal-content-style1__body, .xo-modal-content-style1__body'
      );
      var hint = modal.querySelector('[data-vastu-cart-scroll-hint]');
      var btn = hint && hint.querySelector('.vastu-cart-scroll-hint__btn');
      if (!host || !scrollEl || !hint || !btn) return;

      var ticking = false;
      function update() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          ticking = false;
          var maxScroll = scrollEl.scrollHeight - scrollEl.clientHeight;
          var show = maxScroll > 12 && scrollEl.scrollTop < maxScroll - 12;
          if (show) {
            hint.removeAttribute('hidden');
            hint.classList.add('is-visible');
          } else {
            hint.setAttribute('hidden', '');
            hint.classList.remove('is-visible');
          }
        });
      }

      scrollEl.addEventListener('scroll', update, { passive: true });
      if (typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(update).observe(scrollEl);
      }
      window.addEventListener('resize', update, { passive: true });
      var mo = new MutationObserver(update);
      mo.observe(scrollEl, { childList: true, subtree: true });
      document.addEventListener('cart:updated', update);
      document.addEventListener('cart:refresh', update);

      btn.addEventListener('click', function () {
        var step = Math.min(200, Math.ceil(scrollEl.clientHeight * 0.55));
        scrollEl.scrollBy({ top: step, behavior: 'smooth' });
      });

      update();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVastuCartScrollHint);
    } else {
      initVastuCartScrollHint();
    }
  })();
</script>
