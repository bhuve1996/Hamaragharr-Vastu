{%- liquid
  # Use request.page_type for more reliable detection, fallback to template.name
  assign page_type = request.page_type | default: template.name
  
  # Handle collection pages explicitly - check multiple ways to ensure we catch it
  # Also check if page_title is incorrectly set to "homepage" when we have collection data
  if collection and collection.handle != blank and collection.title != blank
    if current_tags
      assign final_title = current_tags | join: ' + ' | append: ' - ' | append: collection.title
    else
      assign final_title = collection.title
    endif
  elsif page_type == 'collection' and collection and collection.handle != blank
    if current_tags
      assign final_title = current_tags | join: ' + ' | append: ' - ' | append: collection.title
    else
      assign final_title = collection.title
    endif
  elsif template.name == 'collection' and collection and collection.handle != blank
    if current_tags
      assign final_title = current_tags | join: ' + ' | append: ' - ' | append: collection.title
    else
      assign final_title = collection.title
    endif
  # Handle product pages
  elsif page_type == 'product' and product
    assign final_title = product.title
  elsif template.name == 'product' and product
    assign final_title = product.title
  # Handle article pages
  elsif page_type == 'article' and article
    assign final_title = article.title
  elsif template.name == 'article' and article
    assign final_title = article.title
  # Handle blog pages
  elsif page_type == 'blog' and blog
    if current_tags
      assign final_title = current_tags | join: ' + ' | append: ' - ' | append: blog.title
    else
      assign final_title = blog.title
    endif
  elsif template.name == 'blog' and blog
    if current_tags
      assign final_title = current_tags | join: ' + ' | append: ' - ' | append: blog.title
    else
      assign final_title = blog.title
    endif
  # Handle page pages
  elsif page_type == 'page' and page
    assign final_title = page.title
  elsif template.name == 'page' and page
    assign final_title = page.title
  # Handle search pages
  elsif page_type == 'search' or template.name == 'search'
    if search.performed
      assign final_title = 'templates.search.title' | t | append: ': ' | append: search.terms
    else
      assign final_title = 'templates.search.title_page' | t
    endif
  # Handle cart page
  elsif page_type == 'cart' or template.name == 'cart'
    comment
      theme-check-disable TranslationKeyExists
    endcomment
    assign final_title = 'cart.general.title' | t
  # Handle customer account pages
  elsif template.name == 'customers/account'
    assign final_title = 'customer.account.title' | t
  elsif template.name == 'customers/login'
    assign final_title = 'customer.login_page.sign_in' | t
  elsif template.name == 'customers/register'
    assign final_title = 'customer.register.title' | t
  elsif template.name == 'customers/addresses'
    assign final_title = 'customer.addresses.title' | t
  # Handle homepage/index page
  elsif page_type == 'index' or template.name == 'index'
    # Use custom homepage title if available via metafield, otherwise use SEO-optimized default
    if shop.metafields.custom.homepage_title != blank
      assign final_title = shop.metafields.custom.homepage_title
    elsif page_title != blank
      assign page_title_lower = page_title | downcase
      if page_title_lower contains 'homepage'
        # Use SEO-optimized title for homepage
        assign final_title = 'Vastu Kit for Home & Office | Vastu Shastra Products | ' | append: shop.name
      else
        assign final_title = page_title
      endif
    else
      # SEO-optimized default homepage title
      assign final_title = 'Vastu Kit for Home & Office | Vastu Shastra Products | ' | append: shop.name
    endif
  # Fallback to page_title if set, otherwise shop name
  # But exclude if page_title contains "homepage" (case insensitive)
  # Also check if we're on a collection page and use collection title instead
  else
    assign page_title_lower = page_title | downcase
    assign is_homepage = false
    if page_title_lower contains 'homepage'
      assign is_homepage = true
    endif
    
    # If page_title is "Homepage" and we're on a collection page, use collection title
    if is_homepage and template.name == 'collection' and collection
      if collection.title != blank
        if current_tags
          assign final_title = current_tags | join: ' + ' | append: ' - ' | append: collection.title
        else
          assign final_title = collection.title
        endif
      else
        assign final_title = shop.name
      endif
    elsif page_title != blank and is_homepage == false
      assign final_title = page_title
    else
      assign final_title = shop.name
    endif
  endif
-%}
<title>
  {{ final_title | escape }}
  {%- if current_tags and template.name != 'collection' and template.name != 'blog' %}
    &ndash; tagged "{{ current_tags | join: ', ' }}"
  {%- endif -%}
  {%- if current_page != 1 %}
    &ndash; Page {{ current_page }}
  {%- endif -%}
  {%- unless final_title contains shop.name %}
    &ndash; {{ shop.name | escape }}
  {%- endunless -%}
</title>
