{% comment %}
  Renders a breadcrumb

  Accepts:
  - style: {String} Modified style to use for breadcrumb--current text

  Usage:
  {% render 'breadcrumb' %}
{% endcomment %}

{% liquid
  if section.settings.breadcrumb_hide
    assign display = 'none'
  else
    assign display = 'block'
  endif
  if section.settings.breadcrumb_hide_mobile
    assign display_mobile = 'none'
  else
    assign display_mobile = 'block'
  endif
%}

{%- unless template == 'index' or template == 'cart' or template == 'list-collections' or template == '404' -%}
  {%- assign t = template | split: '.' | first -%}
  <nav class='breadcrumb' style='--display-mobile:{{ display_mobile }}' role='navigation' aria-label='breadcrumb'>
    <ol class='breadcrumb__list' style='--justify:{{ section.settings.breadcrumb_align | default: 'center' }}'>
      <li class='breadcrumb__item'>
        <a class='breadcrumb__link' href='/'>{{ 'general.home' | t }}</a>
        <span class='breadcrumb__separator'>
          {% render 'icon', name: 'arrow-right', icon_size: '8' %}
        </span>
      </li>
      {%- case t -%}
        {%- when 'page' -%}
          <li class='breadcrumb__item'>
            <a class='breadcrumb__link' href='{{ page.url }}' aria-current='page'>{{ page.title | escape }}</a>
            <span class='breadcrumb__separator'>
              {% render 'icon', name: 'arrow-right', icon_size: '8' %}
            </span>
          </li>
        {%- when 'product' -%}
          {%- if collection.url -%}
            <li class='breadcrumb__item'>
              {{ collection.title | escape | link_to: collection.url }}
              <span class='breadcrumb__separator'>
                {% render 'icon', name: 'arrow-right', icon_size: '8' %}
              </span>
            </li>
          {%- endif -%}
          <li class='breadcrumb__item breadcrumb__item--current' style='--display:{{ display }}'>
            <a
              class='breadcrumb__link breadcrumb--current breadcrumb--{{ style }}'
              href='{{ product.url }}'
              aria-current='page'
            >
              {{- product.title | escape -}}
            </a>
          </li>
        {%- when 'collection' and collection.handle -%}
          {%- if current_tags -%}
            <li class='breadcrumb__item'>
              {{ collection.title | escape | link_to: collection.url }}
              <span class='breadcrumb__separator'>
                {% render 'icon', name: 'arrow-right', icon_size: '8' %}
              </span>
            </li>
            <li class='breadcrumb__item breadcrumb__item--current' style='--display:{{ display }}'>
              {%- capture tag_url -%}{{ collection.url }}/{{ current_tags | join: "+" }}{%- endcapture -%}
              <a
                class='breadcrumb__link breadcrumb--current breadcrumb--{{ style }}'
                href='{{ tag_url }}'
                aria-current='page'
              >
                {{- current_tags | join: ' + ' -}}
              </a>
            </li>
          {%- else -%}
            <li class='breadcrumb__item breadcrumb__item--current' style='--display:{{ display }}'>
              <a
                class='breadcrumb__link breadcrumb--current breadcrumb--{{ style }}'
                style='--display:{{ display }}'
                href='{{ collection.url }}'
                aria-current='page'
              >
                {{- collection.title | escape -}}
              </a>
            </li>
          {%- endif -%}
        {%- when 'blog' -%}
          {%- if current_tags -%}
            <li class='breadcrumb__item'>
              {{ blog.title | escape | link_to: blog.url }}
              <span class='breadcrumb__separator'>
                {% render 'icon', name: 'arrow-right', icon_size: '8' %}
              </span>
            </li>
            <li class='breadcrumb__item breadcrumb__item--current' style='--display:{{ display }}'>
              {%- capture tag_url -%}{{ blog.url }}/tagged/{{ current_tags | join: "+" }}{%- endcapture -%}
              <a
                class='breadcrumb__link breadcrumb--current breadcrumb--{{ style }}'
                href='{{ tag_url }}'
                aria-current='page'
              >
                {{- current_tags | join: ' + ' -}}
              </a>
            </li>
          {%- else -%}
            <li class='breadcrumb__item breadcrumb__item--current' style='--display:{{ display }}'>
              <a
                class='breadcrumb__link breadcrumb--current breadcrumb--{{ style }}'
                href='{{ blog.url }}'
                aria-current='page'
              >
                {{- blog.title | escape -}}
              </a>
            </li>
          {%- endif -%}
        {%- when 'article' -%}
          <li class='breadcrumb__item'>
            {{ blog.title | escape | link_to: blog.url }}
            <span class='breadcrumb__separator'>
              {% render 'icon', name: 'arrow-right', icon_size: '8' %}
            </span>
          </li>
          <li class='breadcrumb__item breadcrumb__item--current' style='--display:{{ display }}'>
            <a
              class='breadcrumb__link breadcrumb--current breadcrumb--{{ style }}'
              href='{{ article.url }}'
              aria-current='page'
            >
              {{- article.title | escape -}}
            </a>
          </li>
        {%- else -%}
          <li class='breadcrumb__item breadcrumb__item--current' style='--display:{{ display }}'>
            <a
              class='breadcrumb__link breadcrumb--current breadcrumb--{{ style }}'
              href='{{ request.path }}'
              aria-current='page'
            >
              {{- page_title -}}
            </a>
          </li>
      {%- endcase -%}
    </ol>
  </nav>
  
  {%- comment -%} Breadcrumb Structured Data (Schema.org) {%- endcomment -%}
  {%- if settings.seo_enable_breadcrumb_schema != false -%}
    {%- liquid
      assign breadcrumb_list = ''
      assign position = 1
      
      # Home
      if position > 1
        assign breadcrumb_list = breadcrumb_list | append: ','
      endif
      assign home_name = shop.name | json
      assign home_url = request.origin | json
      assign breadcrumb_list = breadcrumb_list | append: '{"@type":"ListItem","position":' | append: position | append: ',"name":' | append: home_name | append: ',"item":' | append: home_url | append: '}'
      assign position = position | plus: 1
      
      # Page-specific breadcrumbs
      case t
        when 'page'
          if position > 1
            assign breadcrumb_list = breadcrumb_list | append: ','
          endif
          assign page_name = page.title | json
          assign page_url = request.origin | append: page.url | json
          assign breadcrumb_list = breadcrumb_list | append: '{"@type":"ListItem","position":' | append: position | append: ',"name":' | append: page_name | append: ',"item":' | append: page_url | append: '}'
        when 'product'
          if collection.url
            if position > 1
              assign breadcrumb_list = breadcrumb_list | append: ','
            endif
            assign collection_name = collection.title | json
            assign collection_url = request.origin | append: collection.url | json
            assign breadcrumb_list = breadcrumb_list | append: '{"@type":"ListItem","position":' | append: position | append: ',"name":' | append: collection_name | append: ',"item":' | append: collection_url | append: '}'
            assign position = position | plus: 1
          endif
          if position > 1
            assign breadcrumb_list = breadcrumb_list | append: ','
          endif
          assign product_name = product.title | json
          assign product_url = request.origin | append: product.url | json
          assign breadcrumb_list = breadcrumb_list | append: '{"@type":"ListItem","position":' | append: position | append: ',"name":' | append: product_name | append: ',"item":' | append: product_url | append: '}'
        when 'collection'
          if position > 1
            assign breadcrumb_list = breadcrumb_list | append: ','
          endif
          assign collection_name = collection.title | json
          assign collection_url = request.origin | append: collection.url | json
          assign breadcrumb_list = breadcrumb_list | append: '{"@type":"ListItem","position":' | append: position | append: ',"name":' | append: collection_name | append: ',"item":' | append: collection_url | append: '}'
        when 'article'
          if position > 1
            assign breadcrumb_list = breadcrumb_list | append: ','
          endif
          assign blog_name = blog.title | json
          assign blog_url = request.origin | append: blog.url | json
          assign breadcrumb_list = breadcrumb_list | append: '{"@type":"ListItem","position":' | append: position | append: ',"name":' | append: blog_name | append: ',"item":' | append: blog_url | append: '}'
          assign position = position | plus: 1
          if position > 1
            assign breadcrumb_list = breadcrumb_list | append: ','
          endif
          assign article_name = article.title | json
          assign article_url = request.origin | append: article.url | json
          assign breadcrumb_list = breadcrumb_list | append: '{"@type":"ListItem","position":' | append: position | append: ',"name":' | append: article_name | append: ',"item":' | append: article_url | append: '}'
        when 'blog'
          if position > 1
            assign breadcrumb_list = breadcrumb_list | append: ','
          endif
          assign blog_name = blog.title | json
          assign blog_url = request.origin | append: blog.url | json
          assign breadcrumb_list = breadcrumb_list | append: '{"@type":"ListItem","position":' | append: position | append: ',"name":' | append: blog_name | append: ',"item":' | append: blog_url | append: '}'
      endcase
    -%}
    
    {%- if breadcrumb_list != blank -%}
      <script type='application/ld+json'>
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {{ breadcrumb_list }}
        ]
      }
      </script>
    {%- endif -%}
  {%- endif -%}
{%- endunless -%}
