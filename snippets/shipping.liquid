{% comment %}
  Renders shipping and return information as accordion or modal

  Accepts:
  - show_delivery: {boolean} show/hide delivery text (required)
  - show_return: {boolean} show/hide return text (required)
  - delivery: {richtext} render delivery text (optional if use_policy_content is true)
  - return: {richtext} render return text (optional if use_policy_content is true)
  - use_policy_content: {boolean} use shop policies instead of custom content (optional)
  - use_accordion: {boolean} display as accordion (optional, default: true)
  - use_modal: {boolean} show full content in modal (optional, default: false)
  - truncate_length: {number} number of words to show in preview (optional, default: 50)
  - modal_width: {string} width of modal (optional, default: '90rem')
  Usage:
  {% render 'shipping', show_delivery: show_delivery, show_return: show_return, delivery: delivery, return: return, use_policy_content: use_policy_content, use_accordion: use_accordion, use_modal: use_modal, truncate_length: truncate_length, modal_width: modal_width %}
{% endcomment %}

{% if use_accordion == nil %}
  {% assign use_accordion = false %}
{% endif %}
{% assign use_policy_content = use_policy_content | default: false %}
{% assign use_modal = use_modal | default: false %}
{% assign truncate_length = truncate_length | default: 50 %}
{% assign modal_width = modal_width | default: '90rem' %}

{% if use_policy_content %}
  {% assign shipping_policy = shop.policies | where: 'title', 'Shipping policy' | first %}
  {% assign refund_policy = shop.policies | where: 'title', 'Refund policy' | first %}
  {% if shipping_policy %}
    {% assign delivery_content = shipping_policy.body %}
  {% endif %}
  {% if refund_policy %}
    {% assign return_content = refund_policy.body %}
  {% endif %}
{% else %}
  {% assign delivery_content = delivery %}
  {% assign return_content = return %}
{% endif %}

{% if use_accordion %}
  <div class='shipping-accordion'>
    <xo-collapse-provider xo-duration='300'>
      {% if show_delivery and delivery_content != blank %}
        {% assign delivery_text_only = delivery_content | strip_html %}
        {% assign delivery_word_count = delivery_text_only | split: ' ' | size %}
        {% assign show_modal_btn = false %}
        {% if use_modal and delivery_word_count > truncate_length %}
          {% assign show_modal_btn = true %}
          {% comment %} Create preview by truncating HTML content {% endcomment %}
          {% assign delivery_preview_text = delivery_text_only | truncatewords: truncate_length %}
          {% assign delivery_preview = delivery_content | truncatewords: truncate_length, '...' %}
        {% endif %}
        
        <xo-animate xo-cascade class='shipping-accordion__row'>
          <xo-collapse-trigger class='shipping-accordion__trigger'>
            <div class='shipping-accordion__question'>
              {% render 'icon', name: 'truck', icon_size: '24' %}
              <span>Shipping & Delivery</span>
            </div>
            <div class='shipping-accordion__icon'>
              {%- render 'icon', name: 'plus2', icon_size: '15', color: 'rgba(var(--color-foreground))' -%}
            </div>
          </xo-collapse-trigger>
          <xo-collapse>
            <div class='shipping-accordion__answer'>
              {% if use_modal and show_modal_btn %}
                <div class='shipping-accordion__preview'>
                  {{ delivery_preview }}
                </div>
                <xo-modal-trigger xo-name='shipping-policy-modal' class='shipping-accordion__view-full'>
                  <span class='shipping-accordion__view-full-link'>View More</span>
                </xo-modal-trigger>
              {% else %}
                {{ delivery_content }}
              {% endif %}
            </div>
          </xo-collapse>
        </xo-animate>
      {% endif %}
      
      {% if show_return and return_content != blank %}
        {% assign return_text_only = return_content | strip_html %}
        {% assign return_word_count = return_text_only | split: ' ' | size %}
        {% assign show_modal_btn_return = false %}
        {% if use_modal and return_word_count > truncate_length %}
          {% assign show_modal_btn_return = true %}
          {% comment %} Create preview by truncating HTML content {% endcomment %}
          {% assign return_preview_text = return_text_only | truncatewords: truncate_length %}
          {% assign return_preview = return_content | truncatewords: truncate_length, '...' %}
        {% endif %}
        
        <xo-animate xo-cascade class='shipping-accordion__row'>
          <xo-collapse-trigger class='shipping-accordion__trigger'>
            <div class='shipping-accordion__question'>
              {% render 'icon', name: 'return', icon_size: '22' %}
              <span>Returns & Exchanges</span>
            </div>
            <div class='shipping-accordion__icon'>
              {%- render 'icon', name: 'plus2', icon_size: '15', color: 'rgba(var(--color-foreground))' -%}
            </div>
          </xo-collapse-trigger>
          <xo-collapse>
            <div class='shipping-accordion__answer'>
              {% if use_modal and show_modal_btn_return %}
                <div class='shipping-accordion__preview'>
                  {{ return_preview }}
                </div>
                <xo-modal-trigger xo-name='return-policy-modal' class='shipping-accordion__view-full'>
                  <span class='shipping-accordion__view-full-link'>View More</span>
                </xo-modal-trigger>
              {% else %}
                {{ return_content }}
              {% endif %}
            </div>
          </xo-collapse>
        </xo-animate>
      {% endif %}
    </xo-collapse-provider>
  </div>
  
  {% comment %} Modals for full content {% endcomment %}
  {% if use_modal %}
    {% if show_delivery and delivery_content != blank %}
      <xo-modal xo-name='shipping-policy-modal' xo-animate='fade-up' xo-portal='true' style='z-index: 9999;'>
        {% render 'modal-content',
          title: 'Shipping & Delivery Policy',
          content: delivery_content,
          width: modal_width,
          full_height: false,
          animate: true,
          header_separator: true
        %}
      </xo-modal>
    {% endif %}
    
    {% if show_return and return_content != blank %}
      <xo-modal xo-name='return-policy-modal' xo-animate='fade-up' xo-portal='true' style='z-index: 9999;'>
        {% render 'modal-content',
          title: 'Returns & Exchanges Policy',
          content: return_content,
          width: modal_width,
          full_height: false,
          animate: true,
          header_separator: true
        %}
      </xo-modal>
    {% endif %}
  {% endif %}
{% else %}
  <div class='shipping-content'>
    {% if show_delivery and delivery_content != blank %}
      <div class='shipping-content__delivery'>
        <h3>Shipping & Delivery</h3>
        <div>{{ delivery_content }}</div>
      </div>
    {% endif %}
    {% if show_return and return_content != blank %}
      <div class='shipping-content__return'>
        <h3>Returns & Exchanges</h3>
        <div>{{ return_content }}</div>
      </div>
    {% endif %}
  </div>
{% endif %}
