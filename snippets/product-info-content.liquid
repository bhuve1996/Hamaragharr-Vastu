{% liquid
  assign media_aspect_ratio = settings.product_card_aspect_ratio
  assign gift_card_recipient_feature_active = false
  if product.gift_card?
    assign gift_card_recipient_feature_active = true
  endif
%}

<div
  class='xo-product-info-content'
  xo-products-count='{{ recommendations.products_count }}'
  {%- if section.settings.media_sticky -%}
    style='position: sticky; top: 9.3rem'
  {%- endif -%}
>
  <xo-collapse-provider>
    {% comment %} Render vendor, title, and price blocks first {% endcomment %}
    {% for block in section.blocks %}
      {% if block.type == 'vendor' or block.type == 'title' or block.type == 'price' %}
        {% case block.type %}
        {% when 'vendor' %}
          <xo-animate
            xo-cascade
            {{ block.shopify_attributes }}
            style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
          >
            {{ product.vendor }}
          </xo-animate>

        {% when 'title' %}
          <xo-animate
            xo-cascade
            {{ block.shopify_attributes }}
            style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
          >
            <div class='xo-product-info-content__header'>
              <h1 class='xo-product-info-content__title' style='--fz:{{ block.settings.font_size | append: 'rem'}}' {{ block.shopify_attributes }}>
                {{ product.title | escape }}
              </h1>
              {% if section.settings.wishlist %}
                <div>
                  {% comment %} add to wishlist {% endcomment %}
                  <xo-products-fetcher-add xo-type='wishlist' class='xo-product-info-content__wishlist'>
                    <xo-tooltip
                      xo-title='{{ 'products.product.add_to_wishlist' | t }}'
                      xo-placement='left-center'
                      xo-animate='fade-right'
                      xo-easing='spring'
                      class='xo-product-info-content__icon-wishlist'
                      xo-added
                    >
                      {% render 'icon', name: 'heart', icon_size: '20' %}
                    </xo-tooltip>
                  </xo-products-fetcher-add>
                  {% comment %} remove wishlist {% endcomment %}
                  <xo-products-fetcher-add xo-type='wishlist' class='xo-product-info-content__wishlist'>
                    <xo-tooltip
                      xo-title='{{ 'products.product.remove_from_wishlist' | t }}'
                      xo-placement='left-center'
                      xo-animate='fade-right'
                      xo-easing='spring'
                      class='xo-product-info-content__icon-wishlist'
                      xo-removed
                    >
                      {% render 'icon', name: 'heart', icon_size: '20' %}
                    </xo-tooltip>
                  </xo-products-fetcher-add>
                </div>
              {% endif %}
            </div>
          </xo-animate>

        {% when 'price' %}
          <xo-animate
            xo-cascade
            {{ block.shopify_attributes }}
            style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
          >
            <xo-product-will-change xo-unique-id='product-price-{{ product.id }}' class='xo-product-info-content__price'>
              {% render 'price', product: product, use_variant: true, style: 'larger' %}
              {% if cart.taxes_included == true %}
                <span>{{ 'products.product.price.include_tax' | t }}</span>
              {% endif %}
              {% if block.settings.saving %}
                {% render 'badge', product: product, type: block.settings.type %}
              {% endif %}
            </xo-product-will-change>
          </xo-animate>
        {% endcase %}
      {% endif %}
    {% endfor %}
    
    {% comment %} Render buy_button block after title and price {% endcomment %}
    {% for block in section.blocks %}
      {% if block.type == 'buy_button' %}
        <xo-animate
          xo-cascade
          {{ block.shopify_attributes }}
          style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
        >
          {% render 'buy-button',
            show_gift_card_recipient: block.settings.show_gift_card_recipient,
            show_dynamic_checkout: block.settings.show_dynamic_checkout,
            show_checkbox: block.settings.show_checkbox
          %}
        </xo-animate>
      {% endif %}
    {% endfor %}
    
    {% comment %} Render all other blocks except vendor, title, price, and buy_button {% endcomment %}
    {% for block in section.blocks %}
      {% unless block.type == 'vendor' or block.type == 'title' or block.type == 'price' or block.type == 'buy_button' %}
      {% case block.type %}
        {% when '@app' %}
          <xo-animate xo-cascade>
            <div class="widget-box" {{ block.shopify_attributes }}>
              {% render block %}
            </div>
          </xo-animate>

        {% when 'countdown_time' %}
          <xo-animate
            xo-cascade
            {{ block.shopify_attributes }}
            style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
          >
            {% render 'countdown-time', title: block.settings.countdown_title, time: block.settings.time %}
          </xo-animate>

        {% when 'variants' %}
          {% if product.options_with_values.size > 0 and product.options_with_values[0].name != 'Title' %}
            <div
              class='xo-product-info-content__variants'
              {{ block.shopify_attributes }}
              style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
            >
              {%- assign options_limit = 5 -%}
              {%- for option in product.options_with_values limit: options_limit -%}
                {% if option.name == 'Size' %}
                  <xo-animate xo-cascade {{ block.shopify_attributes }}>
                    {% render 'product-info-variant', option: option, style: block.settings.variants_style %}
                  </xo-animate>
                {% elsif option.name == 'Color' %}
                  <xo-animate xo-cascade {{ block.shopify_attributes }}>
                    {% render 'product-info-variant', option: option, style: block.settings.variants_color_style, media_aspect_ratio: media_aspect_ratio %}
                  </xo-animate>
                {% else %}
                  {% render 'product-info-variant', option: option, style: 'boxed2' %}
                {% endif %}
              {%- endfor -%}
            </div>
          {% endif %}

        {% when 'description' %}
          {% unless block.settings.hide_if_in_tabs %}
            <xo-animate
              xo-cascade
              {{ block.shopify_attributes }}
              style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
            >
              {% comment %} Parse product description into accordion items based on headings {% endcomment %}
              {% if product.description != blank %}
                {% assign description_html = product.description %}
                {% assign description_text_plain = product.description | strip_html %}
                
                {% comment %} Check if description has headings (h2, h3, h4) {% endcomment %}
                {% assign has_headings = false %}
                {% if description_html contains '<h2' or description_html contains '<h3' or description_html contains '<h4' %}
                  {% assign has_headings = true %}
                {% endif %}
                
                {% if has_headings %}
                  {% comment %} Normalize all heading levels into a single marker {% endcomment %}
                  {% assign normalized = description_html %}
                  {% assign normalized = normalized | replace: '<h2', '[[HEADING]]<h2' %}
                  {% assign normalized = normalized | replace: '<h3', '[[HEADING]]<h3' %}
                  {% assign normalized = normalized | replace: '<h4', '[[HEADING]]<h4' %}
                  
                  {% comment %} Split by the virtual heading marker {% endcomment %}
                  {% assign sections = normalized | split: '[[HEADING]]' %}
                  
                  {% comment %} Process each section {% endcomment %}
                  {% for section in sections %}
                    {% if section != blank %}
                      {% assign section_stripped = section | strip %}
                      
                      {% comment %} Check if this section contains a heading {% endcomment %}
                      {% if section_stripped contains '<h2' or section_stripped contains '<h3' or section_stripped contains '<h4' %}
                        {% comment %} Find the closing heading tag (</h2>, </h3>, or </h4>) {% endcomment %}
                        {% assign heading_closed = false %}
                        {% assign section_content = '' %}
                        {% assign heading_html = '' %}
                        {% assign heading_text = '' %}
                        
                        {% comment %} Try to find which heading type this section has and extract accordingly {% endcomment %}
                        {% if section_stripped contains '<h2' and section_stripped contains '</h2>' %}
                          {% assign heading_parts = section_stripped | split: '</h2>' %}
                          {% if heading_parts.size > 1 %}
                            {% assign heading_html = heading_parts[0] | append: '</h2>' %}
                            {% comment %} Get content after closing tag, but stop at next heading marker if present {% endcomment %}
                            {% assign raw_content = heading_parts[1] %}
                            {% if raw_content contains '[[HEADING]]' %}
                              {% assign content_parts = raw_content | split: '[[HEADING]]' %}
                              {% assign section_content = content_parts[0] %}
                            {% else %}
                              {% assign section_content = raw_content %}
                            {% endif %}
                            {% assign heading_closed = true %}
                          {% endif %}
                        {% elsif section_stripped contains '<h3' and section_stripped contains '</h3>' %}
                          {% assign heading_parts = section_stripped | split: '</h3>' %}
                          {% if heading_parts.size > 1 %}
                            {% assign heading_html = heading_parts[0] | append: '</h3>' %}
                            {% comment %} Get content after closing tag, but stop at next heading marker if present {% endcomment %}
                            {% assign raw_content = heading_parts[1] %}
                            {% if raw_content contains '[[HEADING]]' %}
                              {% assign content_parts = raw_content | split: '[[HEADING]]' %}
                              {% assign section_content = content_parts[0] %}
                            {% else %}
                              {% assign section_content = raw_content %}
                            {% endif %}
                            {% assign heading_closed = true %}
                          {% endif %}
                        {% elsif section_stripped contains '<h4' and section_stripped contains '</h4>' %}
                          {% assign heading_parts = section_stripped | split: '</h4>' %}
                          {% if heading_parts.size > 1 %}
                            {% assign heading_html = heading_parts[0] | append: '</h4>' %}
                            {% comment %} Get content after closing tag, but stop at next heading marker if present {% endcomment %}
                            {% assign raw_content = heading_parts[1] %}
                            {% if raw_content contains '[[HEADING]]' %}
                              {% assign content_parts = raw_content | split: '[[HEADING]]' %}
                              {% assign section_content = content_parts[0] %}
                            {% else %}
                              {% assign section_content = raw_content %}
                            {% endif %}
                            {% assign heading_closed = true %}
                          {% endif %}
                        {% endif %}
                        
                        {% if heading_closed %}
                          {% comment %} Extract heading text by stripping all HTML {% endcomment %}
                          {% assign heading_text = heading_html | strip_html | strip %}
                          {% comment %} Remove emoji/symbols from heading text - remove common emoji patterns and symbols {% endcomment %}
                          {% assign heading_text = heading_text | replace: '❓', '' | replace: '❔', '' | replace: '?', '' | replace: '🔍', '' | replace: '💡', '' | replace: '📋', '' | replace: 'ℹ️', '' | replace: 'ℹ', '' | replace: '➤', '' | replace: '→', '' | replace: '•', '' | replace: '▪', '' | replace: '▫', '' | strip %}
                          {% comment %} Remove any leading/trailing spaces and clean up {% endcomment %}
                          {% assign heading_text = heading_text | strip %}
                          {% comment %} If heading starts with a space or symbol after emoji removal, trim it {% endcomment %}
                          {% if heading_text != blank %}
                            {% assign first_char = heading_text | slice: 0, 1 %}
                            {% if first_char == ' ' or first_char == '?' or first_char == '!' or first_char == ':' or first_char == '-' %}
                              {% assign heading_text = heading_text | remove_first: first_char | strip %}
                            {% endif %}
                          {% endif %}
                          
                          {% comment %} Clean up section content - remove any leading/trailing whitespace and stray tag fragments {% endcomment %}
                          {% assign section_content = section_content | strip %}
                          {% comment %} Remove any stray HTML-encoded fragments that might appear at the start {% endcomment %}
                          {% if section_content contains '2&gt;' %}
                            {% assign section_content = section_content | remove_first: '2&gt;' | strip %}
                          {% endif %}
                          {% if section_content contains '3&gt;' %}
                            {% assign section_content = section_content | remove_first: '3&gt;' | strip %}
                          {% endif %}
                          {% if section_content contains '4&gt;' %}
                            {% assign section_content = section_content | remove_first: '4&gt;' | strip %}
                          {% endif %}
                          
                          {% if heading_text != blank %}
                            {% assign accordion_id = 'desc-' | append: forloop.index | append: '-' | append: block.id %}
                            <xo-animate xo-cascade class='accordion-section__item'>
                              <xo-collapse-trigger class='accordion-section__trigger' xo-name='{{ accordion_id }}'>
                                <div class='accordion-section__trigger-content'>
                                  <h3 class='accordion-section__heading'>{{ heading_text }}</h3>
                                </div>
                                <div class='accordion-section__trigger-icon'>
                                  {%- render 'icon', name: 'plus2', icon_size: '20', color: 'rgba(var(--color-foreground))' -%}
                                </div>
                              </xo-collapse-trigger>
                              {% if section_content != blank %}
                                <xo-collapse xo-name='{{ accordion_id }}'>
                                  <div class='accordion-section__content xo-collapse-style2__content xo-content'>
                                    {{ section_content }}
                                  </div>
                                </xo-collapse>
                              {% endif %}
                            </xo-animate>
                          {% endif %}
                        {% endif %}
                      {% else %}
                        {% comment %} This is content before the first heading {% endcomment %}
                        {% if section_stripped != blank %}
                          <xo-animate xo-cascade class='accordion-section__item'>
                            <xo-collapse-trigger class='accordion-section__trigger' xo-name='desc-intro-{{ block.id }}'>
                              <div class='accordion-section__trigger-content'>
                                <h3 class='accordion-section__heading'>Description</h3>
                              </div>
                              <div class='accordion-section__trigger-icon'>
                                {%- render 'icon', name: 'plus2', icon_size: '20', color: 'rgba(var(--color-foreground))' -%}
                              </div>
                            </xo-collapse-trigger>
                            <xo-collapse xo-name='desc-intro-{{ block.id }}'>
                              <div class='accordion-section__content xo-collapse-style2__content xo-content'>
                                {{ section_stripped }}
                              </div>
                            </xo-collapse>
                          </xo-animate>
                        {% endif %}
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                {% else %}
                  {% comment %} No headings found - show as single accordion item or regular display {% endcomment %}
                  {% assign use_mini_description = block.settings.use_mini_description %}
                  
                  {% if use_mini_description %}
                    {% comment %} Mini Description Logic {% endcomment %}
                    {% assign mini_description = blank %}
                    {% if block.settings.custom_mini_description != blank %}
                      {% assign mini_description = block.settings.custom_mini_description %}
                    {% elsif product.metafields.custom.mini_description != blank %}
                      {% assign mini_description = product.metafields.custom.mini_description %}
                    {% else %}
                      {% assign truncation_method = block.settings.truncation_method | default: 'words' %}
                      {% assign truncation_length = block.settings.truncation_length | default: 50 %}
                      {% assign mini_description = description_text_plain | truncatewords: truncation_length %}
                    {% endif %}
                    
                    {% if mini_description != blank %}
                      <div class='xo-product-info-content__description-wrapper'>
                        <div class='xo-product-info-content__description xo-product-info-content__description--mini'>
                          {{ mini_description }}
                        </div>
                      </div>
                    {% endif %}
                  {% endif %}
                  
                  {% comment %} Show full description as accordion item {% endcomment %}
                  <xo-animate xo-cascade class='accordion-section__item'>
                    <xo-collapse-trigger class='accordion-section__trigger' xo-name='desc-full-{{ block.id }}'>
                      <div class='accordion-section__trigger-content'>
                        <h3 class='accordion-section__heading'>Product Description</h3>
                      </div>
                      <div class='accordion-section__trigger-icon'>
                        {%- render 'icon', name: 'plus2', icon_size: '20', color: 'rgba(var(--color-foreground))' -%}
                      </div>
                    </xo-collapse-trigger>
                    <xo-collapse xo-name='desc-full-{{ block.id }}'>
                      <div class='accordion-section__content xo-collapse-style2__content xo-content'>
                        {{ description_html }}
                      </div>
                    </xo-collapse>
                  </xo-animate>
                {% endif %}
              {% endif %}
            </xo-animate>
          {% endunless %}

        {% when 'visitor' %}
          <xo-animate
            xo-cascade
            {{ block.shopify_attributes }}
            style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
          >
            {% render 'visitor', max: block.settings.visitor_max, min: block.settings.visitor_min, change: block.settings.visitor_change, text: block.settings.visitor_text %}
          </xo-animate>

        {% when 'offer' %}
          <xo-animate
            xo-cascade
            {{ block.shopify_attributes }}
            style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
          >
            {% render 'offer',
              title: block.settings.offer_title,
              content1: block.settings.offer_content1,
              content2: block.settings.offer_content2,
              content3: block.settings.offer_content3,
              color: block.settings.offer_color
            %}
          </xo-animate>

        {% when 'countdown_stock' %}
          <xo-animate
            xo-cascade
            {{ block.shopify_attributes }}
            style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
          >
            {% render 'countdown-stock', product: product, block: block %}
          </xo-animate>

        {% when 'buy_othersite' %}
          <xo-animate
            class='xo-product-info-content__buy-othersite'
            xo-cascade
            {{ block.shopify_attributes }}
            style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
          >
            <a href='{{ block.settings.link }}'>
              <span>{{ block.settings.buy_othersite_title }}</span>
              {% if block.settings.image != blank %}
                <div class='xo-product-info-content__buy-logo' style='--width:{{ block.settings.image_width | append: 'px' }}'>
                  {% render 'image', image: block.settings.image %}
                </div>
              {% endif %}
            </a>
          </xo-animate>

        {% when 'trustbadge' %}
          <xo-animate
            xo-cascade
            {{ block.shopify_attributes }}
            style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
          >
            {% render 'trustbadge',
              position: block.settings.trustbadge_position,
              background_color: block.settings.trustbadge_background,
              title: block.settings.trustbadge_heading,
              width: block.settings.trustbadge_width,
              image: block.settings.trustbadge_image
            %}
          </xo-animate>

        {% when 'pickup' %}
          {% if gift_card_recipient_feature_active == false %}
            {% assign pick_up_availabilities = product.selected_or_first_available_variant.store_availabilities | where: 'pick_up_enabled', true %}
            {% assign featured_media = product.selected_or_first_available_variant.featured_media %}
            {% comment %}
            <xo-animate
              xo-cascade
              {{ block.shopify_attributes }}
              style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
            >
              {% render 'pickup-availability-item', pick_up_availabilities: pick_up_availabilities %}
            </xo-animate>
            {% endcomment %}
            <xo-modal
              style='z-index: 9999;'
              xo-portal
              xo-name='pickup-availability'
              xo-animate='slide-left'
              xo-placement='top-right'
            >
              {% capture pickup_availability_list %}
              {% render 'pickup-availability-list', pick_up_availabilities: pick_up_availabilities %}
            {% endcapture %}
              {% capture image %}
              <xo-product-will-change xo-unique-id='product-info-media-{{ product.id }}' class='xo-product-info-content__pickup-image'>
                {% if featured_media != null %}
                  {% render 'media', type: 'image', media: featured_media.preview_image, media_aspect_ratio: media_aspect_ratio %}
                {% else %}
                  {% render 'media', type: 'image', media: product.featured_media.preview_image, media_aspect_ratio: media_aspect_ratio %}
                {% endif %}
              </xo-product-will-change>  
            {% endcapture %}
              {% capture variant %}
              {% if product.options_with_values.size > 0 and product.options_with_values[0].name != 'Title' %}
              <div class='xo-product-info-content__variants xo-product-info-content__variants--header'>
                {%- assign options_limit_header = 5 -%}
                {%- for option in product.options_with_values limit: options_limit_header -%}
                  <div class='xo-product-info-content__header-variant'>
                    <span style='font-weight:500'>{{ option.name | escape }}: </span>
                    <xo-product-variant-selected xo-name='{{ option.name }}' class='xo-product-info-variant__name'>
                      {{- option.selected_value -}}
                    </xo-product-variant-selected>
                  </div>
                {%- endfor -%}
              </div>
            {% endif %}
            {% endcapture %}
              {% capture price %}
            <xo-product-will-change xo-unique-id='product-price-{{ product.id }}'>
              {% render 'price', product: product, use_variant: true, style:'small' %}
              {% if cart.taxes_included == true %}
                <span>{{ 'products.product.price.include_tax' | t }}</span>
              {% endif %}
            </xo-product-will-change>
          {% endcapture %}
              {% assign title = product.title | escape %}
              {% render 'modal-pickup',
                title: title,
                image: image,
                price: price,
                variant: variant,
                content: pickup_availability_list,
                width: '42.5rem',
                full_height: true,
                title_size: '2rem',
                title_class: 'xo-line-2',
                header_separator: true,
                animate: true
              %}
            </xo-modal>
          {% endif %}

        {% when 'shipping' %}
          <xo-animate
            xo-cascade
            {{ block.shopify_attributes }}
            style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
          >
            {% render 'shipping',
              show_delivery: block.settings.show_delivery,
              delivery: block.settings.delivery,
              show_return: block.settings.show_return,
              return: block.settings.return,
              use_policy_content: block.settings.use_policy_content,
              use_accordion: block.settings.use_accordion,
              use_modal: block.settings.use_modal,
              truncate_length: block.settings.truncate_length,
              modal_width: block.settings.modal_width
            %}
          </xo-animate>

        {% when 'text' %}
          {% case block.settings.text_style %}
            {% when 'capitalize' %}
              {% assign text_style = 'capitalize' %}
            {% when 'uppercase' %}
              {% assign text_style = 'uppercase' %}
            {% else %}
              {% assign text_style = 'unset' %}
          {% endcase %}
          <xo-animate
            xo-cascade
            {{ block.shopify_attributes }}
            style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
          >
            <p style='text-transform:{{ text_style }}'>{{ block.settings.text }}</p>
          </xo-animate>

        {% when 'richtext' %}
          <xo-animate
            xo-cascade
            {{ block.shopify_attributes }}
            style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
          >
            {{ block.settings.richtext }}
          </xo-animate>

        {% when 'collapse' %}
          <xo-animate
            xo-cascade
            {{ block.shopify_attributes }}
            style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
          >
            {% render 'collapse-style2', 
              title: block.settings.heading, 
              content: block.settings.content, 
              content_liquid: block.settings.content_liquid,
              use_modal: block.settings.use_modal,
              truncate_length: block.settings.truncate_length,
              modal_width: block.settings.modal_width,
              block_id: block.id
            %}
          </xo-animate>

        {% when 'image' %}
          <xo-animate
            xo-cascade
            {{ block.shopify_attributes }}
            style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
          >
            <a
              href='{%- if block.settings.link != blank -%}{{ block.settings.link }}{%- else -%}#{%- endif -%}'
              class='xo-product-info-content__image'
            >
              {%- if block.settings.image != blank -%}
                {% render 'image', image: block.settings.image %}
              {%- else -%}
                {% comment %} Remote asset removed - use Shopify CDN asset instead {% endcomment %}
                {% comment %}<img src='https://landing.shopilaunch.com/starter/productdetail_banner.jpg' width='1200' height='628' alt='affiliate' is='xo-lazyload' loading='lazy'>{% endcomment %}
              {%- endif -%}
            </a>
          </xo-animate>

        {% when 'product_random_text' %}
          <xo-animate
            xo-cascade
            {{ block.shopify_attributes }}
            style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
          >
            {% render 'product-random-text', number1: block.settings.number1, number2: block.settings.number2 %}
          </xo-animate>

        {% when 'addon_buttons' %}
          <xo-animate
            xo-cascade
            {{ block.shopify_attributes }}
            style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
          >
            {% render 'addon-buttons', block: block %}
          </xo-animate>

        {% when 'product_meta_info' %}
          <xo-animate
            xo-cascade
            {{ block.shopify_attributes }}
            style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
          >
            {% render 'product-meta-info', disable1: block.settings.disable1, disable2: block.settings.disable2 %}
          </xo-animate>

        {% when 'liquid' %}
          <div {{ block.shopify_attributes }} style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'>
            {% if block.settings.liquid contains 'name="properties[' or block.settings.liquid contains "name='properties[" %}
              <xo-product-property>{{ block.settings.liquid }}</xo-product-property>
            {% else %}
              {{ block.settings.liquid }}
            {% endif %}
          </div>

        {% when 'complementary' %}
          <xo-animate
            xo-cascade
            class='xo-product-info-content__complementary'
            {{ block.shopify_attributes }}
            aria-label='{{ 'accessibility.complementary_products' | t }}'
            style='padding-top:{{ block.settings.padding_top | append: 'px' }}; padding-bottom:{{ block.settings.padding_bottom | append: 'px'}}'
          >
            {% if block.settings.distinct_color_scheme == true %}
              {% assign color_scheme_chosen = block.settings.product_card_color_scheme %}
            {% else %}
              {% assign color_scheme_chosen = settings.card_color_scheme %}
            {% endif %}
            {% capture complementary_content %}
              {% render 'product-recommendations',
                intent: 'complementary',
                layout: block.settings.layout,
                collapse_style: block.settings.collapse_style,
                products_to_show: block.settings.products_to_show,
                columns_desktop: '2',
                columns_mobile: '2',
                show_navigation: true,
                show_navigation_mobile: true,
                show_pagination: block.settings.show_pagination,
                show_pagination_mobile: block.settings.show_pagination_mobile,
                color_scheme_chosen: color_scheme_chosen
              %}
            {% endcapture %}
            {% if block.settings.collapse_style %}
              {% render 'collapse-style2', title: block.settings.complementary_title, content: complementary_content %}
            {% else %}
              <h3 class='xo-product-info-content__complementary-title'>{{ block.settings.complementary_title }}</h3>
              {{ complementary_content }}
            {% endif %}
          </xo-animate>
      {% endcase %}
      {% endunless %}
    {% endfor %}
  </xo-collapse-provider>
</div>
