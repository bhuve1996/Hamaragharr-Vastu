{{ 'product-description-style4.css' | asset_url | stylesheet_tag }}

<div class='product-description-style4'>
  {% if product.description != blank %}
    {{ product.description }}
  {% else %}
    {% assign no_description_text = 'products.product.no_description' | t %}
    {% if no_description_text == blank %}
      {% assign no_description_text = 'No description available.' %}
    {% endif %}
    <p>{{ no_description_text }}</p>
  {% endif %}
</div>
