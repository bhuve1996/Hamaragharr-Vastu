{% comment %}
  Renders a newsletter message when submit form

  Accepts:
  - form: {Object} Form object.
  - form_id: {String} Optional. Unique form ID for error/success element IDs (e.g. 'contact-popup-newsletter'). Default: 'ContactFooter'.

  Usage:
  {% render 'newsletter-form-message', form: form %}
  {% render 'newsletter-form-message', form: form, form_id: 'contact-popup-newsletter' %}
{% endcomment %}

{%- assign message_form_id = form_id | default: 'ContactFooter' -%}

{%- if form.errors -%}
  <small id='{{ message_form_id }}-error' class='newsletter-form-message newsletter-form-message--error' role='alert'>
    {%- render 'icon', name: 'error' -%}
    {{- form.errors.translated_fields.email | capitalize }}
    {{ form.errors.messages.email -}}
  </small>
{%- endif -%}
{%- if form.posted_successfully? -%}
  <div
    class='newsletter-form-message newsletter-form-message--success'
    id='{{ message_form_id }}-success'
    tabindex='-1'
    autofocus
    role='status'
  >
    {% render 'icon', name: 'success' -%}
    {{- 'newsletter.success' | t }}
  </div>
{%- endif -%}
