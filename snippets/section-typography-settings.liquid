{%- comment -%}
  Reusable schema block for section-level typography overrides
  Include this in any section's schema to allow typography customization
  Usage: {% render 'section-typography-settings' %}
{%- endcomment -%}
{
  "type": "header",
  "content": "Typography Settings (Override Global)"
},
{
  "type": "paragraph",
  "content": "Override global typography settings for this section. Leave empty to use global settings."
},
{
  "type": "header",
  "content": "Heading Typography"
},
{
  "type": "range",
  "id": "heading_font_size_desktop",
  "min": 1.5,
  "max": 6,
  "step": 0.1,
  "unit": "rem",
  "label": "Heading Font Size (Desktop)",
  "info": "Leave empty to use global setting"
},
{
  "type": "range",
  "id": "heading_font_size_mobile",
  "min": 1,
  "max": 4,
  "step": 0.1,
  "unit": "rem",
  "label": "Heading Font Size (Mobile)",
  "info": "Leave empty to use global setting"
},
{
  "type": "range",
  "id": "heading_line_height_desktop",
  "min": 1,
  "max": 2,
  "step": 0.1,
  "label": "Heading Line Height (Desktop)",
  "info": "Leave empty to use global setting"
},
{
  "type": "range",
  "id": "heading_line_height_mobile",
  "min": 1,
  "max": 2,
  "step": 0.1,
  "label": "Heading Line Height (Mobile)",
  "info": "Leave empty to use global setting"
},
{
  "type": "select",
  "id": "heading_font_weight_desktop",
  "label": "Heading Font Weight (Desktop)",
  "options": [
    {
      "value": "",
      "label": "Use Global Setting"
    },
    {
