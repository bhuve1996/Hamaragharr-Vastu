{% comment %}
  Renders a offer (sale product information).

  Accepts:
  - title: {String} The product to count time (optional)
  - content1: {String} The first content (optional) – used when product has no inventory or as fallback
  - content2: {String} The second content (optional)
  - content3: {String} The third content (optional)
  - color: {String} The color of offer (optional)
  - product: {Object} When passed, first line shows "X left" from inventory if tracked (optional)

  Usage:
  {% render 'offer', title: title, content1: content1, content2: content2, content3: content3, color: color, product: product %}
{% endcomment %}

{% liquid
  assign first_line = content1
  if product != blank
    assign total_quantity = 0
    assign inventory_tracked = false
    for variant in product.variants
      if variant.inventory_management != blank
        assign inventory_tracked = true
      endif
      assign total_quantity = total_quantity | plus: variant.inventory_quantity
    endfor
    if inventory_tracked
      if total_quantity > 0
        assign first_line = 'products.product.quantity_left' | t: quantity: total_quantity
      else
        assign first_line = 'products.product.out_stock' | t
      endif
    endif
  endif
%}

<div class='offer xo-product-info-content__offer'>
  <h4 class='offer__title' style='color: {{ color }};'>{{ title }}</h4>
  <ul role='list' class='offer__list'>
    <li class='offer__item'>
      {% render 'icon', name: 'caret-right', icon_size: '18', color: color %}
      <span class='offer__content' style='color:{{ color }};'>{{ first_line }}</span>
    </li>
    <li class='offer__item'>
      {% render 'icon', name: 'caret-right', icon_size: '18', color: color %}
      <span class='offer__content' style='color:{{ color }};'>{{ content2 }}</span>
    </li>
    <li class='offer__item'>
      {% render 'icon', name: 'caret-right', icon_size: '18', color: color %}
      <span class='offer__content' style='color:{{ color }};'>{{ content3 }}</span>
    </li>
  </ul>
</div>
