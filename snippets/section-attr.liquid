{% comment %}
  Renders a section attribute

  Usage:
  {% render 'section-attr' %}
{% endcomment %}

{% liquid
  assign class_name = 'xo-section xo-section--' | append: section.id | append: ' vastu-section-spacing'

  if section.settings.background_color != blank
    assign background_color = '--bg-color: ' | append: section.settings.background_color | append: ';'
  endif
  if section.settings.background_gradient != blank
    assign background_gradient = '--bg-gradient: ' | append: section.settings.background_gradient | append: ';'
  endif
  if section.settings.background_margin != null
    assign background_margin = '--margin: ' | append: section.settings.background_margin | append: ';'
  endif
  if section.settings.padding_top != null
    assign padding_top = '--pt: ' | append: section.settings.padding_top | append: ';'
  endif
  if section.settings.padding_bottom != null
    assign padding_bottom = '--pb: ' | append: section.settings.padding_bottom | append: ';'
  endif
  
  comment
    Section-level spacing overrides (desktop)
    Only output if value is > 0 (0 means use global setting)
  endcomment
  if section.settings.section_padding_top_desktop != null and section.settings.section_padding_top_desktop > 0
    assign section_padding_top_desktop = '--section-padding-top-desktop: ' | append: section.settings.section_padding_top_desktop | append: 'px;'
  endif
  if section.settings.section_padding_bottom_desktop != null and section.settings.section_padding_bottom_desktop > 0
    assign section_padding_bottom_desktop = '--section-padding-bottom-desktop: ' | append: section.settings.section_padding_bottom_desktop | append: 'px;'
  endif
  if section.settings.section_margin_top_desktop != null and section.settings.section_margin_top_desktop > 0
    assign section_margin_top_desktop = '--section-margin-top-desktop: ' | append: section.settings.section_margin_top_desktop | append: 'px;'
  endif
  if section.settings.section_margin_bottom_desktop != null and section.settings.section_margin_bottom_desktop > 0
    assign section_margin_bottom_desktop = '--section-margin-bottom-desktop: ' | append: section.settings.section_margin_bottom_desktop | append: 'px;'
  endif
  
  comment
    Section-level spacing overrides (mobile)
    Only output if value is > 0 (0 means use global setting)
  endcomment
  if section.settings.section_padding_top_mobile != null and section.settings.section_padding_top_mobile > 0
    assign section_padding_top_mobile = '--section-padding-top-mobile: ' | append: section.settings.section_padding_top_mobile | append: 'px;'
  endif
  if section.settings.section_padding_bottom_mobile != null and section.settings.section_padding_bottom_mobile > 0
    assign section_padding_bottom_mobile = '--section-padding-bottom-mobile: ' | append: section.settings.section_padding_bottom_mobile | append: 'px;'
  endif
  if section.settings.section_margin_top_mobile != null and section.settings.section_margin_top_mobile > 0
    assign section_margin_top_mobile = '--section-margin-top-mobile: ' | append: section.settings.section_margin_top_mobile | append: 'px;'
  endif
  if section.settings.section_margin_bottom_mobile != null and section.settings.section_margin_bottom_mobile > 0
    assign section_margin_bottom_mobile = '--section-margin-bottom-mobile: ' | append: section.settings.section_margin_bottom_mobile | append: 'px;'
  endif
  
  unless style
    assign style = ''
  endunless
%}

class="{{ class_name -}}
{%- if section.settings.color_scheme %} color-{{ section.settings.color_scheme }}{% endif %}" style="{{ background_color -}}
{{- background_gradient -}}
{{- background_margin -}}
{{- padding_top -}}
{{- padding_bottom -}}
{{- section_padding_top_desktop -}}
{{- section_padding_bottom_desktop -}}
{{- section_margin_top_desktop -}}
{{- section_margin_bottom_desktop -}}
{{- section_padding_top_mobile -}}
{{- section_padding_bottom_mobile -}}
{{- section_margin_top_mobile -}}
{{- section_margin_bottom_mobile }}
{{- style }}"
