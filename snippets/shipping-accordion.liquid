{% comment %}
  Renders shipping and return as Q&A accordion format
  
  Usage:
    {% render 'shipping-accordion', 
      delivery_content: delivery_content, 
      return_content: return_content,
      show_delivery: true,
      show_return: true
    %}
{% endcomment %}

<div class='shipping-accordion'>
  <xo-collapse-provider xo-duration='300'>
    {% if show_delivery and delivery_content != blank %}
      <xo-animate xo-cascade class='faq-v3__row'>
        <xo-collapse-trigger class='faq-v3__trigger'>
          <div class='faq-v3__question'>Shipping & Delivery</div>
          <div class='faq-v3__icon'>
            {%- render 'icon', name: 'plus2', icon_size: '15', color: 'rgba(var(--color-foreground))' -%}
          </div>
        </xo-collapse-trigger>
        <xo-collapse>
          <div class='faq-v3__answer'>{{ delivery_content }}</div>
        </xo-collapse>
      </xo-animate>
    {% endif %}
    
    {% if show_return and return_content != blank %}
      <xo-animate xo-cascade class='faq-v3__row'>
        <xo-collapse-trigger class='faq-v3__trigger'>
          <div class='faq-v3__question'>Returns & Exchanges</div>
          <div class='faq-v3__icon'>
            {%- render 'icon', name: 'plus2', icon_size: '15', color: 'rgba(var(--color-foreground))' -%}
          </div>
        </xo-collapse-trigger>
        <xo-collapse>
          <div class='faq-v3__answer'>{{ return_content }}</div>
        </xo-collapse>
      </xo-animate>
    {% endif %}
  </xo-collapse-provider>
</div>
