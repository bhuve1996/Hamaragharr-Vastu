{% comment %}
  Renders a discount badge

  Accepts:
  - label: {String} Label to display
  - discount: {Discount} Discount object (optional)
  - discount_allocation: {Discount} Discount object (optional)

  Usage:
  {% render 'badge-discount', label: discount_application.title %}
{% endcomment %}

<span class='xo-badge-discount'>
  {%- render 'icon', name: 'discount', size: '1.8rem' -%}
  <span>
    {{- label -}}
    {% if discount.total_allocated_amount %}
      {%- assign discount_amount = discount.total_allocated_amount | money -%}
      {%- assign discount_amount = discount_amount | replace: 'Rs.', '₹' | replace: 'Rs ', '₹ ' | replace: 'INR', '₹' | replace: '$', '₹' | replace: 'USD', 'INR' -%}
      (-{{ discount_amount }})
    {% endif %}
    {% if discount_allocation.amount %}
      {%- assign allocation_amount = discount_allocation.amount | money -%}
      {%- assign allocation_amount = allocation_amount | replace: 'Rs.', '₹' | replace: 'Rs ', '₹ ' | replace: 'INR', '₹' | replace: '$', '₹' | replace: 'USD', 'INR' -%}
      (-{{ allocation_amount }})
    {% endif %}
  </span>
</span>
