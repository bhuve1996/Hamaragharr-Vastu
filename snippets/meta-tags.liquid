{% comment %}
  Renders a meta tags

  Usage:
  {% render 'meta-tags' %}
{% endcomment %}

{%- liquid
  # Determine proper title for OG tags
  assign og_title = page_title | default: shop.name
  
  if template.name == 'collection' and collection
    if current_tags
      assign og_title = current_tags | join: ' + ' | append: ' - ' | append: collection.title
    else
      assign og_title = collection.title
    endif
    if collection.description != blank
      assign og_description = collection.description | strip_html | truncate: 160
    endif
  elsif template.name == 'product' and product
    assign og_title = product.title
    if product.description != blank
      assign og_description = product.description | strip_html | truncate: 160
    endif
  elsif template.name == 'article' and article
    assign og_title = article.title
    if article.excerpt != blank
      assign og_description = article.excerpt | strip_html | truncate: 160
    elsif article.content != blank
      assign og_description = article.content | strip_html | truncate: 160
    endif
  elsif template.name == 'blog' and blog
    if current_tags
      assign og_title = current_tags | join: ' + ' | append: ' - ' | append: blog.title
    else
      assign og_title = blog.title
    endif
    if blog.description != blank
      assign og_description = blog.description | strip_html | truncate: 160
    endif
  elsif template.name == 'page' and page
    assign og_title = page.title
    if page.content != blank
      assign og_description = page.content | strip_html | truncate: 160
    endif
  endif
  
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = og_description | default: page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
  
  # Set proper image for collections
  if template.name == 'collection' and collection.featured_image
    assign page_image = collection.featured_image
  elsif template.name == 'product' and product.featured_media
    assign page_image = product.featured_media.preview_image
  elsif template.name == 'article' and article.image
    assign page_image = article.image
  elsif template.name == 'page' and page.image
    assign page_image = page.image
  endif
%}

<meta property='og:site_name' content='{{ shop.name }}'>
<meta property='og:url' content='{{ og_url }}'>
<meta property='og:title' content='{{ og_title | escape }}'>
<meta property='og:type' content='{{ og_type }}'>
<meta property='og:description' content='{{ og_description | escape }}'>

{%- if page_image -%}
  <meta property='og:image' content='https:{{ page_image | image_url: width: 1200 }}'>
  <meta property='og:image:secure_url' content='https:{{ page_image | image_url: width: 1200 }}'>
  <meta property='og:image:width' content='1200'>
  <meta property='og:image:height' content='{{ page_image.height | times: 1200 | divided_by: page_image.width }}'>
  <meta property='og:image:alt' content='{{ og_title | escape }}'>
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property='og:price:amount' content='{{ product.price | money_without_currency | strip_html }}'>
  <meta property='og:price:currency' content='{{ cart.currency.iso_code }}'>
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name='twitter:site' content='{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}'>
{%- endif -%}
<meta name='twitter:card' content='summary_large_image'>
<meta name='twitter:title' content='{{ og_title | escape }}'>
<meta name='twitter:description' content='{{ og_description | escape }}'>
{%- if page_image -%}
  <meta name='twitter:image' content='https:{{ page_image | image_url: width: 1200 }}'>
  <meta name='twitter:image:alt' content='{{ og_title | escape }}'>
{%- endif -%}
