{% comment %}
  Renders FAQ structured data (Schema.org).

  Accepts:
  - section: {Object} Section object with FAQ blocks
  - product: {Object} Optional. When set (product template), only FAQs visible for that product are included.
{% endcomment %}

{%- if settings.seo_enable_faq_schema != false -%}
  {%- liquid
    assign faq_count = 0
    assign blocks_limit_schema = 20
    for block in section.blocks limit: blocks_limit_schema
      if block.type == 'question' and block.settings.question != blank and block.settings.answer != blank
        if product != blank
          capture vis
            render 'product-faq-should-display', block: block, product: product
          endcapture
          assign vis = vis | strip
          if vis == '1'
            assign faq_count = faq_count | plus: 1
          endif
        else
          assign faq_count = faq_count | plus: 1
        endif
      endif
    endfor
  -%}

  {%- if faq_count > 0 -%}
    <script type='application/ld+json'>
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign first_item = true -%}
        {%- for block in section.blocks limit: blocks_limit_schema -%}
          {%- if block.type == 'question' and block.settings.question != blank and block.settings.answer != blank -%}
            {%- if product != blank -%}
              {%- capture vis2 -%}{% render 'product-faq-should-display', block: block, product: product %}{%- endcapture -%}
              {%- assign vis2 = vis2 | strip -%}
            {%- else -%}
              {%- assign vis2 = '1' -%}
            {%- endif -%}
            {%- if vis2 == '1' -%}
            {%- unless first_item -%},{%- endunless -%}
            {%- assign first_item = false -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | strip_html | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | strip_html | json }}
              }
            }
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
    </script>
  {%- endif -%}
{%- endif -%}
