{% comment %}
  Renders a search input with predictive search results

  Accepts:
  - value: {String} The value of the search input
  - label: {String} The label for the search input

  Usage:
  {% render 'predictive-search', value: '' %}
{% endcomment %}

{% liquid
  unless value
    assign value = ''
  endunless
  assign pages = 'templates.search.pages' | t
  assign collections = 'templates.search.collections' | t
  assign products = 'templates.search.products' | t
  assign articles = 'templates.search.articles' | t
%}

<div
  class='xo-predictive-search'
  data-locales='
    {
      pages: "{{ pages }}",
      collections: "{{ collections }}",
      products: "{{ products }}",
      articles: "{{ articles }}"
    }
  '
>
  <div class='xo-predictive-search__input'>
    <xo-grid class='xo-predictive-search__box'>
      <div style='--xs:12; --lg:12' class='xo-predictive-search__center'>
        {% render 'field-input', value: value, name: 'q', placeholder: label, attr: "id='predictive-search' data-predictive-search-input='header'", block: true %}
        <div class='xo-predictive-search__clear' data-predictive-search-reset='header' aria-label='{{ 'accessibility.close' | t }}'>
          {% render 'icon', name: 'close', icon_size: '13' %}
        </div>
      </div>
    </xo-grid>
  </div>
  {%- if settings.predictive_search_enabled -%}
    <div class='xo-predictive-search__result xo-scrollbar' data-predictive-search-result='header'></div>
  {%- endif -%}
</div>

<script>
  var show_currency_code = {{ settings.currency_code_enabled | json }};
  var show_vendor = {{ settings.predictive_search_show_vendor | json }};
  var show_price = {{ settings.predictive_search_show_price | json }};
  var currency_symbol = {{ cart.currency.symbol | json }}
  var currency_code = {{ cart.currency.iso_code | json }}

  // Show only products in predictive search / suggested list - hide pages, collections, articles
  (function() {
    var resultSelector = '.xo-predictive-search__result[data-predictive-search-result="header"]';

    function hideNonProductSections(container) {
      if (!container) return;
      // Hide sections by data-section (pages, collections, articles)
      container.querySelectorAll('[data-section], h3, h4, .predictive-search__section').forEach(function(section) {
        var sectionType = (section.getAttribute('data-section') || section.textContent || '').trim().toLowerCase();
        var nextSibling = section.nextElementSibling;
        var isProducts = sectionType === 'products' || (nextSibling && nextSibling.querySelector('a[href*="/products/"]'));
        var isNonProduct = sectionType === 'pages' || sectionType === 'collections' || sectionType === 'articles' ||
          section.querySelector('a[href*="/pages/"]') || section.querySelector('a[href*="/blogs/"]') || section.querySelector('a[href*="/articles/"]') ||
          (nextSibling && (nextSibling.querySelector('a[href*="/pages/"]') || nextSibling.querySelector('a[href*="/blogs/"]') || nextSibling.querySelector('a[href*="/articles/"]')));
        if (!isNonProduct) return;
        if (isProducts) return;
        section.style.display = 'none';
        if (nextSibling && !nextSibling.querySelector('a[href*="/products/"]')) {
          nextSibling.style.display = 'none';
        }
      });
      // Hide by heading text (suggested list section titles)
      container.querySelectorAll('h3, h4').forEach(function(heading) {
        var text = (heading.textContent || '').trim().toLowerCase();
        if (text === 'pages' || text === 'collections' || text === 'articles') {
          heading.style.display = 'none';
          var list = heading.nextElementSibling;
          if (list) list.style.display = 'none';
        }
      });
      // Hide individual non-product links
      container.querySelectorAll('a[href*="/pages/"], a[href*="/blogs/"], a[href*="/articles/"]').forEach(function(link) {
        var item = link.closest('li, [data-predictive-search-type], .predictive-search__item');
        (item || link).style.display = 'none';
      });
      // Hide collection-only links (not /products/ links)
      container.querySelectorAll('a[href*="/collections/"]').forEach(function(link) {
        var href = (link.getAttribute('href') || '').split('?')[0];
        if (/\/collections\/[^/]+\/?$/.test(href)) {
          var item = link.closest('li, [data-predictive-search-type], .predictive-search__item');
          (item || link).style.display = 'none';
        }
      });
    }

    function runFilter() {
      var container = document.querySelector(resultSelector);
      if (container) hideNonProductSections(container);
    }

    function setupObserver(container) {
      if (!container || container._predictiveFilterObserved) return;
      container._predictiveFilterObserved = true;
      var observer = new MutationObserver(function() {
        hideNonProductSections(container);
      });
      observer.observe(container, { childList: true, subtree: true });
      hideNonProductSections(container);
    }

    function init() {
      var container = document.querySelector(resultSelector);
      if (container) {
        setupObserver(container);
        hideNonProductSections(container);
      }
      setTimeout(runFilter, 50);
      setTimeout(runFilter, 150);
      setTimeout(runFilter, 400);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    document.addEventListener('DOMContentLoaded', function() {
      var searchModal = document.querySelector('xo-modal.search');
      if (searchModal) {
        var modalObserver = new MutationObserver(function(mutations) {
          mutations.forEach(function(mutation) {
            if (mutation.type === 'attributes' && mutation.attributeName === 'xo-active' && searchModal.hasAttribute('xo-active')) {
              init();
            }
          });
        });
        modalObserver.observe(searchModal, { attributes: true, attributeFilter: ['xo-active'] });
      }
    });
  })();
</script>
