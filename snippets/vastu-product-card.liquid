{% comment %}
  Unified Product Card Snippet
  Works in both carousel and grid contexts
  Usage: {% render 'vastu-product-card', product: product, section: section, settings: settings %}
{% endcomment %}

{%- liquid
  assign current_product = product
  assign card_title_size = settings.card_title_font_size | default: 1.5
  assign card_price_size = settings.card_price_font_size | default: 1.2
  assign button_text = settings.button_text_add_to_cart | default: 'Add to Cart'
  assign section_id = section.id | default: 'default'
  assign show_wishlist = settings.show_wishlist | default: true
-%}

<div class='vastu-product-card'>
  <xo-product xo-product-id='{{ current_product.id }}' xo-section-id='{{ section_id }}' xo-product-information>
    {% comment %} Wishlist button - top left (outside link to prevent bubbling) {% endcomment %}
    {% if show_wishlist %}
      <div class='vastu-product-card__wishlist-container'>
        {% comment %} add to wishlist {% endcomment %}
        <xo-products-fetcher-add xo-type="wishlist" class="xo-product-card__wishlist">
          <xo-tooltip xo-title='{{ 'products.product.add_to_wishlist' | t }}' class="xo-product-card__icon xo-product-card__icon-wishlist" xo-added>
            <button type="button" class="vastu-wishlist-btn" aria-label='{{ 'products.product.add_to_wishlist' | t }}'>
              {% render 'icon', name: 'heart', icon_size: '20', color: '#000' %}
            </button>
          </xo-tooltip>
        </xo-products-fetcher-add>
        {% comment %} remove wishlist {% endcomment %}
        <xo-products-fetcher-add xo-type="wishlist" class="xo-product-card__wishlist">
          <xo-tooltip xo-title='{{ 'products.product.remove_from_wishlist' | t }}' class="xo-product-card__icon xo-product-card__icon-wishlist" xo-removed>
            <button type="button" class="vastu-wishlist-btn" aria-label='{{ 'products.product.remove_from_wishlist' | t }}'>
              {% render 'icon', name: 'heart', icon_size: '20', color: '#fff' %}
            </button>
          </xo-tooltip>
        </xo-products-fetcher-add>
      </div>
    {% endif %}
    <a href='{{ current_product.url }}' class='vastu-product-card__link'>
      <div class='vastu-product-card__image hover-style--scale-up'>
        {% if current_product.price != blank %}
          {%- assign price_formatted = current_product.price | money -%}
          {%- assign price_formatted = price_formatted | replace: 'Rs.', '₹' | replace: 'Rs ', '₹ ' | replace: 'INR', '₹' | replace: '$', '₹' | replace: 'USD', 'INR' -%}
          <div class='vastu-product-card__price' style='--card-price-size: {{ card_price_size }}rem;'>
            {{ price_formatted }}
          </div>
        {% endif %}
        {% if current_product.featured_image != blank %}
          {% render 'image', image: current_product.featured_image, media_aspect_ratio: '1/1' %}
        {% else %}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
      <div class='vastu-product-card__content'>
        {% assign display_title = current_product.title | replace: " and ", " & " | replace: "seven", "7" | replace: "Seven", "7" %}
        <h4 class='vastu-product-card__title' style='--card-title-size: {{ card_title_size }}rem;' title='{{ display_title | escape }}'>{{ display_title }}</h4>
      </div>
    </a>
    {% if current_product.variants.size > 1 %}
      <div class='vastu-product-card__add-to-cart'>
        <xo-modal-trigger xo-name='product-variant-modal-{{ current_product.id }}-{{ section.id }}'>
          {% render 'button', text: button_text, style: 'secondary', mode: 'light', size: 'md', block: true %}
        </xo-modal-trigger>
      </div>
    {% else %}
      <div class='vastu-product-card__add-to-cart'>
        <xo-cart-add {% if current_product.selected_or_first_available_variant.available == false %}xo-disabled{% endif %}>
          {% render 'button', text: button_text, style: 'secondary', mode: 'light', size: 'md', block: true %}
        </xo-cart-add>
      </div>
    {% endif %}
    {% if current_product.variants.size > 1 %}
      {% render 'product-variant-modal', product: current_product, variant_modal_placement: 'center', section: section %}
      {% comment %} product-data is already rendered inside product-variant-modal {% endcomment %}
    {% else %}
      {% comment %} Minimal product-data for single variant products (only first variant needed) {% endcomment %}
      <xo-product-data>
        <script type='application/json'>
          {
            "id": {{ current_product.id }},
            "handle": {{ current_product.handle | json }},
            "variants": [{
              "id": {{ current_product.selected_or_first_available_variant.id }},
              "price": {{ current_product.selected_or_first_available_variant.price }},
              "available": {{ current_product.selected_or_first_available_variant.available }}
            }],
            "available": {{ current_product.available }}
          }
        </script>
      </xo-product-data>
    {% endif %}
  </xo-product>
</div>

<script>
  // Prevent product link from intercepting wishlist button clicks
  (function() {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupWishlistClickHandler);
    } else {
      setupWishlistClickHandler();
    }
    
    function setupWishlistClickHandler() {
      document.querySelectorAll('.vastu-product-card').forEach(function(card) {
        const wishlistContainer = card.querySelector('.vastu-product-card__wishlist-container');
        const productLink = card.querySelector('.vastu-product-card__link');
        
        if (wishlistContainer && productLink && !wishlistContainer.dataset.handlerAdded) {
          wishlistContainer.dataset.handlerAdded = 'true';
          
          // Stop clicks on wishlist from propagating to the link
          wishlistContainer.addEventListener('click', function(e) {
            e.stopPropagation();
            e.stopImmediatePropagation();
          }, true); // Use capture phase
          
          // Prevent link from navigating when clicking wishlist
          productLink.addEventListener('click', function(e) {
            const clickedElement = e.target;
            const isWishlistClick = clickedElement.closest('.vastu-product-card__wishlist-container') ||
                                   clickedElement.closest('xo-products-fetcher-add') ||
                                   clickedElement.closest('xo-tooltip') ||
                                   clickedElement.closest('.xo-product-card__wishlist');
            
            if (isWishlistClick) {
              e.preventDefault();
              e.stopPropagation();
              e.stopImmediatePropagation();
              return false;
            }
          }, false);
        }
      });
    }
  })();
</script>

