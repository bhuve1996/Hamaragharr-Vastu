{%- liquid
  assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
  assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
  assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
%}

{% style %}
  {% if settings.font_body_selection == 'shopify_fonts' %}
    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
  {% endif %}
  {% if settings.font_heading_selection == 'shopify_fonts' %}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
  {% endif %}
  {% if settings.font_custom_selection == 'shopify_fonts' %}
    {{ settings.type_custom_font | font_face: font_display: 'swap' }}
  {% endif %}

    {% for scheme in settings.color_schemes -%}
      {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
      {% if forloop.index == 1 -%}
        :root,
      {%- endif %}
      .color-{{ scheme.id }} {
        --color-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
      {% if scheme.settings.background_gradient != empty %}
        --gradient-background: {{ scheme.settings.background_gradient }};
      {% else %}
        --gradient-background: {{ scheme.settings.background }};
      {% endif %}
      --color-accent: {{ scheme.settings.accent.red }},{{ scheme.settings.accent.green }},{{ scheme.settings.accent.blue }};
      --color-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
      --color-shadow: {{ scheme.settings.shadow.red }},{{ scheme.settings.shadow.green }},{{ scheme.settings.shadow.blue }};
      --color-border: {{ scheme.settings.border.red }},{{ scheme.settings.border.green }},{{ scheme.settings.border.blue }};
      --color-button: {{ scheme.settings.button.red }},{{ scheme.settings.button.green }},{{ scheme.settings.button.blue }};
      --color-button-text: {{ scheme.settings.button_label.red }},{{ scheme.settings.button_label.green }},{{ scheme.settings.button_label.blue }};
      --color-secondary-button: {{ scheme.settings.secondary_button.red }},{{ scheme.settings.secondary_button.green }},{{ scheme.settings.secondary_button.blue }};
      --color-secondary-button-text: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
      --color-tertiary-button: {{ scheme.settings.tertiary_button.red }},{{ scheme.settings.tertiary_button.green }},{{ scheme.settings.tertiary_button.blue }};
      --color-tertiary-button-text: {{ scheme.settings.tertiary_button_label.red }},{{ scheme.settings.tertiary_button_label.green }},{{ scheme.settings.tertiary_button_label.blue }};
      --color-gray-button: {{ scheme.settings.gray_button.red }},{{ scheme.settings.gray_button.green }},{{ scheme.settings.gray_button.blue }};
      --color-gray-button-text: {{ scheme.settings.gray_button_label.red }},{{ scheme.settings.gray_button_label.green }},{{ scheme.settings.gray_button_label.blue }};
      --color-dark-button: {{ scheme.settings.dark_button.red }},{{ scheme.settings.dark_button.green }},{{ scheme.settings.dark_button.blue }};
      --color-dark-button-text: {{ scheme.settings.dark_button_label.red }},{{ scheme.settings.dark_button_label.green }},{{ scheme.settings.dark_button_label.blue }};
      --color-light-button: {{ scheme.settings.light_button.red }},{{ scheme.settings.light_button.green }},{{ scheme.settings.light_button.blue }};
      --color-light-button-text: {{ scheme.settings.light_button_label.red }},{{ scheme.settings.light_button_label.green }},{{ scheme.settings.light_button_label.blue }};
      --color-link: {{ scheme.settings.button_label.red }},{{ scheme.settings.button_label.green }},{{ scheme.settings.button_label.blue }};
      --color-badge-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
      --color-badge-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
      --color-badge-border: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
      --payment-terms-background-color: rgb({{ scheme.settings.background.rgb }});
    }
    {% endfor %}

    {{ scheme_classes | prepend: 'body' }} {
      color: rgba(var(--color-foreground), 0.75);
      background-color: rgb(var(--color-background));
    }

    :root {
      --font-body-desktop-size: 1.6rem;
      --font-body-mobile-size: 1.5rem;
      --font-body-family: {% if settings.font_body_selection == 'shopify_fonts' %}{{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }}
      {% else %}{{ settings.font_body_selection }} {% endif %}, san-serif;
      --font-body-style: {{ settings.font_body_style }};
      --font-body-weight: {{ settings.font_body_weight }};
      --font-body-weight-bold: {{ settings.font_body_weight }};
                           /* HEADING */
      --font-heading-family: {% if settings.font_heading_selection == 'shopify_fonts' %}{{ settings.type_header_font.family }}, {{settings.type_header_font.fallback_families }}{% else %}{{ settings.font_heading_selection }} {% endif %}, san-serif;
      --font-heading-style: {{ settings.font_heading_style }};
      --font-heading-weight: {{ settings.font_heading_weight }};
      --font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
      --font-heading-scale: {{ settings.heading_scale | times: 1.0 | divided_by: settings.body_scale }};
      /* Fix for new basehtml */
      --font-body-line-height: calc(1 + 0.8 / var(--font-body-scale));
                            /* CUSTOM */
      --font-custom-family: {% if settings.font_custom_selection == 'shopify_fonts' %}{{ settings.type_custom_font.family }}, {{settings.type_custom_font.fallback_families }}{% else %}{{ settings.font_custom_selection }} {% endif %}, san-serif;
      --font-custom-weight: {{ settings.font_custom_weight }};

      --media-padding: {{ settings.media_padding }}px;
      --media-border-opacity: {{ settings.media_border_opacity | divided_by: 100.0 }};
      --media-border-width: {{ settings.media_border_thickness }}px;
      --media-radius: {{ settings.media_radius }}px;
      --media-shadow-opacity: {{ settings.media_shadow_opacity | divided_by: 100.0 }};
      --media-shadow-horizontal-offset: {{ settings.media_shadow_horizontal_offset }}px;
      --media-shadow-vertical-offset: {{ settings.media_shadow_vertical_offset }}px;
      --media-shadow-blur-radius: {{ settings.media_shadow_blur }}px;
      
      /* Homepage section spacing - configurable via theme settings or inline style */
      --homepage-section-spacing: {% if settings.spacing_sections > 0 %}{{ settings.spacing_sections }}px{% else %}64px{% endif %};
      --homepage-section-spacing-mobile: {% if settings.spacing_sections > 0 %}{{ settings.spacing_sections }}px{% else %}64px{% endif %};
      --homepage-section-spacing-tablet: {% if settings.spacing_sections > 0 %}{{ settings.spacing_sections }}px{% else %}64px{% endif %};
      
      /* Homepage section padding - configurable via theme settings or inline style */
      --homepage-section-padding-top: 0px;
      --homepage-section-padding-bottom: 0px;
      --homepage-section-padding-top-mobile: 0px;
      --homepage-section-padding-bottom-mobile: 0px;
      --homepage-section-padding-top-tablet: 0px;
      --homepage-section-padding-bottom-tablet: 0px;
      
      /* Homepage heading settings - global defaults */
      --homepage-heading-font-size: {{ settings.homepage_heading_font_size | default: 3.5 }}rem;
      --homepage-heading-font-weight: {{ settings.homepage_heading_font_weight | default: 700 }};
      --homepage-heading-color: {{ settings.homepage_heading_color | default: '#000000' }};
      --homepage-heading-text-transform: {{ settings.homepage_heading_text_transform | default: 'uppercase' }};
      --homepage-heading-line-height: {{ settings.homepage_heading_line_height | default: 1.2 }};
      --homepage-heading-margin-bottom-desktop: {{ settings.homepage_heading_margin_bottom_desktop | default: 48 }}px;
      --homepage-heading-margin-bottom-mobile: {{ settings.homepage_heading_margin_bottom_mobile | default: 32 }}px;
      --homepage-heading-underline-color: {{ settings.homepage_heading_underline_color | default: '#473855' }};
      --homepage-heading-underline-width: {{ settings.homepage_heading_underline_width | default: 80 }}px;
      --homepage-heading-underline-height: {{ settings.homepage_heading_underline_height | default: 4 }}px;
      --homepage-heading-underline-bottom-desktop: {{ settings.homepage_heading_underline_bottom_desktop | default: 24 }}px;
      --homepage-heading-underline-bottom-mobile: {{ settings.homepage_heading_underline_bottom_mobile | default: 16 }}px;
      
      /* Global section spacing - configurable via theme settings */
      --section-padding-top-desktop: {{ settings.section_padding_top_desktop | default: 16 }}px;
      --section-padding-bottom-desktop: {{ settings.section_padding_bottom_desktop | default: 16 }}px;
      --section-margin-top-desktop: {{ settings.section_margin_top_desktop | default: 16 }}px;
      --section-margin-bottom-desktop: {{ settings.section_margin_bottom_desktop | default: 16 }}px;
      --section-padding-top-mobile: {{ settings.section_padding_top_mobile | default: 12 }}px;
      --section-padding-bottom-mobile: {{ settings.section_padding_bottom_mobile | default: 12 }}px;
      --section-margin-top-mobile: {{ settings.section_margin_top_mobile | default: 12 }}px;
      --section-margin-bottom-mobile: {{ settings.section_margin_bottom_mobile | default: 12 }}px;
      
      /* Section-to-section spacing (for .section+.section selector) */
      --section-to-section-spacing-desktop: {{ settings.section_to_section_spacing_desktop | default: 0 }}px;
      --section-to-section-spacing-mobile: {{ settings.section_to_section_spacing_mobile | default: 0 }}px;
      
      /* Global button settings */
      --button-padding-left: {{ settings.button_padding_left | default: 24 }}px;
      --button-padding-right: {{ settings.button_padding_right | default: 24 }}px;
      --button-primary-bg-color: {{ settings.button_primary_bg_color | default: '#ffffff' }};
      --button-primary-text-color: {{ settings.button_primary_text_color | default: '#000000' }};
      --button-secondary-bg-color: {{ settings.button_secondary_bg_color | default: '#473855' }};
      --button-secondary-text-color: {{ settings.button_secondary_text_color | default: '#ffffff' }};
      --button-font-size: {{ settings.button_font_size | default: 1.5 }}rem;
      --button-border-radius: {{ settings.button_border_radius | default: 0 }}px;
      
      /* Button hover effects */
      --button-hover-transform-y: {{ settings.button_hover_transform_y | default: -1 }}px;
      --button-hover-box-shadow-blur: {{ settings.button_hover_box_shadow_blur | default: 12 }}px;
      --button-hover-box-shadow-spread: {{ settings.button_hover_box_shadow_spread | default: 0 }}px;
      --button-hover-opacity: {{ settings.button_hover_opacity | default: 90 | divided_by: 100.0 }};
      --button-transition-duration: {{ settings.button_transition_duration | default: 0.3 }}s;
      --button-hover-bg-color-primary: {{ settings.button_hover_bg_color_primary | default: settings.button_primary_bg_color | default: '#ffffff' }};
      --button-hover-bg-color-secondary: {{ settings.button_hover_bg_color_secondary | default: settings.button_secondary_bg_color | default: '#473855' }};
      --button-hover-text-color-primary: {{ settings.button_hover_text_color_primary | default: settings.button_primary_text_color | default: '#000000' }};
      --button-hover-text-color-secondary: {{ settings.button_hover_text_color_secondary | default: settings.button_secondary_text_color | default: '#ffffff' }};
      
      /* Primary Button Hover Effects - Individual Configurations */
      /* Type 1: Light Primary Buttons Hover */
      {% liquid
        assign light_primary_bg = settings.button_light_primary_hover_bg_color | default: '#ffffff'
        if light_primary_bg == '#ffffff' or light_primary_bg == 'ffffff' or light_primary_bg == '#fff' or light_primary_bg == 'fff'
          assign r_light_primary = 255
          assign g_light_primary = 255
          assign b_light_primary = 255
        elsif light_primary_bg == '#000000' or light_primary_bg == '000000' or light_primary_bg == '#000' or light_primary_bg == '000'
          assign r_light_primary = 0
          assign g_light_primary = 0
          assign b_light_primary = 0
        else
          assign r_light_primary = 255
          assign g_light_primary = 255
          assign b_light_primary = 255
        endif
      %}
      --button-light-primary-hover-bg-color-rgb: {{ r_light_primary }}, {{ g_light_primary }}, {{ b_light_primary }};
      --button-light-primary-hover-opacity: {{ settings.button_light_primary_hover_opacity | default: 90 | divided_by: 100.0 }};
      --button-light-primary-hover-text-color: {{ settings.button_light_primary_hover_text_color | default: '#000000' }};
      --button-light-primary-hover-transform-y: {{ settings.button_light_primary_hover_transform_y | default: -1 }}px;
      --button-light-primary-hover-box-shadow-blur: {{ settings.button_light_primary_hover_box_shadow_blur | default: 12 }}px;
      {% liquid
        assign light_primary_shadow = settings.button_light_primary_hover_box_shadow_color | default: '#000000'
        if light_primary_shadow == '#ffffff' or light_primary_shadow == 'ffffff' or light_primary_shadow == '#fff' or light_primary_shadow == 'fff'
          assign r_light_primary_shadow = 255
          assign g_light_primary_shadow = 255
          assign b_light_primary_shadow = 255
        elsif light_primary_shadow == '#000000' or light_primary_shadow == '000000' or light_primary_shadow == '#000' or light_primary_shadow == '000'
          assign r_light_primary_shadow = 0
          assign g_light_primary_shadow = 0
          assign b_light_primary_shadow = 0
        else
          assign r_light_primary_shadow = 0
          assign g_light_primary_shadow = 0
          assign b_light_primary_shadow = 0
        endif
      %}
      --button-light-primary-hover-box-shadow-color-rgb: {{ r_light_primary_shadow }}, {{ g_light_primary_shadow }}, {{ b_light_primary_shadow }};
      --button-light-primary-hover-box-shadow-opacity: {{ settings.button_light_primary_hover_box_shadow_opacity | default: 20 | divided_by: 100.0 }};
      
      /* Type 2: General Primary Buttons Hover */
      {% liquid
        assign primary_bg = settings.button_primary_hover_bg_color | default: '#ffffff'
        if primary_bg == '#ffffff' or primary_bg == 'ffffff' or primary_bg == '#fff' or primary_bg == 'fff'
          assign r_primary = 255
          assign g_primary = 255
          assign b_primary = 255
        elsif primary_bg == '#000000' or primary_bg == '000000' or primary_bg == '#000' or primary_bg == '000'
          assign r_primary = 0
          assign g_primary = 0
          assign b_primary = 0
        else
          assign r_primary = 255
          assign g_primary = 255
          assign b_primary = 255
        endif
      %}
      --button-primary-hover-bg-color-rgb: {{ r_primary }}, {{ g_primary }}, {{ b_primary }};
      --button-primary-hover-opacity: {{ settings.button_primary_hover_opacity | default: 90 | divided_by: 100.0 }};
      --button-primary-hover-text-color: {{ settings.button_primary_hover_text_color | default: '#000000' }};
      --button-primary-hover-transform-y: {{ settings.button_primary_hover_transform_y | default: -1 }}px;
      --button-primary-hover-box-shadow-blur: {{ settings.button_primary_hover_box_shadow_blur | default: 12 }}px;
      {% liquid
        assign primary_shadow = settings.button_primary_hover_box_shadow_color | default: '#000000'
        if primary_shadow == '#ffffff' or primary_shadow == 'ffffff' or primary_shadow == '#fff' or primary_shadow == 'fff'
          assign r_primary_shadow = 255
          assign g_primary_shadow = 255
          assign b_primary_shadow = 255
        elsif primary_shadow == '#000000' or primary_shadow == '000000' or primary_shadow == '#000' or primary_shadow == '000'
          assign r_primary_shadow = 0
          assign g_primary_shadow = 0
          assign b_primary_shadow = 0
        else
          assign r_primary_shadow = 0
          assign g_primary_shadow = 0
          assign b_primary_shadow = 0
        endif
      %}
      --button-primary-hover-box-shadow-color-rgb: {{ r_primary_shadow }}, {{ g_primary_shadow }}, {{ b_primary_shadow }};
      --button-primary-hover-box-shadow-opacity: {{ settings.button_primary_hover_box_shadow_opacity | default: 20 | divided_by: 100.0 }};
      
      /* Type 3: Best Seller Section Primary Buttons Hover */
      {% liquid
        assign best_seller_bg = settings.button_best_seller_primary_hover_bg_color | default: '#ffffff'
        if best_seller_bg == '#ffffff' or best_seller_bg == 'ffffff' or best_seller_bg == '#fff' or best_seller_bg == 'fff'
          assign r_best_seller = 255
          assign g_best_seller = 255
          assign b_best_seller = 255
        elsif best_seller_bg == '#000000' or best_seller_bg == '000000' or best_seller_bg == '#000' or best_seller_bg == '000'
          assign r_best_seller = 0
          assign g_best_seller = 0
          assign b_best_seller = 0
        else
          assign r_best_seller = 255
          assign g_best_seller = 255
          assign b_best_seller = 255
        endif
      %}
      --button-best-seller-primary-hover-bg-color-rgb: {{ r_best_seller }}, {{ g_best_seller }}, {{ b_best_seller }};
      --button-best-seller-primary-hover-opacity: {{ settings.button_best_seller_primary_hover_opacity | default: 90 | divided_by: 100.0 }};
      --button-best-seller-primary-hover-text-color: {{ settings.button_best_seller_primary_hover_text_color | default: '#000000' }};
      --button-best-seller-primary-hover-transform-y: {{ settings.button_best_seller_primary_hover_transform_y | default: -1 }}px;
      --button-best-seller-primary-hover-box-shadow-blur: {{ settings.button_best_seller_primary_hover_box_shadow_blur | default: 12 }}px;
      {% liquid
        assign best_seller_shadow = settings.button_best_seller_primary_hover_box_shadow_color | default: '#000000'
        if best_seller_shadow == '#ffffff' or best_seller_shadow == 'ffffff' or best_seller_shadow == '#fff' or best_seller_shadow == 'fff'
          assign r_best_seller_shadow = 255
          assign g_best_seller_shadow = 255
          assign b_best_seller_shadow = 255
        elsif best_seller_shadow == '#000000' or best_seller_shadow == '000000' or best_seller_shadow == '#000' or best_seller_shadow == '000'
          assign r_best_seller_shadow = 0
          assign g_best_seller_shadow = 0
          assign b_best_seller_shadow = 0
        else
          assign r_best_seller_shadow = 0
          assign g_best_seller_shadow = 0
          assign b_best_seller_shadow = 0
        endif
      %}
      --button-best-seller-primary-hover-box-shadow-color-rgb: {{ r_best_seller_shadow }}, {{ g_best_seller_shadow }}, {{ b_best_seller_shadow }};
      --button-best-seller-primary-hover-box-shadow-opacity: {{ settings.button_best_seller_primary_hover_box_shadow_opacity | default: 20 | divided_by: 100.0 }};
      
      /* Type 4: Featured Products Section Primary Buttons Hover */
      {% liquid
        assign featured_bg = settings.button_featured_products_primary_hover_bg_color | default: '#ffffff'
        if featured_bg == '#ffffff' or featured_bg == 'ffffff' or featured_bg == '#fff' or featured_bg == 'fff'
          assign r_featured = 255
          assign g_featured = 255
          assign b_featured = 255
        elsif featured_bg == '#000000' or featured_bg == '000000' or featured_bg == '#000' or featured_bg == '000'
          assign r_featured = 0
          assign g_featured = 0
          assign b_featured = 0
        else
          assign r_featured = 255
          assign g_featured = 255
          assign b_featured = 255
        endif
      %}
      --button-featured-products-primary-hover-bg-color-rgb: {{ r_featured }}, {{ g_featured }}, {{ b_featured }};
      --button-featured-products-primary-hover-opacity: {{ settings.button_featured_products_primary_hover_opacity | default: 90 | divided_by: 100.0 }};
      --button-featured-products-primary-hover-text-color: {{ settings.button_featured_products_primary_hover_text_color | default: '#000000' }};
      --button-featured-products-primary-hover-transform-y: {{ settings.button_featured_products_primary_hover_transform_y | default: -1 }}px;
      --button-featured-products-primary-hover-box-shadow-blur: {{ settings.button_featured_products_primary_hover_box_shadow_blur | default: 12 }}px;
      {% liquid
        assign featured_shadow = settings.button_featured_products_primary_hover_box_shadow_color | default: '#000000'
        if featured_shadow == '#ffffff' or featured_shadow == 'ffffff' or featured_shadow == '#fff' or featured_shadow == 'fff'
          assign r_featured_shadow = 255
          assign g_featured_shadow = 255
          assign b_featured_shadow = 255
        elsif featured_shadow == '#000000' or featured_shadow == '000000' or featured_shadow == '#000' or featured_shadow == '000'
          assign r_featured_shadow = 0
          assign g_featured_shadow = 0
          assign b_featured_shadow = 0
        else
          assign r_featured_shadow = 0
          assign g_featured_shadow = 0
          assign b_featured_shadow = 0
        endif
      %}
      --button-featured-products-primary-hover-box-shadow-color-rgb: {{ r_featured_shadow }}, {{ g_featured_shadow }}, {{ b_featured_shadow }};
      --button-featured-products-primary-hover-box-shadow-opacity: {{ settings.button_featured_products_primary_hover_box_shadow_opacity | default: 20 | divided_by: 100.0 }};
      
      /* Type 1: Regular buttons (without data-text attribute) */
      --button-text-regular-color: {{ settings.button_text_regular_color | default: '#ffffff' }};
      --button-text-regular-hover-color: {{ settings.button_text_regular_hover_color | default: settings.button_text_regular_color | default: '#ffffff' }};
      /* Type 2: Buttons with data-text attribute (slide-up effect) */
      /* Type 2A: Global/Regular buttons with data-text */
      --button-text-data-text-color: {{ settings.button_text_data_text_color | default: '#ffffff' }};
      --button-text-data-text-hover-color: {{ settings.button_text_data_text_hover_color | default: settings.button_text_data_text_color | default: '#ffffff' }};
      /* Type 2B: Slideshow buttons with data-text */
      --slideshow-button-text-data-text-color: {{ settings.slideshow_button_text_data_text_color | default: '#000000' }};
      --slideshow-button-text-data-text-hover-color: {{ settings.slideshow_button_text_data_text_hover_color | default: settings.slideshow_button_text_data_text_color | default: '#000000' }};
      {% comment %} RGB values for rgba usage - defaults for common colors {% endcomment %}
      {% liquid
        assign primary_bg = settings.button_primary_bg_color | default: '#ffffff'
        assign secondary_bg = settings.button_secondary_bg_color | default: '#473855'
        assign price_bg = settings.price_tag_background_color | default: '#473855'
        if primary_bg == '#ffffff' or primary_bg == 'ffffff' or primary_bg == '#fff' or primary_bg == 'fff'
          assign r1 = 255
          assign g1 = 255
          assign b1 = 255
        elsif primary_bg == '#000000' or primary_bg == '000000' or primary_bg == '#000' or primary_bg == '000'
          assign r1 = 0
          assign g1 = 0
          assign b1 = 0
        else
          assign r1 = 255
          assign g1 = 255
          assign b1 = 255
        endif
        if secondary_bg == '#473855' or secondary_bg == '473855'
          assign r2 = 71
          assign g2 = 56
          assign b2 = 85
        else
          assign r2 = 71
          assign g2 = 56
          assign b2 = 85
        endif
        if price_bg == '#473855' or price_bg == '473855'
          assign r3 = 71
          assign g3 = 56
          assign b3 = 85
        else
          assign r3 = 71
          assign g3 = 56
          assign b3 = 85
        endif
      %}
      --button-primary-bg-color-rgb: {{ r1 }}, {{ g1 }}, {{ b1 }};
      --button-secondary-bg-color-rgb: {{ r2 }}, {{ g2 }}, {{ b2 }};
      --price-tag-background-color-rgb: {{ r3 }}, {{ g3 }}, {{ b3 }};
      
      /* Global price tag settings */
      --price-tag-background-color: {{ settings.price_tag_background_color | default: '#473855' }};
      --price-tag-background-opacity: {{ settings.price_tag_background_opacity | default: 90 | divided_by: 100.0 }};
      --price-tag-text-color: {{ settings.price_tag_text_color | default: '#ffffff' }};
      --price-tag-font-size: {{ settings.price_tag_font_size | default: 1.2 }}rem;
      --price-tag-font-weight: {{ settings.price_tag_font_weight | default: 600 }};
      --price-tag-padding-top: {{ settings.price_tag_padding_top | default: 8 }}px;
      --price-tag-padding-bottom: {{ settings.price_tag_padding_bottom | default: 8 }}px;
      --price-tag-padding-left: {{ settings.price_tag_padding_left | default: 12 }}px;
      --price-tag-padding-right: {{ settings.price_tag_padding_right | default: 12 }}px;
      --price-tag-border-radius: {{ settings.price_tag_border_radius | default: 8 }}px;
      --price-tag-box-shadow-blur: {{ settings.price_tag_box_shadow_blur | default: 8 }}px;
