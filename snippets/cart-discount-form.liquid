{% comment %}
  Renders a discount code form on cart page / cart drawer.
  Submitting applies the code at checkout (redirects to checkout with discount).

  Accepts:
  - uid: {String} Unique id for the form (optional, for cart vs drawer)

  Usage:
  {% render 'cart-discount-form' %}
  {% render 'cart-discount-form', uid: 'drawer' %}
{% endcomment %}

{% liquid
  assign uid = uid | default: 'cart'
  assign form_id = 'cart-discount-form-' | append: uid
  assign input_id = 'cart-discount-code-' | append: uid
%}

<style>
  .xo-cart-discount-form { margin: 0 0 1rem; }
  .xo-cart-discount-form__title { font-weight: 600; margin: 0 0 0.5rem; font-size: 1.4rem; }
  .xo-cart-discount-form__form { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: stretch; margin: 0 0 0.25rem; }
  .xo-cart-discount-form__label { flex: 1; min-width: 0; margin: 0; }
  .xo-cart-discount-form__input { width: 100%; min-height: 4.4rem; padding: 0 1.2rem; border: 1px solid rgb(var(--color-border)); border-radius: var(--global-button-radius, 0.4rem); }
  .xo-cart-discount-form__submit { flex-shrink: 0; padding: 0 1.6rem; min-height: 4.4rem; font-size: 1.4rem; font-weight: 500; border-radius: var(--global-button-radius, 0.4rem); background: rgb(var(--color-button)); color: rgb(var(--color-button-text)); border: none; cursor: pointer; white-space: nowrap; }
  .xo-cart-discount-form__submit:hover { opacity: 0.9; }
  .xo-cart-discount-form__hint { margin: 0; font-size: 1.2rem; opacity: 0.85; }
  .xo-cart-mini-drawer-footer__border .xo-cart-discount-form__form { flex-direction: column; }
  .xo-cart-mini-drawer-footer__border .xo-cart-discount-form__submit { width: 100%; }
</style>

<xo-cart-will-change xo-unique-id='xo-discount-form-{{ uid }}' class='xo-cart-discount-form'>
  <p class='xo-cart-discount-form__title'>{{ 'sections.cart.discount_title' | t }}</p>
  <form id='{{ form_id }}' class='xo-cart-discount-form__form' action='/checkout' method='get' data-cart-discount-form>
    <label class='xo-field-input xo-cart-discount-form__label' for='{{ input_id }}'>
      <input
        class='xo-field-input__input xo-cart-discount-form__input'
        type='text'
        name='discount'
        id='{{ input_id }}'
        placeholder='{{ 'sections.cart.discount_label' | t }}'
        autocomplete='off'
        data-cart-discount-input
      >
      <span class='xo-field-input__placeholder'>{{ 'sections.cart.discount_label' | t }}</span>
    </label>
    <button type='submit' class='xo-cart-discount-form__submit' data-cart-discount-submit>
      {{ 'sections.cart.discount_apply' | t }}
    </button>
  </form>
  <p class='xo-cart-discount-form__hint'>{{ 'sections.cart.discount_apply_at_checkout' | t }}</p>
</xo-cart-will-change>

<script>
  (function() {
    var form = document.getElementById('{{ form_id }}');
    if (!form) return;
    form.addEventListener('submit', function(e) {
      var input = form.querySelector('[data-cart-discount-input]');
      var code = input && input.value ? input.value.trim() : '';
      if (!code) {
        e.preventDefault();
        return;
      }
      e.preventDefault();
      window.location.href = '/checkout?discount=' + encodeURIComponent(code);
    });
  })();
</script>
