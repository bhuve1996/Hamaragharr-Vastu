{% comment %}
  Section Spacing Schema - Reusable snippet for individual section padding/margin settings
  Usage: Include this in any section's schema array
  
  Example:
  {% schema %}
  {
    "name": "My Section",
    "settings": [
      ... other settings ...
      {% render 'section-spacing-schema' %}
    ]
  }
  {% endschema %}
{% endcomment %}
{
  "type": "header",
  "content": "Section Spacing (Overrides Global Settings)"
},
{
  "type": "paragraph",
  "content": "Set to 0 to use global settings. Leave at 0 to inherit from theme settings."
},
{
  "type": "header",
  "content": "Desktop Spacing"
},
{
  "type": "range",
  "id": "section_padding_top_desktop",
  "min": 0,
  "max": 200,
  "step": 2,
  "unit": "px",
  "label": "Padding Top (Desktop)",
  "default": 0,
  "info": "Set to 0 to use global setting"
},
{
