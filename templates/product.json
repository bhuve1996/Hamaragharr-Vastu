          }
        },
        "question_UinKMH": {
          "type": "question",
          "settings": {
            "question": "How is the product packed and delivered?",
            "answer": "<p>All products are <strong>securely packed</strong> to avoid damage and shipped with reliable delivery partners across India.</p>",
