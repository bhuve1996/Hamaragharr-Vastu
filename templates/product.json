            "product_type": "all"
          }
        },
        "question_fDXwhX": {
          "type": "question",
          "settings": {
            "question": "What if I don't see any difference?",
            "answer": "<p>Vastu results depend on multiple factors such as placement, surroundings, and personal belief. If you have concerns, our team will <strong>guide you with placement corrections</strong>.</p>",
