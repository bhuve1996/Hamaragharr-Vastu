        "liquid_LWk7Ki": {
          "type": "liquid",
          "name": "Custom liquid by aj",
          "settings": {
            "liquid": "<div class=\"vastu-sticky-mobile\">\n\n  <div class=\"sticky-inner\">\n\n    <!-- Quantity -->\n    <div class=\"sticky-qty\">\n      <button type=\"button\" class=\"qty-btn minus\">\u2212</button>\n      <input type=\"number\" id=\"stickyQuantity\" value=\"1\" min=\"1\">\n      <button type=\"button\" class=\"qty-btn plus\">+</button>\n    </div>\n\n    <!-- Buttons -->\n    <button type=\"button\" class=\"sticky-btn add-cart-btn\">\n      Add to Cart\n    </button>\n\n    <button type=\"button\" class=\"sticky-btn buy-now-btn\">\n      Buy Now\n    </button>\n\n  </div>\n\n</div>\n\n<style>\n/* Hide on desktop */\n@media (min-width: 768px) {\n  .vastu-sticky-mobile {\n    display: none;\n  }\n}\n\n/* Sticky container */\n.vastu-sticky-mobile {\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  width: 100%;\n  background: #ffffff;\n  box-shadow: 0 -3px 15px rgba(0,0,0,0.15);\n  padding: 10px;\n  z-index: 9999;\n}\n\n.sticky-inner {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n}\n\n/* Quantity */\n.sticky-qty {\n  display: flex;\n  align-items: center;\n  border: 1px solid #ddd;\n  border-radius: 8px;\n  overflow: hidden;\n}\n\n.sticky-qty input {\n  width: 40px;\n  text-align: center;\n  border: none;\n  font-size: 14px;\n}\n\n.qty-btn {\n  background: #f3f3f3;\n  border: none;\n  padding: 6px 10px;\n  font-size: 16px;\n  cursor: pointer;\n}\n\n/* Buttons */\n.sticky-btn {\n  flex: 1;\n  padding: 12px 8px;\n  border-radius: 8px;\n  border: none;\n  font-weight: 600;\n  font-size: 14px;\n  color: #fff;\n  cursor: pointer;\n  transition: 0.3s ease;\n}\n\n/* Prosperity Green */\n.add-cart-btn {\n  background-color: #1e7d32;\n}\n\n.add-cart-btn:hover {\n  background-color: #166528;\n}\n\n/* Sacred Urgency Saffron */\n.buy-now-btn {\n  background-color: #ff6f00;\n}\n\n.buy-now-btn:hover {\n  background-color: #e65100;\n}\n</style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n\n  const minus = document.querySelector(\".vastu-sticky-mobile .minus\");\n  const plus = document.querySelector(\".vastu-sticky-mobile .plus\");\n  const qtyInput = document.getElementById(\"stickyQuantity\");\n\n  minus.addEventListener(\"click\", function() {\n    if (qtyInput.value > 1) qtyInput.value--;\n  });\n\n  plus.addEventListener(\"click\", function() {\n    qtyInput.value++;\n  });\n\n  // Add to Cart\n  document.querySelector(\".add-cart-btn\").addEventListener(\"click\", function() {\n    const form = document.querySelector('form[action*=\"/cart/add\"]');\n    form.querySelector('input[name=\"quantity\"]').value = qtyInput.value;\n    form.submit();\n  });\n\n  var checkoutUrl = {{ request.origin | append: '/checkout' | json }};\n  document.querySelector(\".buy-now-btn\").addEventListener(\"click\", function() {\n    var form = document.querySelector('form[action*=\"/cart/add\"]');\n    if (!form) return;\n    var idInput = form.querySelector('input[name=\"id\"]');\n    var qtyField = form.querySelector('input[name=\"quantity\"]');\n    if (qtyField) qtyField.value = qtyInput.value;\n    var id = idInput ? idInput.value : '';\n    var qty = parseInt(qtyInput.value, 10);\n    if (isNaN(qty) || qty < 1) qty = 1;\n    var btn = this;\n    btn.disabled = true;\n    var body = new FormData();\n    body.set('id', id);\n    body.set('quantity', String(qty));\n    fetch('/cart/add.js', { method: 'POST', body: body, headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })\n      .then(function(r) {\n        var ct = r.headers.get('Content-Type') || '';\n        if (!ct.includes('application/json')) return r.text().then(function() { throw new Error('non-json'); });\n        return r.json();\n      })\n      .then(function(data) {\n        if (data.message && !data.id) { alert(data.message); btn.disabled = false; return; }\n        setTimeout(function() { window.location.href = checkoutUrl; }, 200);\n      })\n      .catch(function() {\n        btn.disabled = false;\n        var rt = form.querySelector('input[name=\"return_to\"]');\n        if (!rt) { rt = document.createElement('input'); rt.type = 'hidden'; rt.name = 'return_to'; form.appendChild(rt); }\n        rt.value = checkoutUrl;\n        form.submit();\n      });\n  });\n\n});\n</script>",
