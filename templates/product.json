    "product_faq_V8NFqF": {
      "type": "product-faq",
      "blocks": {
        "question_xW3a8G": {
          "type": "question",
          "settings": {
            "question": "How does this kit work?",
            "answer": "<p>This product works on traditional Vastu principles that help balance the five elements and energy flow in your space. When placed correctly, it supports positivity, harmony, and well-being. The kit gives you a step-by-step system to identify and correct Vastu imbalances in your space.<br/></p>",
            "product_type": "vastu kit"
          }
        },
        "question_t4BUaa": {
          "type": "question",
          "settings": {
            "question": "Do I need any prior knowledge of Vastu?",
            "answer": "<p>None at all. The booklet is written in simple language (English and Hindi) with room-by-room instructions. If you can read, you can use this kit.</p>",
            "product_type": "vastu kit"
          }
        },
        "question_mjHrnY": {
          "type": "question",
          "settings": {
            "question": "Will it work in a rented home or flat?",
            "answer": "<p>Yes. No drilling, no construction, no permanent changes. Works for any home \u2014 owned, rented, flat, villa, or office.</p>",
            "product_type": "vastu kit"
          }
        },
        "question_LVikCR": {
          "type": "question",
          "settings": {
            "question": "Is my payment 100% secure on this website?",
            "answer": "<p>Yes. All payments are processed through Razorpay \u2014 India's most trusted payment gateway. Your card and UPI details are never stored on our website. 100% encrypted and secure.</p>",
            "product_type": "vastu kit"
          }
        },
        "question_ayKwPa": {
          "type": "question",
          "settings": {
            "question": "Can this kit be used for an office or commercial space?",
            "answer": "<p>Yes. The kit works for home offices, shops, business premises and commercial spaces \u2014 not just homes. Many of our customers have used it in their workplace to improve focus, financial flow and team harmony.</p>",
            "product_type": "vastu kit"
          }
        },
        "question_3XFXDp": {
          "type": "question",
          "settings": {
            "question": "I have never used a Vastu product before \u2014 is this right for me?",
            "answer": "<p>Yes, this kit is designed for every kind of users. The guidance is written in simple everyday language \u2014 no Vastu background, no spiritual knowledge, and no prior experience needed. If your home feels off, this is the right place to start.<br/></p>",
            "product_type": "vastu kit"
          }
        },
        "question_Nq8kVX": {
          "type": "question",
          "settings": {
            "question": "How soon will I see results?",
            "answer": "<p>Most customers notice a shift in energy and peace within 7\u201321 days. Results vary based on your home's condition and how consistently you follow the guide.</p>",
            "product_type": "all"
          }
        },
        "question_XLqdNa": {
          "type": "question",
