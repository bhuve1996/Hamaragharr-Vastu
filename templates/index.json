    "faq_homepage": {
      "type": "faq-v1",
      "blocks": {
        "question_0": {
          "type": "question",
          "settings": {
            "question": "Why This Product?",
            "answer": "<p>Our Vastu products are carefully designed based on authentic Vastu Shastra principles to help you create positive energy flow in your home or office space. Each product is thoughtfully crafted to address specific Vastu concerns and bring harmony, prosperity, and peace to your environment.</p>"
          }
        },
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What is the Hamaragharr Vastu Kit?",
            "answer": "<p>The Hamaragharr Vastu Kit is a complete, self-use Vastu correction solution that helps you identify and fix Vastu imbalances on your own. Built on authentic Vastu Shastra, it transforms traditional wisdom into simple, practical actions.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Do I need prior Vastu knowledge to use the kit?",
            "answer": "<p>No, the kit requires no prior Vastu knowledge. It comes as one complete, thoughtfully designed solution that makes Vastu correction clear and approachable for modern homes.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "What issues does the Vastu Kit help address?",
            "answer": "<p>The kit helps address common Vastu imbalances including constant stress or negativity, lack of peace and harmony, financial delays / stagnation, and health and mental fatigue.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "How do I use the Vastu Kit?",
            "answer": "<p>The kit includes detailed instructions and all necessary items to help you identify and correct Vastu imbalances in your home. Simply follow the step-by-step guide provided.</p>"
          }
        }
      },
