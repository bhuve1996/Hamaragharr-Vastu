          "type": "concern",
          "settings": {
            "concern_title": "One Stop Solution for All",
            "concern_question": "Looking for a Complete Vastu Solution?",
            "concern_description": "<p>Address multiple Vastu concerns with one comprehensive solution. The Hamaragharr Vastu Kit is designed to help you identify and fix various Vastu imbalances in your home or office.</p><p>Perfect for those who want a complete, self-use Vastu correction solution without the need for multiple products or consultations.</p>",
            "benefits_title": "✨ How This Solution Helps",
            "benefits_list": "✔ Address multiple Vastu concerns|✔ Complete self-use solution|✔ No prior Vastu knowledge needed|✔ Comprehensive energy correction",
            "carousel_collection": "one-stop-for-all",
            "carousel_collection_limit": 12
          }
        },
        "concern_1": {
          "type": "concern",
          "settings": {
            "concern_title": "Money & Financial Blockages",
            "concern_question": "Facing Money Problems or Financial Instability at Home?",
            "concern_description": "<p>Despite hard work, if money doesn't stay, expenses rise unexpectedly, or income feels blocked — your home's energy may be out of balance.</p><p>According to Vastu, improper energy flow can block wealth and opportunities. Our carefully selected remedies help activate prosperity zones and support financial stability.</p>",
            "benefits_title": "How These Remedies Help",
            "benefits_list": "✔ Improve cash flow & savings|✔ Reduce financial stress|✔ Activate wealth-attracting energy|✔ Support business & career growth",
            "carousel_collection": "money-and-financial",
            "carousel_collection_limit": 12
          }
        },
        "concern_2": {
          "type": "concern",
          "settings": {
            "concern_title": "Lack of Peace, Stress & Negativity",
            "concern_question": "Is Your Home Feeling Heavy, Restless or Stressful?",
            "concern_description": "<p>Frequent arguments, mental unrest, disturbed sleep, or constant tension often indicate negative energy accumulation in the home.</p><p>Vastu remedies help restore calm, balance, and emotional harmony — creating a peaceful environment for the entire family.</p>",
            "benefits_title": "✨ How These Remedies Help",
            "benefits_list": "✔ Reduce stress & anxiety|✔ Improve emotional well-being|✔ Create calm & positivity|✔ Support better sleep",
            "carousel_collection": "lack-of-peace-stress-nega-vity",
            "carousel_collection_limit": 12
          }
        },
        "concern_3": {
          "type": "concern",
          "settings": {
            "concern_title": "Family Conflicts & Relationship Issues",
            "concern_question": "Experiencing Frequent Arguments or Family Discomfort?",
            "concern_description": "<p>Misunderstandings, emotional distance, or constant friction in the household can be linked to imbalanced elements in living spaces.</p><p>Vastu remedies help create supportive energy that encourages understanding, bonding, and harmony.</p>",
            "benefits_title": "✨ How These Remedies Help",
            "benefits_list": "✔ Reduce conflicts|✔ Improve communication|✔ Restore emotional balance|✔ Strengthen family bonds",
            "carousel_collection": "family-conflicts-rela-onship-issues",
