        playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t }}`,
      };

      // Hide Shopify trial banner
      (function() {
        function hideTrialBanner() {
          const selectors = [
            '[data-shopify-trial]',
            '[class*="shopify-trial"]',
            '[class*="trial-banner"]',
            '[id*="shopify-trial"]',
            '[id*="trial-banner"]',
            '[aria-label*="trial" i]',
            '[aria-label*="3 day" i]',
            '[aria-label*="3-day" i]',
            '[aria-label*="free trial" i]',
            '[title*="trial" i]',
            '[title*="3 day" i]',
            '[title*="3-day" i]',
            'div[style*="position: fixed"][style*="z-index: 999"]',
            'div[style*="position: fixed"][style*="z-index: 9999"]',
            'div[style*="position: fixed"][style*="z-index: 10000"]',
            'div[class*="PolarisBanner"]',
            'div[class*="shopify-banner"]',
            'div[class*="shopify-promo"]'
          ];
          
          selectors.forEach(selector => {
            try {
              document.querySelectorAll(selector).forEach(el => {
                const text = el.textContent || el.innerText || '';
                if (text.toLowerCase().includes('trial') || 
                    text.toLowerCase().includes('3 day') || 
                    text.toLowerCase().includes('3-day') ||
                    text.toLowerCase().includes('free trial')) {
                  el.style.display = 'none';
                  el.style.visibility = 'hidden';
                  el.style.height = '0';
                  el.style.width = '0';
                  el.style.opacity = '0';
                  el.style.position = 'absolute';
                  el.style.left = '-9999px';
                  el.style.pointerEvents = 'none';
                  el.remove();
                }
              });
            } catch(e) {}
          });
        }
        
        // Run immediately
        hideTrialBanner();
        
        // Run after DOM is ready
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', hideTrialBanner);
        }
        
        // Run after page load
        window.addEventListener('load', hideTrialBanner);
        
        // Watch for dynamically added elements
        const observer = new MutationObserver(hideTrialBanner);
        observer.observe(document.body, {
          childList: true,
          subtree: true
        });
        
        // Also check periodically
        setInterval(hideTrialBanner, 1000);
      })();

      // Update product price when variant selection changes
      (function() {
        // Format money using Shopify's formatMoney if available (must be a function; avoid "INR is not a function" when formatMoney is set to a string)
        function formatMoney(cents, format) {
          if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
            return window.Shopify.formatMoney(cents, format);
          }
          
          if (typeof cents === 'string') {
            cents = cents.replace('.', '');
          }
          const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
          const amountPlaceholder = 'amount';
          const formatString = format || document.documentElement.getAttribute('xo-money-format') || '{' + '{' + amountPlaceholder + '}' + '}';
          
          function formatWithDelimiters(number, precision, thousands, decimal) {
            thousands = thousands || ',';
            decimal = decimal || '.';
            
            if (isNaN(number) || number === null) {
              return '0';
            }
            
            number = (number / 100).toFixed(precision);
            const parts = number.split('.');
            const dollarsAmount = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, thousands);
            const centsAmount = parts[1] ? (decimal + parts[1]) : '';
            
            return dollarsAmount + centsAmount;
          }
          
          const match = formatString.match(placeholderRegex);
          // If format has no amount placeholder (e.g. "INR" only), use default so we still show a number
          const effectiveFormat = match ? formatString : '{' + '{' + amountPlaceholder + '}' + '}';
          const effectiveMatch = effectiveFormat.match(placeholderRegex);
          if (!effectiveMatch) return formatString;

          const formatType = effectiveMatch[1];
          let formattedValue;
          
          switch (formatType) {
            case 'amount':
              formattedValue = formatWithDelimiters(cents, 2);
              break;
            case 'amount_no_decimals':
              formattedValue = formatWithDelimiters(cents, 0);
              break;
            case 'amount_with_comma_separator':
              formattedValue = formatWithDelimiters(cents, 2, '.', ',');
              break;
            case 'amount_no_decimals_with_comma_separator':
              formattedValue = formatWithDelimiters(cents, 0, '.', ',');
              break;
            default:
              formattedValue = effectiveFormat;
          }
          
          return effectiveFormat.replace(placeholderRegex, formattedValue);
        }

        // Get product data from the DOM
        function getProductData(productId) {
          // Try to find product data in various contexts
          // First, try to find in the form context (for popups/modals)
          const variantInput = document.querySelector(`input[name="id"][value="${productId}"], input[name="id"]`);
          let formContext = null;
          if (variantInput) {
            const form = variantInput.closest('form');
            if (form) {
              formContext = form.closest('xo-product, xo-modal, xo-toggle, [data-product-id]') || form;
            }
          }
          
          const contexts = [
            document.querySelector(`xo-product[xo-product-id="${productId}"]`),
            document.querySelector(`[data-product-id="${productId}"]`),
            formContext,
            document
          ].filter(Boolean);
          
          for (const context of contexts) {
            if (!context) continue;
            const productDataEl = context.querySelector('xo-product-data script');
            if (productDataEl) {
              try {
                return JSON.parse(productDataEl.textContent);
              } catch (e) {
                console.error('Error parsing product data:', e);
              }
            }
          }
          return null;
        }

        // Update price for a specific product
        function updateProductPrice(variantId, productId, contextElement) {
          // Try to get product data from the context first, then fallback to global search
          let productData = null;
          
          if (contextElement) {
            const contextDataEl = contextElement.querySelector('xo-product-data script');
            if (contextDataEl) {
              try {
                productData = JSON.parse(contextDataEl.textContent);
              } catch (e) {}
            }
          }
          
          // If not found in context, try global search
          if (!productData) {
            productData = getProductData(productId);
          }
          
          if (!productData) {
            console.warn('Product data not found for product:', productId);
            return;
          }
          
          const variant = productData.variants.find(v => v.id === variantId);
          if (!variant) {
            console.warn('Variant not found:', variantId);
            return;
          }
          
              // Get money format
              const amountPlaceholder = 'amount';
              const moneyFormat = document.documentElement.getAttribute('xo-money-format') || 
                                 document.documentElement.getAttribute('xo-money-with-currency-format') || 
                                 '{' + '{' + amountPlaceholder + '}' + '}';
              
          const currencyCodeEnabled = document.documentElement.hasAttribute('xo-currency-code-enabled');
          
              // Format prices
              const price = variant.price;
          const compareAtPrice = variant.compare_at_price || 0;
          
              let moneyPrice = formatMoney(price, moneyFormat);
          if (currencyCodeEnabled) {
            const currencyFormat = document.documentElement.getAttribute('xo-money-with-currency-format') || moneyFormat;
            moneyPrice = formatMoney(price, currencyFormat);
          }
          
          let moneyComparePrice = null;
          if (compareAtPrice > 0) {
            moneyComparePrice = formatMoney(compareAtPrice, moneyFormat);
            if (currencyCodeEnabled) {
              const currencyFormat = document.documentElement.getAttribute('xo-money-with-currency-format') || moneyFormat;
              moneyComparePrice = formatMoney(compareAtPrice, currencyFormat);
            }
          }
              
              // Replace currency symbols (Indian Rupee formatting)
              moneyPrice = moneyPrice.replace(/Rs\./g, '₹').replace(/Rs /g, '₹ ').replace(/INR/g, '₹').replace(/\$/g, '₹').replace(/USD/g, 'INR');
              if (moneyComparePrice) {
                moneyComparePrice = moneyComparePrice.replace(/Rs\./g, '₹').replace(/Rs /g, '₹ ').replace(/INR/g, '₹').replace(/\$/g, '₹').replace(/USD/g, 'INR');
              }
              
          // Find all price elements that need updating
          // First try to find within context (modal, toggle, etc.), then fallback to global search
          let priceElements = [];
          
          // Always search in open modals first (for popup price updates)
          const openModal = document.querySelector('xo-modal[open], xo-toggle[open]');
          if (openModal) {
            const modalContent = openModal.querySelector('.product-variant-modal__modal-content, .product-variant-modal__toggle-content');
            if (modalContent) {
              // Try exact ID match in modal
              priceElements = Array.from(modalContent.querySelectorAll(`xo-product-will-change[xo-unique-id="product-price-${productId}"]`));
              
              // If not found, try to find by class in modal
              if (priceElements.length === 0) {
                const modalPriceContainer = modalContent.querySelector('.product-variant-modal__product-price');
                if (modalPriceContainer) {
                  const modalPriceEl = modalPriceContainer.querySelector('xo-product-will-change');
                  if (modalPriceEl) {
                    priceElements = [modalPriceEl];
                  }
                }
              }
            }
          }
          
          // If not found in open modal, try context element
          if (priceElements.length === 0 && contextElement) {
            // Try exact ID match first
            priceElements = Array.from(contextElement.querySelectorAll(`xo-product-will-change[xo-unique-id="product-price-${productId}"]`));
            
            // If not found, try to find by class in modal
            if (priceElements.length === 0) {
              const modalPriceContainer = contextElement.querySelector('.product-variant-modal__product-price');
              if (modalPriceContainer) {
                const modalPriceEl = modalPriceContainer.querySelector('xo-product-will-change');
                if (modalPriceEl) {
                  priceElements = [modalPriceEl];
                }
              }
            }
            
            // Also try finding any price element with product-price in the ID within context
            if (priceElements.length === 0) {
              const contextPriceEls = contextElement.querySelectorAll('xo-product-will-change[xo-unique-id*="product-price"]');
              if (contextPriceEls.length > 0) {
                priceElements = Array.from(contextPriceEls);
              }
            }
          }
          
          // If not found in context, do global search (but prioritize modals)
          if (priceElements.length === 0) {
            // First check all modals
            const allModals = document.querySelectorAll('xo-modal, xo-toggle');
            for (const modal of allModals) {
              const modalContent = modal.querySelector('.product-variant-modal__modal-content, .product-variant-modal__toggle-content');
              if (modalContent) {
                const modalPriceEl = modalContent.querySelector(`xo-product-will-change[xo-unique-id="product-price-${productId}"]`);
                if (modalPriceEl) {
                  priceElements = [modalPriceEl];
                  break;
                }
              }
            }
          }
          
          // Also check sticky-addcart explicitly
          const stickyAddcart = document.querySelector('.sticky-addcart, .sticky-addcart-desktop');
          if (stickyAddcart) {
            const stickyPriceEl = stickyAddcart.querySelector(`xo-product-will-change[xo-unique-id="product-price-${productId}"]`);
            if (stickyPriceEl && !priceElements.includes(stickyPriceEl)) {
              priceElements.push(stickyPriceEl);
            }
          }
          
          // Final fallback - global search (should find all including sticky-addcart)
          if (priceElements.length === 0) {
            priceElements = Array.from(document.querySelectorAll(`xo-product-will-change[xo-unique-id="product-price-${productId}"]`));
          } else {
            // Even if we found some, make sure we get ALL price elements including sticky-addcart
            const allPriceElements = Array.from(document.querySelectorAll(`xo-product-will-change[xo-unique-id="product-price-${productId}"]`));
            allPriceElements.forEach(el => {
              if (!priceElements.includes(el)) {
                priceElements.push(el);
              }
            });
          }
              
              priceElements.forEach(priceEl => {
            let priceContainer = priceEl.querySelector('.xo-price');
            
            // If price container doesn't exist, create it
            if (!priceContainer) {
              priceContainer = document.createElement('div');
              priceContainer.className = 'xo-price';
              priceContainer.setAttribute('role', 'status');
              priceEl.appendChild(priceContainer);
            }
            
            // Get existing style classes from price container
            const styleMatch = priceContainer.className.match(/xo-price--(\w+)/);
            const styleClass = styleMatch ? styleMatch[1] : '';
                
                // Create new price HTML
                let newPriceHTML = '';
                
            if (compareAtPrice > 0 && compareAtPrice > price) {
                  // Sale price
                  newPriceHTML = `
                    <div class="xo-price__container">
                  <div class="xo-price__sale${styleClass ? ' xo-price__sale--' + styleClass : ''}">
                        <div class="xo-visually-hidden xo-visually-hidden--inline">Sale price</div>
                        <span class="xo-price__item xo-price__item--accent">${moneyPrice}</span>
                        <div class="xo-visually-hidden xo-visually-hidden--inline">Regular price</div>
                        <span class="xo-price__item xo-price__item--del">${moneyComparePrice}</span>
                      </div>
                    </div>
                  `;
                } else {
                  // Regular price
                  newPriceHTML = `
                    <div class="xo-price__container">
                  <div class="xo-price__regular${styleClass ? ' xo-price__regular--' + styleClass : ''}">
                        <div class="xo-visually-hidden xo-visually-hidden--inline">Regular price</div>
                        <span class="xo-price__item">${moneyPrice}</span>
                      </div>
                    </div>
                  `;
                }
                
                // Update the price container
                priceContainer.innerHTML = newPriceHTML;
          });
        }

        // Get product ID from form context
        function getProductIdFromForm(form) {
          // Try xo-product element
            const productEl = form.closest('xo-product');
          if (productEl) {
            const productId = productEl.getAttribute('xo-product-id');
            if (productId) return productId;
          }
            
          // Try form ID
              const formId = form.id;
              const match = formId.match(/product-form-(\d+)/) || formId.match(/product-(\d+)/);
              if (match) {
            return match[1];
            }
            
          // Try product data in form context
              const contextEl = form.closest('xo-product, .product-card, .product-item, [data-product-id]');
              if (contextEl) {
                const dataEl = contextEl.querySelector('xo-product-data script');
                if (dataEl) {
                  try {
                    const productData = JSON.parse(dataEl.textContent);
                return productData.id.toString();
                  } catch (e) {}
                }
            if (contextEl.hasAttribute('data-product-id')) {
              return contextEl.getAttribute('data-product-id');
            }
          }
          
          return null;
        }

        // Handle variant change - works with both forms and web components
        function handleVariantChange(variantInput) {
          const form = variantInput ? variantInput.closest('form') : null;
          
          let variantId = null;
          let productId = null;
          let contextElement = null;
          
          if (variantInput && form) {
            // Traditional form approach
            variantId = parseInt(variantInput.value);
          if (!variantId) return;
          
            productId = getProductIdFromForm(form);
          if (!productId) return;
          
            contextElement = variantInput.closest('xo-product, xo-modal, xo-toggle, .product-variant-modal__modal-content, .product-variant-modal__toggle-content, [data-product-id]') || 
                           form.closest('xo-product, xo-modal, xo-toggle, .product-variant-modal__modal-content, .product-variant-modal__toggle-content, [data-product-id]') || 
                           form;
          } else if (variantInput) {
            // Web component approach - variant input might not be in a form
            variantId = parseInt(variantInput.value);
            if (!variantId) return;
            
            contextElement = variantInput.closest('xo-product, xo-modal, xo-toggle, .product-variant-modal__modal-content, .product-variant-modal__toggle-content, [data-product-id]');
            
            if (contextElement) {
              const productDataEl = contextElement.querySelector('xo-product-data script');
              if (productDataEl) {
                try {
                  const productData = JSON.parse(productDataEl.textContent);
                  productId = productData.id.toString();
                } catch (e) {}
              }
            }
            
            if (!productId) {
              // Try to get product ID from modal name or other attributes
              const modal = variantInput.closest('xo-modal, xo-toggle');
              if (modal) {
                const modalName = modal.getAttribute('xo-name');
                if (modalName) {
                  const match = modalName.match(/product-variant-modal-(\d+)/);
                  if (match) {
                    productId = match[1];
                  }
                }
              }
            }
          }
          
          if (!variantId || !productId) return;
          
          // Always try to find the modal context for price updates
          if (!contextElement) {
            // Try to find any open modal/toggle that might contain the price
            const openModal = document.querySelector('xo-modal[open], xo-toggle[open]');
            if (openModal) {
              const modalContent = openModal.querySelector('.product-variant-modal__modal-content, .product-variant-modal__toggle-content');
              if (modalContent) {
                contextElement = modalContent;
                // Try to get product ID from modal if not already found
                if (!productId) {
                  const modalName = openModal.getAttribute('xo-name');
                  if (modalName) {
                    const match = modalName.match(/product-variant-modal-(\d+)/);
                    if (match) {
                      productId = match[1];
                    }
                  }
                }
              }
            }
          }
          
          if (!productId) return;
          
          updateProductPrice(variantId, productId, contextElement);
        }
        
        // Get product ID from modal context
        function getProductIdFromModal(modalContext) {
          if (!modalContext) return null;
          
          const productDataEl = modalContext.querySelector('xo-product-data script');
          if (productDataEl) {
            try {
              const productData = JSON.parse(productDataEl.textContent);
              return productData.id.toString();
            } catch (e) {}
          }
          
          const modal = modalContext.closest('xo-modal, xo-toggle');
          if (modal) {
            const modalName = modal.getAttribute('xo-name');
            if (modalName) {
              const match = modalName.match(/product-variant-modal-(\d+)/);
              if (match) {
                return match[1];
              }
            }
          }
          
          return null;
        }

        // Track last variant ID to detect changes
        const variantTrackers = new WeakMap();
        
        // Initialize variant change listeners
        function initVariantListeners() {
          // Find all variant inputs
          const variantInputs = document.querySelectorAll('input[name="id"]');
          
          variantInputs.forEach(variantInput => {
            // Skip if already has listener
            if (variantInput.dataset.priceListenerAdded) {
              // Still check for value changes
              const lastValue = variantTrackers.get(variantInput);
              const currentValue = parseInt(variantInput.value);
              if (lastValue !== currentValue && currentValue) {
                variantTrackers.set(variantInput, currentValue);
                handleVariantChange(variantInput);
              }
              return;
            }
            
            variantInput.dataset.priceListenerAdded = 'true';
            variantTrackers.set(variantInput, parseInt(variantInput.value));
            
            // Listen for change and input events
            const updateHandler = () => {
              const currentValue = parseInt(variantInput.value);
              const lastValue = variantTrackers.get(variantInput);
              if (lastValue !== currentValue && currentValue) {
                variantTrackers.set(variantInput, currentValue);
                handleVariantChange(variantInput);
              }
            };
            
            variantInput.addEventListener('change', updateHandler);
            variantInput.addEventListener('input', updateHandler);
            
            // Also watch for value attribute changes (for web components)
            const valueObserver = new MutationObserver(() => {
              setTimeout(updateHandler, 50);
            });
            
            valueObserver.observe(variantInput, {
              attributes: true,
              attributeFilter: ['value'],
              childList: false,
              subtree: false
            });
            
            // Periodic check for value changes (fallback for web components)
            const checkInterval = setInterval(() => {
              const currentValue = parseInt(variantInput.value);
              const lastValue = variantTrackers.get(variantInput);
              if (lastValue !== currentValue && currentValue) {
                variantTrackers.set(variantInput, currentValue);
                handleVariantChange(variantInput);
              }
            }, 300);
            
            // Clean up interval when input is removed
            const disconnectObserver = new MutationObserver((mutations) => {
              mutations.forEach((mutation) => {
                mutation.removedNodes.forEach((node) => {
                  if (node === variantInput || (node.nodeType === 1 && node.contains(variantInput))) {
                    clearInterval(checkInterval);
                    valueObserver.disconnect();
                    disconnectObserver.disconnect();
                  }
                });
              });
            });
            disconnectObserver.observe(document.body, { childList: true, subtree: true });
          });
        }

        // Use event delegation for variant option changes
        document.addEventListener('change', (e) => {
          const target = e.target;
          
          // Check if it's a variant option selector
          if (target.matches('input[type="radio"][name^="option"], select[name^="option"], xo-product-variant input, xo-product-variant select, .xo-field-radio input')) {
            // Find form - check in modal/toggle context first, then sticky-addcart
            const modalContext = target.closest('xo-modal, xo-toggle, .product-variant-modal__modal-content, .product-variant-modal__toggle-content');
            const stickyContext = target.closest('.sticky-addcart, .sticky-addcart-desktop, xo-sticky');
            const form = modalContext ? modalContext.querySelector('form') : (stickyContext ? stickyContext.querySelector('form') : target.closest('form'));
            
            if (form) {
              const variantInput = form.querySelector('input[name="id"]');
              if (variantInput) {
                // Wait a bit for variant ID to update (web components may need time)
                setTimeout(() => {
                  handleVariantChange(variantInput);
                }, 250);
              }
            } else {
              // If no form found, try to find variant input directly in modal context or sticky-addcart
              if (modalContext) {
                const variantInput = modalContext.querySelector('input[name="id"]');
                if (variantInput) {
                  setTimeout(() => {
                    handleVariantChange(variantInput);
                  }, 250);
                } else {
                  // Try modal variant change handler
                  setTimeout(() => {
                    handleModalVariantChange(modalContext);
                  }, 250);
                }
              } else if (stickyContext) {
                // Handle sticky-addcart specifically
                const variantInput = stickyContext.querySelector('input[name="id"]');
                if (variantInput) {
                  setTimeout(() => {
                    handleVariantChange(variantInput);
                  }, 250);
                }
              } else {
                // Even if no modal context found, check if there's an open modal and update its price
                const openModal = document.querySelector('xo-modal[open], xo-toggle[open]');
                if (openModal) {
                  setTimeout(() => {
                    const modalContent = openModal.querySelector('.product-variant-modal__modal-content, .product-variant-modal__toggle-content');
                    if (modalContent) {
                      const variantInput = modalContent.querySelector('input[name="id"]');
                      if (variantInput) {
                        handleVariantChange(variantInput);
                      } else {
                        handleModalVariantChange(modalContent);
                      }
                    }
                  }, 250);
                }
              }
            }
          }
        });

        // Function to find variant ID from selected options in modal
        function findVariantIdFromOptions(modalContext) {
          if (!modalContext) return null;
          
          // Get product data
          const productDataEl = modalContext.querySelector('xo-product-data script');
          if (!productDataEl) return null;
          
          let productData;
          try {
            productData = JSON.parse(productDataEl.textContent);
          } catch (e) {
            return null;
          }
          
          // Get all selected option values
          const selectedOptions = {};
          const variantComponents = modalContext.querySelectorAll('xo-product-variant');
          
          variantComponents.forEach(component => {
            const radioInput = component.querySelector('input[type="radio"]:checked');
            if (radioInput) {
              const optionName = radioInput.name;
              const optionValue = radioInput.value;
              selectedOptions[optionName] = optionValue;
            }
          });
          
          // Also check for option inputs directly
          const optionInputs = modalContext.querySelectorAll('input[name^="option"]:checked');
          optionInputs.forEach(input => {
            selectedOptions[input.name] = input.value;
          });
          
          // Find matching variant
          if (productData.variants) {
            for (const variant of productData.variants) {
              let matches = true;
              const variantOptions = variant.options || [];
              
              // Check if variant matches selected options
              let optionIndex = 0;
              for (const optionName in selectedOptions) {
                if (selectedOptions.hasOwnProperty(optionName)) {
                  const selectedValue = selectedOptions[optionName];
                  // Option names are usually "option1", "option2", "option3"
                  const optionKey = 'option' + (optionIndex + 1);
                  if (variant[optionKey] !== selectedValue && variantOptions[optionIndex] !== selectedValue) {
                    matches = false;
                    break;
                  }
                  optionIndex++;
                }
              }
              
              if (matches && Object.keys(selectedOptions).length > 0) {
                return variant.id;
              }
            }
          }
          
          return null;
        }

        // Also listen for clicks on variant options (for color swatches, etc.)
        document.addEventListener('click', (e) => {
          const target = e.target.closest('[data-option], [data-variant], xo-product-variant, .variant-option, [data-variant-option], .xo-field-radio, .xo-field-radio__label, .xo-field-radio input, input[type="radio"][name^="option"]');
          if (target) {
            // Find form - check in modal/toggle context first, then sticky-addcart
            const modalContext = target.closest('xo-modal, xo-toggle, .product-variant-modal__modal-content, .product-variant-modal__toggle-content');
            const stickyContext = target.closest('.sticky-addcart, .sticky-addcart-desktop, xo-sticky');
            const form = modalContext ? modalContext.querySelector('form') : (stickyContext ? stickyContext.querySelector('form') : target.closest('form'));
            
            if (form) {
              const variantInput = form.querySelector('input[name="id"]');
              if (variantInput) {
                setTimeout(() => {
                  handleVariantChange(variantInput);
                }, 300);
              }
            } else {
              // If no form found, try to find variant input directly in modal context or sticky-addcart
              if (modalContext) {
                const variantInput = modalContext.querySelector('input[name="id"]');
                if (variantInput) {
                  setTimeout(() => {
                    handleVariantChange(variantInput);
                  }, 300);
                } else {
                  // Try to calculate variant ID from selected options
                  setTimeout(() => {
                    const variantId = findVariantIdFromOptions(modalContext);
                    if (variantId) {
                    const productId = getProductIdFromModal(modalContext);
                    if (productId) {
                      updateProductPrice(variantId, productId, modalContext);
                    }
                    }
                  }, 300);
                }
              } else if (stickyContext) {
                // Handle sticky-addcart specifically
                const variantInput = stickyContext.querySelector('input[name="id"]');
                if (variantInput) {
                  setTimeout(() => {
                    handleVariantChange(variantInput);
                  }, 300);
                }
              } else {
                // Even if no modal context found, check if there's an open modal
                const openModal = document.querySelector('xo-modal[open], xo-toggle[open]');
                if (openModal) {
                  setTimeout(() => {
                    const modalContent = openModal.querySelector('.product-variant-modal__modal-content, .product-variant-modal__toggle-content');
                    if (modalContent) {
                      const variantId = findVariantIdFromOptions(modalContent);
                      if (variantId) {
                        const productId = getProductIdFromModal(modalContent);
                        if (productId) {
                          updateProductPrice(variantId, productId, modalContent);
                        }
                      }
                    }
                  }, 300);
                }
              }
            }
          }
        });
        
        // Watch for variant changes in modals using MutationObserver
        function watchModalForVariantChanges() {
          const modals = document.querySelectorAll('xo-modal, xo-toggle');
          
          modals.forEach(modal => {
            if (modal.dataset.variantWatcherAdded) return;
            modal.dataset.variantWatcherAdded = 'true';
            
            const modalContent = modal.querySelector('.product-variant-modal__modal-content, .product-variant-modal__toggle-content');
            if (!modalContent) return;
            
            // Watch for changes in variant inputs and web components
            const variantObserver = new MutationObserver(() => {
              const variantInput = modalContent.querySelector('input[name="id"]');
              if (variantInput) {
                const currentVariantId = parseInt(variantInput.value);
                const lastVariantId = parseInt(modalContent.dataset.lastVariantId || '0');
                
                if (currentVariantId && currentVariantId !== lastVariantId) {
                  modalContent.dataset.lastVariantId = currentVariantId;
                  setTimeout(() => {
                    handleVariantChange(variantInput);
                  }, 150);
                }
              } else {
                // Try to calculate variant ID from selected options
                const calculatedVariantId = findVariantIdFromOptions(modalContent);
                if (calculatedVariantId) {
                  const lastVariantId = parseInt(modalContent.dataset.lastVariantId || '0');
                  if (calculatedVariantId !== lastVariantId) {
                    modalContent.dataset.lastVariantId = calculatedVariantId;
                    const productId = getProductIdFromModal(modalContent);
                    if (productId) {
                      updateProductPrice(calculatedVariantId, productId, modalContent);
                    }
                  }
                }
              }
            });
            
            variantObserver.observe(modalContent, {
              childList: true,
              subtree: true,
              attributes: true,
              attributeFilter: ['value', 'data-variant-id', 'variant-id']
            });
            
            // Also periodically check for variant changes (fallback for web components)
            const checkInterval = setInterval(() => {
              if (!document.body.contains(modal)) {
                clearInterval(checkInterval);
                variantObserver.disconnect();
                return;
              }
              
              const variantInput = modalContent.querySelector('input[name="id"]');
              if (variantInput) {
                const currentVariantId = parseInt(variantInput.value);
                const lastVariantId = parseInt(modalContent.dataset.lastVariantId || '0');
                
                if (currentVariantId && currentVariantId !== lastVariantId) {
                  modalContent.dataset.lastVariantId = currentVariantId;
                  handleVariantChange(variantInput);
                }
              } else {
                // Try to calculate variant ID from selected options
                const calculatedVariantId = findVariantIdFromOptions(modalContent);
                if (calculatedVariantId) {
                  const lastVariantId = parseInt(modalContent.dataset.lastVariantId || '0');
                  if (calculatedVariantId !== lastVariantId) {
                    modalContent.dataset.lastVariantId = calculatedVariantId;
                    
                    const productId = getProductIdFromModal(modalContent);
                    if (productId) {
                      updateProductPrice(calculatedVariantId, productId, modalContent);
                    }
                  }
                }
              }
            }, 300);
          });
        }
        
        // Initialize modal watchers
        watchModalForVariantChanges();
        
        // Watch for new modals being added
        const modalObserver = new MutationObserver(() => {
          watchModalForVariantChanges();
        });
        
        modalObserver.observe(document.body, {
          childList: true,
          subtree: true
        });

        // Initialize on DOM ready
        function init() {
          initVariantListeners();
        }
        
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
        
        // Handle dynamically added forms (popups, modals, AJAX loaded content)
        const observer = new MutationObserver(() => {
          initVariantListeners();
        });
        
        observer.observe(document.body, {
          childList: true,
          subtree: true
        });
      })();

      // Fix: Ensure cart drawer always has content and close button after adding items
      (function() {
        let cartUpdateTimeout = null;
        let lastCartCheck = 0;
        
        function ensureCartDrawerContent() {
          const cartModal = document.querySelector('xo-modal[xo-name="cart"]');
          if (!cartModal) return;
          
          const cartDrawer = cartModal.querySelector('xo-cart-mini');
          if (!cartDrawer) return;
          
          const cartContent = cartDrawer.querySelector('xo-cart-will-change[xo-unique-id="xo-cart-mini-content"]');
          const cartFooter = cartDrawer.querySelector('xo-cart-will-change[xo-unique-id="xo-cart-mini-drawer-footer"]');
          const modalHeader = cartDrawer.querySelector('.xo-modal-content-style1__header');
          const closeButton = modalHeader?.querySelector('xo-modal-trigger, .xo-modal-content-style1__close');
          const modalBody = cartDrawer.querySelector('.xo-modal-content-style1__body, xo-cart-scroll');
          
          // Ensure close button is always visible and functional
          if (closeButton) {
            closeButton.style.display = '';
            closeButton.style.visibility = 'visible';
            closeButton.style.opacity = '1';
            closeButton.style.pointerEvents = 'auto';
            closeButton.style.zIndex = '10000';
          }
          
          // Ensure header is visible
          if (modalHeader) {
            modalHeader.style.display = '';
            modalHeader.style.visibility = 'visible';
            modalHeader.style.opacity = '1';
          }
          
          // Check if cart content is empty or missing
          if (cartContent) {
            const hasVisibleContent = cartContent.children.length > 0 || 
                                     (cartContent.textContent && cartContent.textContent.trim().length > 0) ||
                                     cartContent.querySelector('.xo-cart-empty, .xo-cart-mini-item');
            
            // If content appears empty, wait a bit for web component to update, then check again
            if (!hasVisibleContent) {
              setTimeout(() => {
                const stillEmpty = !cartContent.children.length && 
                                  (!cartContent.textContent || cartContent.textContent.trim().length === 0);
                
                if (stillEmpty && Date.now() - lastCartCheck > 2000) {
                  lastCartCheck = Date.now();
                  
                  // Try to fetch cart and reload drawer section
                  fetch(window.routes?.cart_url || '/cart.js', {
                    headers: { 'Accept': 'application/json' }
                  })
                    .then(response => {
                      if (!response.ok) throw new Error('Cart fetch failed');
                      return response.json();
                    })
                    .then(cart => {
                      // If cart has items but drawer is empty, trigger a refresh
                      if (cart && cart.items && cart.items.length > 0) {
                        // Dispatch event to trigger cart update
                        document.dispatchEvent(new CustomEvent('cart:refresh'));
                        
                        // Fallback: show a message and close button
                        if (!cartContent.children.length) {
                          cartContent.innerHTML = `
                            <div style="padding: 2rem; text-align: center;">
                              <p style="margin-bottom: 1rem;">Item added to cart successfully!</p>
                              <p style="font-size: 0.9em; color: #666;">The cart is updating...</p>
                            </div>
                          `;
                        }
                      } else {
                        // Cart is empty, show empty state
                        if (!cartContent.querySelector('.xo-cart-empty')) {
                          cartContent.innerHTML = `
                            <div class="xo-cart-empty" style="padding: 2rem; text-align: center;">
                              <p>Your cart is empty</p>
                            </div>
                          `;
                        }
                      }
                    })
                    .catch(err => {
                      console.error('Error checking cart:', err);
                      // Show fallback message with close option
                      if (!cartContent.children.length) {
                        cartContent.innerHTML = `
                          <div style="padding: 2rem; text-align: center;">
                            <p style="margin-bottom: 1rem;">Item added to cart!</p>
                            <p style="font-size: 0.9em; color: #666;">Please refresh the page to view your cart.</p>
                          </div>
                        `;
                      }
                    });
                }
              }, 1000);
            }
          }
          
          // Ensure footer and body are visible
          if (cartFooter) {
            cartFooter.style.display = '';
            cartFooter.style.visibility = 'visible';
          }
          
          if (modalBody) {
            modalBody.style.display = '';
            modalBody.style.visibility = 'visible';
          }
        }
        
        // Monitor cart drawer for empty content
        function monitorCartDrawer() {
          const cartModal = document.querySelector('xo-modal[xo-name="cart"]');
          if (!cartModal) return;
          
          // Check if modal is open (multiple ways to check)
          const isOpen = cartModal.hasAttribute('xo-active') || 
                        cartModal.getAttribute('xo-active') === 'true' ||
                        cartModal.classList.contains('xo-active') ||
                        window.getComputedStyle(cartModal).display !== 'none';
          
          if (isOpen) {
            ensureCartDrawerContent();
          }
        }
        
        // Listen for cart updates from web components
        document.addEventListener('cart:updated', () => {
          clearTimeout(cartUpdateTimeout);
          cartUpdateTimeout = setTimeout(() => {
            monitorCartDrawer();
          }, 300);
        });
        
        // Listen for custom cart refresh events
        document.addEventListener('cart:refresh', () => {
          setTimeout(monitorCartDrawer, 500);
        });
        
        // Monitor cart drawer when it opens
        const cartObserver = new MutationObserver((mutations) => {
          let shouldCheck = false;
          mutations.forEach(mutation => {
            if (mutation.type === 'attributes' && mutation.attributeName === 'xo-active') {
              shouldCheck = true;
            }
            if (mutation.type === 'childList') {
              shouldCheck = true;
            }
          });
          if (shouldCheck) {
            setTimeout(monitorCartDrawer, 200);
          }
        });
        
        // Observe cart modal for changes
        const cartModal = document.querySelector('xo-modal[xo-name="cart"]');
        if (cartModal) {
          cartObserver.observe(cartModal, {
            attributes: true,
            attributeFilter: ['xo-active', 'class'],
            childList: true,
            subtree: true
          });
        }
        
        // Also check periodically when modal might be open
        setInterval(() => {
          const cartModal = document.querySelector('xo-modal[xo-name="cart"]');
          if (cartModal) {
            const isOpen = cartModal.hasAttribute('xo-active') || 
                          cartModal.getAttribute('xo-active') === 'true' ||
                          cartModal.classList.contains('xo-active');
            if (isOpen) {
              monitorCartDrawer();
            }
          }
        }, 2000);
        
        // Initial check
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => {
            setTimeout(monitorCartDrawer, 500);
          });
        } else {
          setTimeout(monitorCartDrawer, 500);
        }
      })();

      // Global viewport resize listener to handle mobile/desktop switching in dev tools
      (function() {
        let resizeTimeout = null;
        let lastViewportWidth = window.innerWidth;
        let isMobile = window.innerWidth <= 767; // Common mobile breakpoint
        
        function updateViewportClasses() {
          const currentWidth = window.innerWidth;
          const newIsMobile = currentWidth <= 767;
          const html = document.documentElement;
          
          // Only update if viewport category actually changed
          if (newIsMobile !== isMobile || Math.abs(currentWidth - lastViewportWidth) > 50) {
            // Remove existing classes
            html.classList.remove('is-mobile', 'is-desktop');
            
            // Add appropriate class
            if (newIsMobile) {
              html.classList.add('is-mobile');
            } else {
              html.classList.add('is-desktop');
            }
            
            // Update state
            isMobile = newIsMobile;
            lastViewportWidth = currentWidth;
            
            // Dispatch custom event for other components to react
            window.dispatchEvent(new CustomEvent('viewport:changed', {
              detail: {
                width: currentWidth,
                isMobile: newIsMobile,
                isDesktop: !newIsMobile
              }
            }));
            
            // Force layout recalculation
            void html.offsetHeight;
          }
        }
        
        // Debounced resize handler
        function handleResize() {
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(() => {
            updateViewportClasses();
          }, 150);
        }
        
        // Listen for resize events
        window.addEventListener('resize', handleResize, { passive: true });
        
        // Also listen for orientation changes (mobile devices)
        window.addEventListener('orientationchange', () => {
          setTimeout(updateViewportClasses, 200);
        });
        
        // Use ResizeObserver for more accurate viewport detection
        if (window.ResizeObserver) {
          const resizeObserver = new ResizeObserver(() => {
            handleResize();
          });
          
          resizeObserver.observe(document.documentElement);
        }
        
        // Initial setup
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', updateViewportClasses);
        } else {
          updateViewportClasses();
        }
      })();

      // Customize checkout confirmation and order pages
      (function() {
        function customizeOrderPages() {
          // Replace "Please verify your order" with a better message
          const walker = document.createTreeWalker(
            document.body,
            NodeFilter.SHOW_TEXT,
            null,
            false
          );
          
          let node;
          const replacements = [
            { from: /Please verify your order/gi, to: 'Review your order details below' },
            { from: /Please verify your order\./gi, to: 'Review your order details below.' }
          ];
          
          while (node = walker.nextNode()) {
            replacements.forEach(replacement => {
              if (node.textContent && replacement.from.test(node.textContent)) {
                node.textContent = node.textContent.replace(replacement.from, replacement.to);
              }
            });
          }

          // Replace ALL currency symbols with ₹ on order pages
          function replaceDollarSigns() {
            // Replace in all text nodes
            const walker = document.createTreeWalker(
              document.body,
              NodeFilter.SHOW_TEXT,
              null,
              false
            );
            
            let textNode;
            while (textNode = walker.nextNode()) {
              if (textNode.textContent.includes('$') || textNode.textContent.includes('Rs.') || textNode.textContent.includes('Rs ') || textNode.textContent.includes('USD') || textNode.textContent.includes('INR')) {
                textNode.textContent = textNode.textContent.replace(/Rs\./g, '₹').replace(/Rs /g, '₹ ').replace(/INR/g, '₹').replace(/\$/g, '₹').replace(/USD/g, 'INR');
              }
            }

            // Replace in all HTML elements (for payment methods, prices, etc.)
            const allElements = document.querySelectorAll('*');
            allElements.forEach(el => {
              if (el.children.length === 0 && el.innerHTML) {
                // Replace currency symbols in leaf nodes
                if (el.innerHTML.includes('$') || el.innerHTML.includes('Rs.') || el.innerHTML.includes('Rs ') || el.innerHTML.includes('USD') || el.innerHTML.includes('INR')) {
                  el.innerHTML = el.innerHTML.replace(/Rs\./g, '₹').replace(/Rs /g, '₹ ').replace(/INR/g, '₹').replace(/\$/g, '₹').replace(/USD/g, 'INR');
                  el.innerHTML = el.innerHTML.replace(/\$(\s*)(COD|Cash on Delivery|Payment)/gi, '₹$1$2');
                  el.innerHTML = el.innerHTML.replace(/(USD|USD\s*)(COD|Cash on Delivery)/gi, '₹ $2');
                  el.innerHTML = el.innerHTML.replace(/\$\s*([0-9])/g, '₹ $1');
                }
              } else if (el.innerHTML && (el.innerHTML.includes('$') || el.innerHTML.includes('USD') || el.innerHTML.includes('Rs.') || el.innerHTML.includes('Rs ') || el.innerHTML.includes('INR'))) {
                // Also check parent elements for currency symbols
                el.innerHTML = el.innerHTML.replace(/Rs\./g, '₹').replace(/Rs /g, '₹ ').replace(/INR/g, '₹').replace(/\$/g, '₹').replace(/USD/g, 'INR');
              }
            });

            // Specifically target payment-related elements
            const paymentElements = document.querySelectorAll('[class*="payment"], [class*="status"], [id*="payment"], [class*="price"], [class*="total"], [class*="fee"], [class*="amount"]');
            paymentElements.forEach(el => {
              if (el.innerHTML) {
                el.innerHTML = el.innerHTML.replace(/Rs\./g, '₹').replace(/Rs /g, '₹ ').replace(/INR/g, '₹').replace(/\$/g, '₹').replace(/USD/g, 'INR');
              }
            });
          }
          
          replaceDollarSigns();
        }

        // Run on order-related pages
        if (window.location.pathname.includes('/orders/') || 
            window.location.pathname.includes('/account/orders/') ||
            window.location.pathname.includes('/checkout/thank_you') ||
            document.body.classList.contains('template-order') ||
            document.body.classList.contains('template-customers-order')) {
          
          // Run immediately and after DOM is ready
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', customizeOrderPages);
          } else {
            customizeOrderPages();
          }

          // Also run after delays to catch dynamically loaded content
          setTimeout(customizeOrderPages, 500);
          setTimeout(customizeOrderPages, 1500);
          setTimeout(customizeOrderPages, 3000);
        }
      })();
    </script>

    {%- comment -%} Page Loader Script: hide when banner is ready (homepage) or on window load. Max 2s so one hanging resource never blocks. {%- endcomment -%}
    <script>
      (function() {
        const loader = document.getElementById('vastu-page-loader');
        const body = document.body;
        
        if (!loader) return;
        
        function hideLoader() {
          if (loader && !loader.classList.contains('hidden')) {
            if (body.classList.contains('template-index')) {
              body.classList.add('vastu-homepage-banner-ready');
              var m = document.getElementById('xo-main-content');
              if (m) {
                for (var i = 0; i < m.children.length; i++) {
                  var el = m.children[i];
                  if (el.getAttribute('data-vastu-hide')) {
                    el.style.cssText = '';
                    el.removeAttribute('data-vastu-hide');
                  }
                }
              }
            }
            loader.classList.add('hidden');
            body.classList.remove('vastu-page-loading');
            setTimeout(function() {
              if (loader && loader.parentNode) {
                loader.parentNode.removeChild(loader);
              }
            }, 500);
          }
        }
        
        function runWhenBannerReady(fn) {
          var banner = document.querySelector('.vastu-banner-carousel[data-section-type="homepage-banner"]');
          if (!banner) {
            fn();
            return;
          }
          var firstImg = banner.querySelector('.vastu-banner-carousel__image--desktop, .vastu-banner-carousel__image');
          if (firstImg && firstImg.complete) {
            fn();
            return;
          }
          if (firstImg) {
            firstImg.addEventListener('load', fn, { once: true });
            firstImg.addEventListener('error', fn, { once: true });
            return;
          }
          setTimeout(fn, 200);
        }
        
        function onHomepageBannerReady() {
          body.classList.add('vastu-homepage-banner-ready');
          var m = document.getElementById('xo-main-content');
          if (m) {
            for (var i = 0; i < m.children.length; i++) {
              var el = m.children[i];
              if (el.getAttribute('data-vastu-hide')) {
                el.style.cssText = '';
                el.removeAttribute('data-vastu-hide');
              }
            }
          }
          setTimeout(hideLoader, 150);
        }
        
        if (body.classList.contains('template-index')) {
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
              runWhenBannerReady(onHomepageBannerReady);
            });
          } else {
            runWhenBannerReady(onHomepageBannerReady);
          }
        }
        
        window.addEventListener('load', function() {
          setTimeout(hideLoader, 300);
        });
        
        if (document.readyState === 'complete') {
          setTimeout(hideLoader, 300);
        }
        
        setTimeout(hideLoader, 2000);
      })();
    </script>
