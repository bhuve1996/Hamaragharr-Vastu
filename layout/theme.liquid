      }
    </style>
    {%- comment -%} Homepage: show only the banner section until ready (hide all, then show the one containing .vastu-banner-carousel so order doesn't matter) {%- endcomment -%}
    <style>
      body.template-index #xo-main-content > * {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.35s ease, visibility 0.35s ease;
      }
      body.template-index #xo-main-content > *:has(.vastu-banner-carousel) {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }
      body.template-index.vastu-homepage-banner-ready #xo-main-content > * {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }
    </style>

