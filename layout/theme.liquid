    {% render 'page-title' %}

    {%- liquid
      assign meta_description = page_description
      
      # Handle homepage specifically for better SEO
      if template.name == 'index' or request.page_type == 'index'
        # Use a keyword-rich description for homepage if available
        if shop.metafields.custom.homepage_meta_description != blank
          assign meta_description = shop.metafields.custom.homepage_meta_description
        elsif page_description != blank
          assign meta_description = page_description
        else
          # Default SEO-optimized description for Vastu products
          assign meta_description = 'Transform your home with authentic Vastu Shastra solutions. Complete Vastu Kit for home & office. Self-installation, no consultation needed. Shop Vastu remedies, wall paintings & correction kits online.'
        endif
      elsif template.name == 'collection' and collection
        if collection.description != blank
          assign meta_description = collection.description | strip_html | truncate: 160
        endif
      elsif template.name == 'product' and product
        if product.description != blank
          assign meta_description = product.description | strip_html | truncate: 160
        endif
      elsif template.name == 'article' and article
        if article.excerpt != blank
          assign meta_description = article.excerpt | strip_html | truncate: 160
        elsif article.content != blank
          assign meta_description = article.content | strip_html | truncate: 160
        endif
      elsif template.name == 'blog' and blog
        if blog.description != blank
          assign meta_description = blog.description | strip_html | truncate: 160
        endif
      elsif template.name == 'page' and page
        if page.content != blank
          assign meta_description = page.content | strip_html | truncate: 160
        endif
      endif
      
      if meta_description == blank
        assign meta_description = shop.description | default: shop.name
      endif
    -%}
    <meta name='description' content='{{ meta_description | escape }}'>
    
    {%- comment -%} Meta Keywords (configurable via settings) {%- endcomment -%}
    {%- if settings.seo_meta_keywords != blank -%}
