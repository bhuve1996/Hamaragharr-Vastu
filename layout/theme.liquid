  <body class='gradient vastu-page-loading template-{{ template | replace: ".", "-" }}'>
    <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WGNZZTSD"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
    {%- comment -%} Page Loader {%- endcomment -%}
    <div 
      class='vastu-page-loader' 
      id='vastu-page-loader'
      style='position: fixed !important; top: 0 !important; left: 0 !important; width: 100vw !important; height: 100vh !important; background-color: #ffffff !important; z-index: 99999 !important; display: flex !important; align-items: center !important; justify-content: center !important; flex-direction: column !important; margin: 0 !important; padding: 0 !important;'
    >
      {%- if settings.logo != blank -%}
        <img 
          src='{{ settings.logo | image_url: width: 200 }}'
          alt='{{ shop.name | escape }}'
          class='vastu-page-loader__logo'
          loading='eager'
          fetchpriority='high'
          width='200'
          height='auto'
          style='display: block !important; visibility: visible !important; margin-bottom: 30px !important; max-width: 150px !important; height: auto !important;'
        >
      {%- endif -%}
      <div 
        class='vastu-page-loader__spinner'
        style='width: 60px !important; height: 60px !important; border: 4px solid rgba(71, 56, 85, 0.1) !important; border-top-color: rgb(71, 56, 85) !important; border-radius: 50% !important; animation: vastu-spin 1s linear infinite !important; margin-bottom: 20px !important; display: block !important; visibility: visible !important; opacity: 1 !important;'
      ></div>
      <div 
        class='vastu-page-loader__text'
        style='font-size: 1.4rem !important; color: rgb(71, 56, 85) !important; font-weight: 500 !important; letter-spacing: 0.05em !important; display: block !important; visibility: visible !important; opacity: 1 !important;'
      >{{ 'general.loading.loading' | t }}</div>
    </div>
    
