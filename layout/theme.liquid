<!doctype html>
{% assign locale_rtl = 'ar,fa,he,ks,ps,sd,ur,' %}
{% assign current_locale = localization.language.iso_code | append: ',' %}
<html
  {% if locale_rtl contains current_locale %}
    dir='rtl'
  {% else %}
    dir='ltr'
  {% endif %}
  class='no-js'
  lang='{{ request.locale.iso_code }}'
  xo-money-format='{{ shop.money_format | escape }}'
  xo-money-with-currency-format='{{ shop.money_with_currency_format | escape }}'
>
  <head>
    <meta charset='utf-8'>
    <meta http-equiv='X-UA-Compatible' content='IE=edge'>
    <meta name='viewport' content='width=device-width,initial-scale=1'>
    <meta name='theme-color' content=''>
    <link rel='canonical' href='{{ canonical_url }}'>
    {% render 'preconnect' %}

    {% render 'xotiny-theme' %}

    {%- if settings.favicon != blank -%}
      <link
        rel='icon'
        type='image/png'
        sizes='32x32'
        href='{{ settings.favicon | image_url: width: 32, height: 32 }}'
      >
      <link
        rel='icon'
        type='image/png'
        sizes='16x16'
        href='{{ settings.favicon | image_url: width: 16, height: 16 }}'
      >
      <link
        rel='apple-touch-icon'
        sizes='180x180'
        href='{{ settings.favicon | image_url: width: 180, height: 180 }}'
      >
    {%- endif -%}

    {% render 'page-title' %}

    {%- liquid
      assign meta_description = page_description
      
      if template.name == 'collection' and collection
        if collection.description != blank
          assign meta_description = collection.description | strip_html | truncate: 160
        endif
      elsif template.name == 'product' and product
        if product.description != blank
          assign meta_description = product.description | strip_html | truncate: 160
        endif
      elsif template.name == 'article' and article
        if article.excerpt != blank
          assign meta_description = article.excerpt | strip_html | truncate: 160
        elsif article.content != blank
          assign meta_description = article.content | strip_html | truncate: 160
        endif
      elsif template.name == 'blog' and blog
        if blog.description != blank
          assign meta_description = blog.description | strip_html | truncate: 160
        endif
      elsif template.name == 'page' and page
        if page.content != blank
          assign meta_description = page.content | strip_html | truncate: 160
        endif
      endif
      
      if meta_description == blank
        assign meta_description = shop.description | default: shop.name
      endif
    -%}
    <meta name='description' content='{{ meta_description | escape }}'>

    {% render 'meta-tags' %}

    {{ content_for_header }}
    {% render 'settings-adapter' %}

    {{ 'xo-webcomponents.min.css' | asset_url | stylesheet_tag }}
    {{ 'main.min.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-base.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-headings.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-cards.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-collection-cards.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-product-card.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-popup-newsletter.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-product-page.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-shipping-link.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-buttons-hover.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-sections-spacing.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-why-kit.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-product-showcase.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-hindi-statement.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-footer.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-carousel.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-banner-hero.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-banner-hero-extended.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-trust-bar.css' | asset_url | stylesheet_tag }}
    {% comment %} UNUSED CSS - vastu-features-bar section not used {% endcomment %}
    {% comment %}{{ 'vastu-features-bar.css' | asset_url | stylesheet_tag }}{% endcomment %}
    {{ 'vastu-testimonials.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-shop-by-concern.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-help-address.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-blog.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-faq.css' | asset_url | stylesheet_tag }}
    {{ 'vastu-responsive.css' | asset_url | stylesheet_tag }}

    {% render 'google-fonts-link' %}

    {% if settings.font_body_selection == 'shopify_fonts' %}
      <link
        href='{{ settings.type_body_font | font_url | preload_tag: as: 'font' }}'
        type='font/woff2'
        crossorigin
      >
    {% endif %}

    {% if settings.font_heading_selection == 'shopify_fonts' %}
      <link
        href='{{ settings.type_header_font | font_url | preload_tag: as: 'font' }}'
        type='font/woff2'
        crossorigin
      >
    {% endif %}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>

    <script src='{{ 'xo-webcomponents.min.js' | asset_url }}' defer></script>
    <script src='{{ 'vendors.js' | asset_url }}' defer></script>
    <script src='{{ 'main.js' | asset_url }}' defer></script>
  </head>

  <body class='gradient'>
    <div id='xo-root'>
      {% liquid
        assign button_text = 'accessibility.skip_to_text' | t
        render 'button', link: '#xo-main-content', class: 'xo-skip-to-content xo-visually-hidden', text: button_text
      %}

      {%- if template contains 'index' or template contains 'home' -%}
        {%- if settings.header_style == 'default' -%}
          {%- assign header = 'header-v1' %}
        {%- endif -%}
      {%- endif -%}

      {%- if template contains 'home-2' -%}
        {%- if settings.header_style == 'default' -%}
          {%- assign header = 'header-v2' %}
        {%- endif -%}
      {%- endif -%}

      {%- if template contains 'home-3' -%}
        {%- if settings.header_style == 'default' -%}
          {%- assign header = 'header-v3' %}
        {%- endif -%}
      {%- endif -%}

      {%- if template contains 'home-4' -%}
        {%- if settings.header_style == 'default' -%}
          {%- assign header = 'header-v4' %}
        {%- endif -%}
      {%- endif -%}

      {%- if template contains 'home-5' -%}
        {%- if settings.header_style == 'default' -%}
          {%- assign header = 'header-v5' %}
        {%- endif -%}
      {%- endif -%}

      {%- if settings.header_style != 'default' -%}
        {%- assign header = settings.header_style %}
      {%- endif -%}

      {% case header %}
        {% when 'header-v1' %}
          {% sections 'header-group' %}
        {% when 'header-v2' %}
          {% sections 'header2-group' %}
        {% when 'header-v3' %}
          {% sections 'header3-group' %}
        {% when 'header-v4' %}
          {% sections 'header4-group' %}
        {% when 'header-v5' %}
          {% sections 'header5-group' %}
        {%- else -%}
          {% sections 'header-group' %}
      {% endcase %}

      <main
        id='xo-main-content'
        class='content-for-layout focus-none'
        role='main'
        tabindex='-1'
      >
        {{ content_for_layout }}
      </main>

      {%- if template contains 'index' or template contains 'home' -%}
        {%- if settings.footer_style == 'default' -%}
          {%- assign footer = 'footer-v1' %}
        {%- endif -%}
      {%- endif -%}

      {%- if template contains 'home-2' -%}
        {%- if settings.footer_style == 'default' -%}
          {%- assign footer = 'footer-v2' %}
        {%- endif -%}
      {%- endif -%}

      {%- if template contains 'home-3' -%}
        {%- if settings.footer_style == 'default' -%}
          {%- assign footer = 'footer-v3' %}
        {%- endif -%}
      {%- endif -%}

      {%- if template contains 'home-4' -%}
        {%- if settings.footer_style == 'default' -%}
          {%- assign footer = 'footer-v4' %}
        {%- endif -%}
      {%- endif -%}

      {%- if template contains 'home-5' -%}
        {%- if settings.footer_style == 'default' -%}
          {%- assign footer = 'footer-v5' %}
        {%- endif -%}
      {%- endif -%}

      {%- if settings.footer_style != 'default' -%}
        {%- assign footer = settings.footer_style %}
      {%- endif -%}

      {% case footer %}
        {% when 'footer-v1' %}
          {% sections 'footer-group' %}
        {% when 'footer-v2' %}
          {% sections 'footer2-group' %}
        {% when 'footer-v3' %}
          {% sections 'footer3-group' %}
        {% when 'footer-v4' %}
          {% sections 'footer4-group' %}
        {% when 'footer-v5' %}
          {% sections 'footer5-group' %}
        {%- else -%}
          {% sections 'footer-group' %}
      {% endcase %}

      {% sections 'overlay-group' %}

      <ul hidden>
        <li id='a11y-refresh-page-message'>{{ 'accessibility.refresh_page' | t }}</li>
        <li id='a11y-new-window-message'>{{ 'accessibility.link_messages.new_window' | t }}</li>
      </ul>

      {% render 'scroll-top' %}
      {% render 'toolbar' %}
    </div>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
      };

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
      };

      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
      };

      window.accessibilityStrings = {
        imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' }}`,
        shareSuccess: `{{ 'general.share.success_message' | t }}`,
        pauseSlideshow: `{{ 'sections.slideshow.pause_slideshow' | t }}`,
        playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t }}`,
      };

      // Hide Shopify trial banner
      (function() {
        function hideTrialBanner() {
          const selectors = [
            '[data-shopify-trial]',
            '[class*="shopify-trial"]',
            '[class*="trial-banner"]',
            '[id*="shopify-trial"]',
            '[id*="trial-banner"]',
            '[aria-label*="trial" i]',
            '[aria-label*="3 day" i]',
            '[aria-label*="3-day" i]',
            '[aria-label*="free trial" i]',
            '[title*="trial" i]',
            '[title*="3 day" i]',
            '[title*="3-day" i]',
            'div[style*="position: fixed"][style*="z-index: 999"]',
            'div[style*="position: fixed"][style*="z-index: 9999"]',
            'div[style*="position: fixed"][style*="z-index: 10000"]',
            'div[class*="PolarisBanner"]',
            'div[class*="shopify-banner"]',
            'div[class*="shopify-promo"]'
          ];
          
          selectors.forEach(selector => {
            try {
              document.querySelectorAll(selector).forEach(el => {
                const text = el.textContent || el.innerText || '';
                if (text.toLowerCase().includes('trial') || 
                    text.toLowerCase().includes('3 day') || 
                    text.toLowerCase().includes('3-day') ||
                    text.toLowerCase().includes('free trial')) {
                  el.style.display = 'none';
                  el.style.visibility = 'hidden';
                  el.style.height = '0';
                  el.style.width = '0';
                  el.style.opacity = '0';
                  el.style.position = 'absolute';
                  el.style.left = '-9999px';
                  el.style.pointerEvents = 'none';
                  el.remove();
                }
              });
            } catch(e) {}
          });
        }
        
        // Run immediately
        hideTrialBanner();
        
        // Run after DOM is ready
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', hideTrialBanner);
        }
        
        // Run after page load
        window.addEventListener('load', hideTrialBanner);
        
        // Watch for dynamically added elements
        const observer = new MutationObserver(hideTrialBanner);
        observer.observe(document.body, {
          childList: true,
          subtree: true
        });
        
        // Also check periodically
        setInterval(hideTrialBanner, 1000);
      })();

      // Fix: Update product price when variant selection changes with loading indicator
      (function() {
        // Add loading indicator styles
        const style = document.createElement('style');
        style.textContent = `
          .xo-price-loading {
            position: relative;
            min-height: 1.5em;
            opacity: 0.6;
          }
          .xo-price-loading::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 16px;
            height: 16px;
            border: 2px solid currentColor;
            border-top-color: transparent;
            border-radius: 50%;
            animation: xo-price-spin 0.6s linear infinite;
          }
          @keyframes xo-price-spin {
            to { transform: translate(-50%, -50%) rotate(360deg); }
          }
          .xo-price-loading .xo-price__container {
            visibility: hidden;
          }
        `;
        document.head.appendChild(style);

        function formatMoney(cents, format) {
          // Use Shopify's formatMoney if available
          if (window.Shopify && window.Shopify.formatMoney) {
            return window.Shopify.formatMoney(cents, format);
          }
          
          if (typeof cents === 'string') {
            cents = cents.replace('.', '');
          }
          const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
          const formatString = format || document.documentElement.getAttribute('xo-money-format') || '{{amount}}';
          
          function formatWithDelimiters(number, precision, thousands, decimal) {
            thousands = thousands || ',';
            decimal = decimal || '.';
            
            if (isNaN(number) || number === null) {
              return '0';
            }
            
            number = (number / 100).toFixed(precision);
            const parts = number.split('.');
            const dollarsAmount = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, thousands);
            const centsAmount = parts[1] ? (decimal + parts[1]) : '';
            
            return dollarsAmount + centsAmount;
          }
          
          const match = formatString.match(placeholderRegex);
          if (!match) return formatString;
          
          const formatType = match[1];
          let formattedValue;
          
          switch (formatType) {
            case 'amount':
              formattedValue = formatWithDelimiters(cents, 2);
              break;
            case 'amount_no_decimals':
              formattedValue = formatWithDelimiters(cents, 0);
              break;
            case 'amount_with_comma_separator':
              formattedValue = formatWithDelimiters(cents, 2, '.', ',');
              break;
            case 'amount_no_decimals_with_comma_separator':
              formattedValue = formatWithDelimiters(cents, 0, '.', ',');
              break;
            default:
              formattedValue = formatString;
          }
          
          return formatString.replace(placeholderRegex, formattedValue);
        }

        function showPriceLoading(productId) {
          const priceElements = document.querySelectorAll(`xo-product-will-change[xo-unique-id="product-price-${productId}"]`);
          priceElements.forEach(priceEl => {
            const priceContainer = priceEl.querySelector('.xo-price');
            if (priceContainer) {
              priceContainer.classList.add('xo-price-loading');
            }
          });
        }

        function hidePriceLoading(productId) {
          const priceElements = document.querySelectorAll(`xo-product-will-change[xo-unique-id="product-price-${productId}"]`);
          priceElements.forEach(priceEl => {
            const priceContainer = priceEl.querySelector('.xo-price');
            if (priceContainer) {
              priceContainer.classList.remove('xo-price-loading');
            }
          });
        }

        function updateProductPrice(variantId, productId) {
          // Show loading indicator
          showPriceLoading(productId);
          
          // Find the product data element - search in the context of the product
          const productContext = document.querySelector(`xo-product[xo-product-id="${productId}"]`) || document;
          const productDataEl = productContext.querySelector(`xo-product-data script`);
          
          // Try to get variant data from product data
          let variant = null;
          if (productDataEl) {
            try {
              const productData = JSON.parse(productDataEl.textContent);
              variant = productData.variants.find(v => v.id === variantId);
            } catch (error) {
              console.error('Error parsing product data:', error);
            }
          }
          
          // If variant not found in product data, try to fetch from server
          if (!variant && productDataEl) {
            try {
              const productData = JSON.parse(productDataEl.textContent);
              const productHandle = productData.handle;
              if (productHandle && window.shopUrl) {
                fetch(`${window.shopUrl}/products/${productHandle}?view=price&variant=${variantId}`)
                  .then(response => response.text())
                  .then(html => {
                    // Parse the HTML to extract price
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const priceElements = document.querySelectorAll(`xo-product-will-change[xo-unique-id="product-price-${productId}"]`);
                    priceElements.forEach(priceEl => {
                      const newPrice = doc.querySelector('.xo-price');
                      if (newPrice) {
                        const priceContainer = priceEl.querySelector('.xo-price');
                        if (priceContainer) {
                          priceContainer.innerHTML = newPrice.innerHTML;
                          priceContainer.classList.remove('xo-price-loading');
                        }
                      }
                    });
                    hidePriceLoading(productId);
                  })
                  .catch(error => {
                    console.error('Error fetching price from server:', error);
                    hidePriceLoading(productId);
                  });
                return;
              }
            } catch (error) {
              console.error('Error getting product handle:', error);
            }
          }
          
          if (!variant) {
            hidePriceLoading(productId);
            return;
          }
          
          // Use setTimeout to simulate async operation and show loading
          setTimeout(() => {
            try {
              // Get money format
              const moneyFormat = document.documentElement.getAttribute('xo-money-format') || 
                                 document.documentElement.getAttribute('xo-money-with-currency-format') || 
                                 '{{amount}}';
              
              // Format prices
              const price = variant.price;
              const compareAtPrice = variant.compare_at_price;
              let moneyPrice = formatMoney(price, moneyFormat);
              let moneyComparePrice = compareAtPrice ? formatMoney(compareAtPrice, moneyFormat) : null;
              
              // Replace currency symbols (Indian Rupee formatting)
              moneyPrice = moneyPrice.replace(/Rs\./g, '₹').replace(/Rs /g, '₹ ').replace(/INR/g, '₹');
              if (moneyComparePrice) {
                moneyComparePrice = moneyComparePrice.replace(/Rs\./g, '₹').replace(/Rs /g, '₹ ').replace(/INR/g, '₹');
              }
              
              // Find all price elements that need updating (in all contexts)
              const priceElements = document.querySelectorAll(`xo-product-will-change[xo-unique-id="product-price-${productId}"]`);
              
              priceElements.forEach(priceEl => {
                const priceContainer = priceEl.querySelector('.xo-price');
                if (!priceContainer) return;
                
                // Get existing style classes
                const existingStyle = priceContainer.className.match(/xo-price--\w+/);
                const styleClass = existingStyle ? existingStyle[0] : '';
                
                // Create new price HTML
                let newPriceHTML = '';
                
                if (compareAtPrice && compareAtPrice > price) {
                  // Sale price
                  newPriceHTML = `
                    <div class="xo-price__container">
                      <div class="xo-price__sale${styleClass ? ' ' + styleClass : ''}">
                        <div class="xo-visually-hidden xo-visually-hidden--inline">Sale price</div>
                        <span class="xo-price__item xo-price__item--accent">${moneyPrice}</span>
                        <div class="xo-visually-hidden xo-visually-hidden--inline">Regular price</div>
                        <span class="xo-price__item xo-price__item--del">${moneyComparePrice}</span>
                      </div>
                    </div>
                  `;
                } else {
                  // Regular price
                  newPriceHTML = `
                    <div class="xo-price__container">
                      <div class="xo-price__regular${styleClass ? ' ' + styleClass : ''}">
                        <div class="xo-visually-hidden xo-visually-hidden--inline">Regular price</div>
                        <span class="xo-price__item">${moneyPrice}</span>
                      </div>
                    </div>
                  `;
                }
                
                // Update the price container
                priceContainer.innerHTML = newPriceHTML;
                priceContainer.classList.remove('xo-price-loading');
              });
              
              hidePriceLoading(productId);
            } catch (error) {
              console.error('Error updating product price:', error);
              hidePriceLoading(productId);
            }
          }, 50); // Small delay to show loading indicator
        }

        // Track which forms have been initialized
        const initializedForms = new WeakSet();
        
        function handleVariantChange() {
          // Find all product forms - including in popups, modals, collections, etc.
          const productForms = document.querySelectorAll('form[data-type="add-to-cart-form"], form[id^="product-form"], form[id*="product"], form.product-form');
          
          productForms.forEach(form => {
            // Skip if already initialized
            if (initializedForms.has(form)) return;
            
            const variantInput = form.querySelector('input[name="id"]');
            if (!variantInput) return;
            
            // Get product ID from various sources
            const productEl = form.closest('xo-product');
            let productId = productEl ? productEl.getAttribute('xo-product-id') : null;
            
            if (!productId) {
              // Try to get from form ID
              const formId = form.id;
              const match = formId.match(/product-form-(\d+)/) || formId.match(/product-(\d+)/);
              if (match) {
                productId = match[1];
              }
            }
            
            if (!productId) {
              // Try to get from product data in the form's context
              const contextEl = form.closest('xo-product, .product-card, .product-item, [data-product-id]');
              if (contextEl) {
                const dataEl = contextEl.querySelector('xo-product-data script');
                if (dataEl) {
                  try {
                    const productData = JSON.parse(dataEl.textContent);
                    productId = productData.id;
                  } catch (e) {}
                }
                // Also check data attribute
                if (!productId && contextEl.hasAttribute('data-product-id')) {
                  productId = contextEl.getAttribute('data-product-id');
                }
              }
            }
            
            if (!productId) return;
            
            // Mark as initialized
            initializedForms.add(form);
            
            // Store the last variant ID to avoid unnecessary updates
            let lastVariantId = parseInt(variantInput.value);
            
            // Function to check and update price
            const checkAndUpdate = () => {
              const currentVariantId = parseInt(variantInput.value);
              if (currentVariantId && currentVariantId !== lastVariantId) {
                lastVariantId = currentVariantId;
                updateProductPrice(currentVariantId, productId);
              }
            };
            
            // Listen for variant changes on the input
            variantInput.addEventListener('change', checkAndUpdate);
            
            // Listen for variant selector changes - use event delegation for dynamic content
            const handleVariantSelectorChange = (e) => {
              const target = e.target;
              if (target.matches('input[type="radio"][name^="option"], select[name^="option"], xo-product-variant input, xo-product-variant select, [data-variant-option]')) {
                // Wait a bit for the variant ID to update
                setTimeout(checkAndUpdate, 150);
              }
            };
            
            // Add listener to form
            form.addEventListener('change', handleVariantSelectorChange);
            
            // Also listen for clicks on variant options (for color swatches, etc.)
            form.addEventListener('click', (e) => {
              const target = e.target.closest('[data-option], [data-variant], xo-product-variant, .variant-option');
              if (target) {
                setTimeout(checkAndUpdate, 150);
              }
            });
            
            // Listen for custom events that might be fired by web components
            form.addEventListener('variant:change', (e) => {
              if (e.detail && e.detail.variantId) {
                updateProductPrice(e.detail.variantId, productId);
              }
            });
          });
        }

        // Use event delegation for variant changes everywhere
        document.addEventListener('change', (e) => {
          const target = e.target;
          if (target.matches('input[type="radio"][name^="option"], select[name^="option"], xo-product-variant input, xo-product-variant select')) {
            const form = target.closest('form');
            if (form) {
              const variantInput = form.querySelector('input[name="id"]');
              if (variantInput) {
                setTimeout(() => {
                  const variantId = parseInt(variantInput.value);
                  if (variantId) {
                    // Find product ID
                    const productEl = form.closest('xo-product');
                    let productId = productEl ? productEl.getAttribute('xo-product-id') : null;
                    if (!productId) {
                      const formId = form.id;
                      const match = formId.match(/product-form-(\d+)/) || formId.match(/product-(\d+)/);
                      if (match) productId = match[1];
                    }
                    if (productId) {
                      updateProductPrice(variantId, productId);
                    }
                  }
                }, 150);
              }
            }
          }
        });

        // Initialize on DOM ready
        function init() {
          handleVariantChange();
        }
        
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
        
        // Also handle dynamically added forms (popups, modals, AJAX loaded content)
        const formObserver = new MutationObserver(() => {
          handleVariantChange();
        });
        
        formObserver.observe(document.body, {
          childList: true,
          subtree: true
        });
      })();

      // Fix: Ensure cart drawer always has content and close button after adding items
      (function() {
        let cartUpdateTimeout = null;
        let lastCartCheck = 0;
        
        function ensureCartDrawerContent() {
          const cartModal = document.querySelector('xo-modal[xo-name="cart"]');
          if (!cartModal) return;
          
          const cartDrawer = cartModal.querySelector('xo-cart-mini');
          if (!cartDrawer) return;
          
          const cartContent = cartDrawer.querySelector('xo-cart-will-change[xo-unique-id="xo-cart-mini-content"]');
          const cartFooter = cartDrawer.querySelector('xo-cart-will-change[xo-unique-id="xo-cart-mini-drawer-footer"]');
          const modalHeader = cartDrawer.querySelector('.xo-modal-content-style1__header');
          const closeButton = modalHeader?.querySelector('xo-modal-trigger, .xo-modal-content-style1__close');
          const modalBody = cartDrawer.querySelector('.xo-modal-content-style1__body, xo-cart-scroll');
          
          // Ensure close button is always visible and functional
          if (closeButton) {
            closeButton.style.display = '';
            closeButton.style.visibility = 'visible';
            closeButton.style.opacity = '1';
            closeButton.style.pointerEvents = 'auto';
            closeButton.style.zIndex = '10000';
          }
          
          // Ensure header is visible
          if (modalHeader) {
            modalHeader.style.display = '';
            modalHeader.style.visibility = 'visible';
            modalHeader.style.opacity = '1';
          }
          
          // Check if cart content is empty or missing
          if (cartContent) {
            const hasVisibleContent = cartContent.children.length > 0 || 
                                     (cartContent.textContent && cartContent.textContent.trim().length > 0) ||
                                     cartContent.querySelector('.xo-cart-empty, .xo-cart-mini-item');
            
            // If content appears empty, wait a bit for web component to update, then check again
            if (!hasVisibleContent) {
              setTimeout(() => {
                const stillEmpty = !cartContent.children.length && 
                                  (!cartContent.textContent || cartContent.textContent.trim().length === 0);
                
                if (stillEmpty && Date.now() - lastCartCheck > 2000) {
                  lastCartCheck = Date.now();
                  
                  // Try to fetch cart and reload drawer section
                  fetch(window.routes?.cart_url || '/cart.js', {
                    headers: { 'Accept': 'application/json' }
                  })
                    .then(response => {
                      if (!response.ok) throw new Error('Cart fetch failed');
                      return response.json();
                    })
                    .then(cart => {
                      // If cart has items but drawer is empty, trigger a refresh
                      if (cart && cart.items && cart.items.length > 0) {
                        // Dispatch event to trigger cart update
                        document.dispatchEvent(new CustomEvent('cart:refresh'));
                        
                        // Fallback: show a message and close button
                        if (!cartContent.children.length) {
                          cartContent.innerHTML = `
                            <div style="padding: 2rem; text-align: center;">
                              <p style="margin-bottom: 1rem;">Item added to cart successfully!</p>
                              <p style="font-size: 0.9em; color: #666;">The cart is updating...</p>
                            </div>
                          `;
                        }
                      } else {
                        // Cart is empty, show empty state
                        if (!cartContent.querySelector('.xo-cart-empty')) {
                          cartContent.innerHTML = `
                            <div class="xo-cart-empty" style="padding: 2rem; text-align: center;">
                              <p>Your cart is empty</p>
                            </div>
                          `;
                        }
                      }
                    })
                    .catch(err => {
                      console.error('Error checking cart:', err);
                      // Show fallback message with close option
                      if (!cartContent.children.length) {
                        cartContent.innerHTML = `
                          <div style="padding: 2rem; text-align: center;">
                            <p style="margin-bottom: 1rem;">Item added to cart!</p>
                            <p style="font-size: 0.9em; color: #666;">Please refresh the page to view your cart.</p>
                          </div>
                        `;
                      }
                    });
                }
              }, 1000);
            }
          }
          
          // Ensure footer and body are visible
          if (cartFooter) {
            cartFooter.style.display = '';
            cartFooter.style.visibility = 'visible';
          }
          
          if (modalBody) {
            modalBody.style.display = '';
            modalBody.style.visibility = 'visible';
          }
        }
        
        // Monitor cart drawer for empty content
        function monitorCartDrawer() {
          const cartModal = document.querySelector('xo-modal[xo-name="cart"]');
          if (!cartModal) return;
          
          // Check if modal is open (multiple ways to check)
          const isOpen = cartModal.hasAttribute('xo-active') || 
                        cartModal.getAttribute('xo-active') === 'true' ||
                        cartModal.classList.contains('xo-active') ||
                        window.getComputedStyle(cartModal).display !== 'none';
          
          if (isOpen) {
            ensureCartDrawerContent();
          }
        }
        
        // Listen for cart updates from web components
        document.addEventListener('cart:updated', () => {
          clearTimeout(cartUpdateTimeout);
          cartUpdateTimeout = setTimeout(() => {
            monitorCartDrawer();
          }, 300);
        });
        
        // Listen for custom cart refresh events
        document.addEventListener('cart:refresh', () => {
          setTimeout(monitorCartDrawer, 500);
        });
        
        // Monitor cart drawer when it opens
        const cartObserver = new MutationObserver((mutations) => {
          let shouldCheck = false;
          mutations.forEach(mutation => {
            if (mutation.type === 'attributes' && mutation.attributeName === 'xo-active') {
              shouldCheck = true;
            }
            if (mutation.type === 'childList') {
              shouldCheck = true;
            }
          });
          if (shouldCheck) {
            setTimeout(monitorCartDrawer, 200);
          }
        });
        
        // Observe cart modal for changes
        const cartModal = document.querySelector('xo-modal[xo-name="cart"]');
        if (cartModal) {
          cartObserver.observe(cartModal, {
            attributes: true,
            attributeFilter: ['xo-active', 'class'],
            childList: true,
            subtree: true
          });
        }
        
        // Also check periodically when modal might be open
        setInterval(() => {
          const cartModal = document.querySelector('xo-modal[xo-name="cart"]');
          if (cartModal) {
            const isOpen = cartModal.hasAttribute('xo-active') || 
                          cartModal.getAttribute('xo-active') === 'true' ||
                          cartModal.classList.contains('xo-active');
            if (isOpen) {
              monitorCartDrawer();
            }
          }
        }, 2000);
        
        // Initial check
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => {
            setTimeout(monitorCartDrawer, 500);
          });
        } else {
          setTimeout(monitorCartDrawer, 500);
        }
      })();
    </script>
  </body>
</html>
