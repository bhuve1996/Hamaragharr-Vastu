        {%- if settings.header_style == 'default' -%}
          {%- assign header = 'header-v1' %}
        {%- endif -%}
      {%- endif -%}

      {%- if template contains 'home-2' -%}
        {%- if settings.header_style == 'default' -%}
          {%- assign header = 'header-v2' %}
        {%- endif -%}
      {%- endif -%}

      {%- if template contains 'home-3' -%}
        {%- if settings.header_style == 'default' -%}
          {%- assign header = 'header-v3' %}
        {%- endif -%}
      {%- endif -%}

      {%- if template contains 'home-4' -%}
        {%- if settings.header_style == 'default' -%}
          {%- assign header = 'header-v4' %}
        {%- endif -%}
      {%- endif -%}

      {%- if template contains 'home-5' -%}
        {%- if settings.header_style == 'default' -%}
          {%- assign header = 'header-v5' %}
        {%- endif -%}
      {%- endif -%}

      {%- if settings.header_style != 'default' -%}
        {%- assign header = settings.header_style %}
      {%- endif -%}

      {% case header %}
        {% when 'header-v1' %}
          {% sections 'header-group' %}
        {% when 'header-v2' %}
          {% sections 'header2-group' %}
        {% when 'header-v3' %}
          {% sections 'header3-group' %}
        {% when 'header-v4' %}
          {% sections 'header4-group' %}
        {% when 'header-v5' %}
          {% sections 'header5-group' %}
        {%- else -%}
          {% sections 'header-group' %}
      {% endcase %}

      <main
        id='xo-main-content'
        class='content-for-layout focus-none'
        role='main'
        tabindex='-1'
      >
        {{ content_for_layout }}
      </main>
      {%- comment -%} Hide non-banner sections on homepage immediately (runs before paint) {%- endcomment -%}
      {%- if template.name == 'index' -%}
      <script>
        (function(){
          var m = document.getElementById('xo-main-content');
          if (!m) return;
          var c = m.children;
          for (var i = 0; i < c.length; i++) {
            if (!c[i].querySelector || !c[i].querySelector('.vastu-banner-carousel')) {
              c[i].setAttribute('data-vastu-hide', '1');
              c[i].style.cssText = 'opacity:0!important;visibility:hidden!important;pointer-events:none!important;';
            }
          }
        })();
      </script>
      {%- endif -%}

      {%- if template contains 'index' or template contains 'home' -%}
        {%- if settings.footer_style == 'default' -%}
          {%- assign footer = 'footer-v1' %}
