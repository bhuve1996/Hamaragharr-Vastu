      {% case footer %}
        {% when 'footer-v1' %}
          {% sections 'footer-group' %}
        {% when 'footer-v2' %}
          {% sections 'footer2-group' %}
        {% when 'footer-v3' %}
          {% sections 'footer3-group' %}
        {% when 'footer-v4' %}
          {% sections 'footer4-group' %}
        {% when 'footer-v5' %}
          {% sections 'footer5-group' %}
        {%- else -%}
